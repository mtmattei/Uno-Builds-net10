<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:utu="using:Uno.Toolkit.UI">

	<ResourceDictionary.ThemeDictionaries>
		<!-- Default / Light: dark pill on light background -->
		<ResourceDictionary x:Key="Default">
			<!-- Container: semi-transparent dark pill -->
			<SolidColorBrush x:Key="SnackbarBackground" Color="#E6292929" />
			<SolidColorBrush x:Key="SnackbarBorderBrush" Color="Transparent" />
			<CornerRadius x:Key="SnackbarCornerRadius">12</CornerRadius>
			<Thickness x:Key="SnackbarBorderThickness">0</Thickness>
			<Thickness x:Key="SnackbarPadding">16,0,16,0</Thickness>
			<x:Double x:Key="SnackbarMinHeight">48</x:Double>
			<x:Double x:Key="SnackbarMinWidth">288</x:Double>
			<x:Double x:Key="SnackbarMaxWidth">560</x:Double>

			<!-- Message: white text, SF Pro 15px -->
			<SolidColorBrush x:Key="SnackbarMessageForeground" Color="#FFFFFF" />
			<x:Double x:Key="SnackbarMessageFontSize">15</x:Double>

			<!-- Action: iOS system blue -->
			<SolidColorBrush x:Key="SnackbarActionForeground" Color="#0A84FF" />
			<x:Double x:Key="SnackbarActionFontSize">15</x:Double>

			<!-- Dismiss: iOS systemGray -->
			<SolidColorBrush x:Key="SnackbarDismissForeground" Color="#98989D" />
			<x:Double x:Key="SnackbarDismissIconSize">18</x:Double>

			<!-- Host -->
			<Thickness x:Key="SnackbarHostMargin">8,0,8,8</Thickness>
		</ResourceDictionary>

		<ResourceDictionary x:Key="Light">
			<SolidColorBrush x:Key="SnackbarBackground" Color="#E6292929" />
			<SolidColorBrush x:Key="SnackbarBorderBrush" Color="Transparent" />
			<CornerRadius x:Key="SnackbarCornerRadius">12</CornerRadius>
			<Thickness x:Key="SnackbarBorderThickness">0</Thickness>
			<Thickness x:Key="SnackbarPadding">16,0,16,0</Thickness>
			<x:Double x:Key="SnackbarMinHeight">48</x:Double>
			<x:Double x:Key="SnackbarMinWidth">288</x:Double>
			<x:Double x:Key="SnackbarMaxWidth">560</x:Double>

			<SolidColorBrush x:Key="SnackbarMessageForeground" Color="#FFFFFF" />
			<x:Double x:Key="SnackbarMessageFontSize">15</x:Double>

			<SolidColorBrush x:Key="SnackbarActionForeground" Color="#0A84FF" />
			<x:Double x:Key="SnackbarActionFontSize">15</x:Double>

			<SolidColorBrush x:Key="SnackbarDismissForeground" Color="#98989D" />
			<x:Double x:Key="SnackbarDismissIconSize">18</x:Double>

			<Thickness x:Key="SnackbarHostMargin">8,0,8,8</Thickness>
		</ResourceDictionary>

		<!-- Dark: lighter translucent pill on dark background -->
		<ResourceDictionary x:Key="Dark">
			<SolidColorBrush x:Key="SnackbarBackground" Color="#E63A3A3C" />
			<SolidColorBrush x:Key="SnackbarBorderBrush" Color="Transparent" />
			<CornerRadius x:Key="SnackbarCornerRadius">12</CornerRadius>
			<Thickness x:Key="SnackbarBorderThickness">0</Thickness>
			<Thickness x:Key="SnackbarPadding">16,0,16,0</Thickness>
			<x:Double x:Key="SnackbarMinHeight">48</x:Double>
			<x:Double x:Key="SnackbarMinWidth">288</x:Double>
			<x:Double x:Key="SnackbarMaxWidth">560</x:Double>

			<SolidColorBrush x:Key="SnackbarMessageForeground" Color="#FFFFFF" />
			<x:Double x:Key="SnackbarMessageFontSize">15</x:Double>

			<SolidColorBrush x:Key="SnackbarActionForeground" Color="#0A84FF" />
			<x:Double x:Key="SnackbarActionFontSize">15</x:Double>

			<SolidColorBrush x:Key="SnackbarDismissForeground" Color="#636366" />
			<x:Double x:Key="SnackbarDismissIconSize">18</x:Double>

			<Thickness x:Key="SnackbarHostMargin">8,0,8,8</Thickness>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<!-- Cupertino Snackbar style: reuses base template, overrides only theme resources -->
	<Style x:Key="CupertinoSnackbarStyle"
		   TargetType="utu:Snackbar"
		   BasedOn="{StaticResource DefaultSnackbar}">
		<Setter Property="Background" Value="{ThemeResource SnackbarBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource SnackbarBorderBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource SnackbarBorderThickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource SnackbarCornerRadius}" />
		<Setter Property="Padding" Value="{ThemeResource SnackbarPadding}" />
		<Setter Property="MinHeight" Value="{ThemeResource SnackbarMinHeight}" />
		<Setter Property="MinWidth" Value="{ThemeResource SnackbarMinWidth}" />
		<Setter Property="MaxWidth" Value="{ThemeResource SnackbarMaxWidth}" />
	</Style>

	<!-- Cupertino SnackbarHost style -->
	<Style x:Key="CupertinoSnackbarHostStyle"
		   TargetType="utu:SnackbarHost"
		   BasedOn="{StaticResource DefaultSnackbarHost}">
		<Setter Property="SnackbarStyle" Value="{StaticResource CupertinoSnackbarStyle}" />
	</Style>

	<!-- Default aliases -->
	<Style x:Key="CupertinoDefaultSnackbarStyle"
		   TargetType="utu:Snackbar"
		   BasedOn="{StaticResource CupertinoSnackbarStyle}" />

	<Style x:Key="CupertinoDefaultSnackbarHostStyle"
		   TargetType="utu:SnackbarHost"
		   BasedOn="{StaticResource CupertinoSnackbarHostStyle}" />

</ResourceDictionary>
