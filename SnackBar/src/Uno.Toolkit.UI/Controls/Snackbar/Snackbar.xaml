<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:utu="using:Uno.Toolkit.UI">

	<!-- Lightweight styling resources (overridable via ThemeResource) -->
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<!-- Container -->
			<SolidColorBrush x:Key="SnackbarBackground" Color="#322F35" />
			<SolidColorBrush x:Key="SnackbarBorderBrush" Color="Transparent" />
			<CornerRadius x:Key="SnackbarCornerRadius">4</CornerRadius>
			<Thickness x:Key="SnackbarBorderThickness">0</Thickness>
			<Thickness x:Key="SnackbarPadding">16,14,16,14</Thickness>
			<Thickness x:Key="SnackbarPaddingWithActions">16,14,8,14</Thickness>
			<x:Double x:Key="SnackbarMinHeight">48</x:Double>
			<x:Double x:Key="SnackbarMinWidth">344</x:Double>
			<x:Double x:Key="SnackbarMaxWidth">672</x:Double>

			<!-- Message -->
			<SolidColorBrush x:Key="SnackbarMessageForeground" Color="#F5EFF7" />
			<x:Double x:Key="SnackbarMessageFontSize">14</x:Double>

			<!-- Action button -->
			<SolidColorBrush x:Key="SnackbarActionForeground" Color="#D0BCFF" />
			<x:Double x:Key="SnackbarActionFontSize">14</x:Double>

			<!-- Dismiss button -->
			<SolidColorBrush x:Key="SnackbarDismissForeground" Color="#F5EFF7" />
			<x:Double x:Key="SnackbarDismissIconSize">24</x:Double>
		</ResourceDictionary>

		<ResourceDictionary x:Key="Light">
			<SolidColorBrush x:Key="SnackbarBackground" Color="#322F35" />
			<SolidColorBrush x:Key="SnackbarBorderBrush" Color="Transparent" />
			<CornerRadius x:Key="SnackbarCornerRadius">4</CornerRadius>
			<Thickness x:Key="SnackbarBorderThickness">0</Thickness>
			<Thickness x:Key="SnackbarPadding">16,14,16,14</Thickness>
			<Thickness x:Key="SnackbarPaddingWithActions">16,14,8,14</Thickness>
			<x:Double x:Key="SnackbarMinHeight">48</x:Double>
			<x:Double x:Key="SnackbarMinWidth">344</x:Double>
			<x:Double x:Key="SnackbarMaxWidth">672</x:Double>

			<SolidColorBrush x:Key="SnackbarMessageForeground" Color="#F5EFF7" />
			<x:Double x:Key="SnackbarMessageFontSize">14</x:Double>

			<SolidColorBrush x:Key="SnackbarActionForeground" Color="#D0BCFF" />
			<x:Double x:Key="SnackbarActionFontSize">14</x:Double>

			<SolidColorBrush x:Key="SnackbarDismissForeground" Color="#F5EFF7" />
			<x:Double x:Key="SnackbarDismissIconSize">24</x:Double>
		</ResourceDictionary>

		<ResourceDictionary x:Key="Dark">
			<SolidColorBrush x:Key="SnackbarBackground" Color="#E8DEF8" />
			<SolidColorBrush x:Key="SnackbarBorderBrush" Color="Transparent" />
			<CornerRadius x:Key="SnackbarCornerRadius">4</CornerRadius>
			<Thickness x:Key="SnackbarBorderThickness">0</Thickness>
			<Thickness x:Key="SnackbarPadding">16,14,16,14</Thickness>
			<Thickness x:Key="SnackbarPaddingWithActions">16,14,8,14</Thickness>
			<x:Double x:Key="SnackbarMinHeight">48</x:Double>
			<x:Double x:Key="SnackbarMinWidth">344</x:Double>
			<x:Double x:Key="SnackbarMaxWidth">672</x:Double>

			<SolidColorBrush x:Key="SnackbarMessageForeground" Color="#1C1B1F" />
			<x:Double x:Key="SnackbarMessageFontSize">14</x:Double>

			<SolidColorBrush x:Key="SnackbarActionForeground" Color="#6750A4" />
			<x:Double x:Key="SnackbarActionFontSize">14</x:Double>

			<SolidColorBrush x:Key="SnackbarDismissForeground" Color="#1C1B1F" />
			<x:Double x:Key="SnackbarDismissIconSize">24</x:Double>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<Style x:Key="DefaultSnackbar" TargetType="utu:Snackbar">
		<Setter Property="Background" Value="{ThemeResource SnackbarBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource SnackbarBorderBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource SnackbarBorderThickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource SnackbarCornerRadius}" />
		<Setter Property="Padding" Value="{ThemeResource SnackbarPadding}" />
		<Setter Property="MinHeight" Value="{ThemeResource SnackbarMinHeight}" />
		<Setter Property="MinWidth" Value="{ThemeResource SnackbarMinWidth}" />
		<Setter Property="MaxWidth" Value="{ThemeResource SnackbarMaxWidth}" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Bottom" />
		<Setter Property="IsTabStop" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="utu:Snackbar">
					<Grid>
						<!-- Single-line layout (NoAction / WithAction) -->
						<Grid x:Name="SingleLineRoot"
							  Background="{TemplateBinding Background}"
							  BorderBrush="{TemplateBinding BorderBrush}"
							  BorderThickness="{TemplateBinding BorderThickness}"
							  CornerRadius="{TemplateBinding CornerRadius}"
							  MinHeight="{TemplateBinding MinHeight}"
							  MinWidth="{TemplateBinding MinWidth}"
							  MaxWidth="{TemplateBinding MaxWidth}"
							  Padding="{TemplateBinding Padding}">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<TextBlock x:Name="PART_MessageText"
									   Grid.Column="0"
									   Text="{TemplateBinding Message}"
									   Foreground="{ThemeResource SnackbarMessageForeground}"
									   FontSize="{ThemeResource SnackbarMessageFontSize}"
									   LineHeight="20"
									   MaxLines="2"
									   TextTrimming="CharacterEllipsis"
									   VerticalAlignment="Center"
									   TextWrapping="Wrap"
									   Padding="0,0,8,0"
									   AutomationProperties.LiveSetting="Assertive" />

							<Button x:Name="PART_ActionButton"
									Grid.Column="1"
									Content="{TemplateBinding ActionLabel}"
									Foreground="{ThemeResource SnackbarActionForeground}"
									FontSize="{ThemeResource SnackbarActionFontSize}"
									FontWeight="Medium"
									Background="Transparent"
									BorderThickness="0"
									MinHeight="48"
									Padding="12,10"
									VerticalAlignment="Center"
									Visibility="Collapsed" />

							<Button x:Name="PART_DismissButton"
									Grid.Column="2"
									Background="Transparent"
									BorderThickness="0"
									Width="48" Height="48"
									Padding="0"
									VerticalAlignment="Center"
									Visibility="Collapsed"
									AutomationProperties.Name="Dismiss">
								<FontIcon Glyph="&#xE711;"
										  FontSize="{ThemeResource SnackbarDismissIconSize}"
										  Foreground="{ThemeResource SnackbarDismissForeground}" />
							</Button>
						</Grid>

						<!-- Multi-line layout (WithActionOnNewLine) -->
						<Grid x:Name="MultiLineRoot"
							  Background="{TemplateBinding Background}"
							  BorderBrush="{TemplateBinding BorderBrush}"
							  BorderThickness="{TemplateBinding BorderThickness}"
							  CornerRadius="{TemplateBinding CornerRadius}"
							  MinHeight="{TemplateBinding MinHeight}"
							  MinWidth="{TemplateBinding MinWidth}"
							  MaxWidth="{TemplateBinding MaxWidth}"
							  Padding="16,14,8,4"
							  Visibility="Collapsed">

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<!-- Top row: message + dismiss -->
							<Grid Grid.Row="0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<TextBlock x:Name="PART_MessageTextMultiLine"
										   Grid.Column="0"
										   Text="{TemplateBinding Message}"
										   Foreground="{ThemeResource SnackbarMessageForeground}"
										   FontSize="{ThemeResource SnackbarMessageFontSize}"
										   LineHeight="20"
										   MaxLines="2"
										   TextTrimming="CharacterEllipsis"
										   TextWrapping="Wrap"
										   Padding="0,0,8,0"
										   AutomationProperties.LiveSetting="Assertive" />

								<Button x:Name="PART_DismissButtonMultiLine"
										Grid.Column="1"
										Background="Transparent"
										BorderThickness="0"
										Width="48" Height="48"
										Padding="0"
										VerticalAlignment="Top"
										Visibility="Collapsed"
										AutomationProperties.Name="Dismiss">
									<FontIcon Glyph="&#xE711;"
											  FontSize="{ThemeResource SnackbarDismissIconSize}"
											  Foreground="{ThemeResource SnackbarDismissForeground}" />
								</Button>
							</Grid>

							<!-- Bottom row: action button aligned right -->
							<StackPanel Grid.Row="1"
										Orientation="Horizontal"
										HorizontalAlignment="Right"
										Padding="0,0,0,8">
								<Button x:Name="PART_ActionButtonMultiLine"
										Content="{TemplateBinding ActionLabel}"
										Foreground="{ThemeResource SnackbarActionForeground}"
										FontSize="{ThemeResource SnackbarActionFontSize}"
										FontWeight="Medium"
										Background="Transparent"
										BorderThickness="0"
										MinHeight="48"
										Padding="12,10"
										Visibility="Collapsed" />
							</StackPanel>
						</Grid>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="ActionStates">
								<VisualState x:Name="NoAction" />

								<VisualState x:Name="WithAction">
									<VisualState.Setters>
										<Setter Target="SingleLineRoot.Visibility" Value="Visible" />
										<Setter Target="MultiLineRoot.Visibility" Value="Collapsed" />
										<Setter Target="PART_ActionButton.Visibility" Value="Visible" />
										<Setter Target="SingleLineRoot.Padding" Value="{ThemeResource SnackbarPaddingWithActions}" />
									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="WithActionOnNewLine">
									<VisualState.Setters>
										<Setter Target="SingleLineRoot.Visibility" Value="Collapsed" />
										<Setter Target="MultiLineRoot.Visibility" Value="Visible" />
										<Setter Target="PART_ActionButtonMultiLine.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="DismissStates">
								<VisualState x:Name="NoDismiss" />

								<VisualState x:Name="WithDismiss">
									<VisualState.Setters>
										<Setter Target="PART_DismissButton.Visibility" Value="Visible" />
										<Setter Target="PART_DismissButtonMultiLine.Visibility" Value="Visible" />
										<Setter Target="SingleLineRoot.Padding" Value="{ThemeResource SnackbarPaddingWithActions}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="DefaultSnackbarStyle"
		   TargetType="utu:Snackbar"
		   BasedOn="{StaticResource DefaultSnackbar}" />

</ResourceDictionary>
