<Page x:Class="SnackbarTestApp.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

    <utu:SnackbarHost x:Name="SnackbarHost"
                      Style="{StaticResource MaterialSnackbarHostStyle}">
        <ScrollViewer>
            <StackPanel Spacing="16"
                        Padding="24,24,24,80"
                        MaxWidth="600"
                        HorizontalAlignment="Center">

                <TextBlock Text="Snackbar Test App"
                           Style="{StaticResource HeadlineMedium}"
                           Margin="0,0,0,8" />

                <TextBlock Text="Tap each button to test a snackbar variant. The dismiss reason is shown below."
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />

                <!-- Basic message -->
                <Button Content="Basic Message"
                        Click="OnShowBasicClick"
                        HorizontalAlignment="Stretch" />

                <!-- Message + Action -->
                <Button Content="With Action"
                        Click="OnShowActionClick"
                        HorizontalAlignment="Stretch" />

                <!-- Message + Action + Dismiss -->
                <Button Content="Action + Dismiss Button"
                        Click="OnShowActionDismissClick"
                        HorizontalAlignment="Stretch" />

                <!-- Multi-line with action on new line -->
                <Button Content="Multi-line (Action on New Line)"
                        Click="OnShowMultiLineClick"
                        HorizontalAlignment="Stretch" />

                <!-- Long duration -->
                <Button Content="Long Duration (7s)"
                        Click="OnShowLongClick"
                        HorizontalAlignment="Stretch" />

                <!-- Indefinite -->
                <Button Content="Indefinite (Must Dismiss)"
                        Click="OnShowIndefiniteClick"
                        HorizontalAlignment="Stretch" />

                <!-- Queue demo -->
                <Button Content="Queue 3 Messages"
                        Click="OnShowQueueClick"
                        HorizontalAlignment="Stretch" />

                <!-- Result display -->
                <TextBlock x:Name="ResultText"
                           Text="Dismiss reason will appear here"
                           Style="{StaticResource BodySmall}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </utu:SnackbarHost>
</Page>
