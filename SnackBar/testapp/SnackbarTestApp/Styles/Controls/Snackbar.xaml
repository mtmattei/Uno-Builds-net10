<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:utu="using:Uno.Toolkit.UI">

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<!-- Container: M3 inverseSurface, Extra Small (4dp), 344-672dp -->
			<SolidColorBrush x:Key="SnackbarBackground" Color="#322F35" />
			<SolidColorBrush x:Key="SnackbarBorderBrush" Color="Transparent" />
			<CornerRadius x:Key="SnackbarCornerRadius">4</CornerRadius>
			<Thickness x:Key="SnackbarBorderThickness">0</Thickness>
			<Thickness x:Key="SnackbarPadding">16,14,16,14</Thickness>
			<Thickness x:Key="SnackbarPaddingWithActions">16,14,8,14</Thickness>
			<x:Double x:Key="SnackbarMinHeight">48</x:Double>
			<x:Double x:Key="SnackbarMinWidth">344</x:Double>
			<x:Double x:Key="SnackbarMaxWidth">672</x:Double>

			<!-- Message: M3 inverseOnSurface, Body Medium -->
			<SolidColorBrush x:Key="SnackbarMessageForeground" Color="#F5EFF7" />
			<x:Double x:Key="SnackbarMessageFontSize">14</x:Double>

			<!-- Action: M3 inversePrimary, Label Large -->
			<SolidColorBrush x:Key="SnackbarActionForeground" Color="#D0BCFF" />
			<x:Double x:Key="SnackbarActionFontSize">14</x:Double>

			<!-- Dismiss: M3 inverseOnSurface, 24dp icon -->
			<SolidColorBrush x:Key="SnackbarDismissForeground" Color="#F5EFF7" />
			<x:Double x:Key="SnackbarDismissIconSize">24</x:Double>

			<!-- Host -->
			<Thickness x:Key="SnackbarHostMargin">8,0,8,8</Thickness>
		</ResourceDictionary>

		<ResourceDictionary x:Key="Light">
			<SolidColorBrush x:Key="SnackbarBackground" Color="#322F35" />
			<SolidColorBrush x:Key="SnackbarBorderBrush" Color="Transparent" />
			<CornerRadius x:Key="SnackbarCornerRadius">4</CornerRadius>
			<Thickness x:Key="SnackbarBorderThickness">0</Thickness>
			<Thickness x:Key="SnackbarPadding">16,14,16,14</Thickness>
			<Thickness x:Key="SnackbarPaddingWithActions">16,14,8,14</Thickness>
			<x:Double x:Key="SnackbarMinHeight">48</x:Double>
			<x:Double x:Key="SnackbarMinWidth">344</x:Double>
			<x:Double x:Key="SnackbarMaxWidth">672</x:Double>

			<SolidColorBrush x:Key="SnackbarMessageForeground" Color="#F5EFF7" />
			<x:Double x:Key="SnackbarMessageFontSize">14</x:Double>

			<SolidColorBrush x:Key="SnackbarActionForeground" Color="#D0BCFF" />
			<x:Double x:Key="SnackbarActionFontSize">14</x:Double>

			<SolidColorBrush x:Key="SnackbarDismissForeground" Color="#F5EFF7" />
			<x:Double x:Key="SnackbarDismissIconSize">24</x:Double>

			<Thickness x:Key="SnackbarHostMargin">8,0,8,8</Thickness>
		</ResourceDictionary>

		<ResourceDictionary x:Key="Dark">
			<SolidColorBrush x:Key="SnackbarBackground" Color="#E8DEF8" />
			<SolidColorBrush x:Key="SnackbarBorderBrush" Color="Transparent" />
			<CornerRadius x:Key="SnackbarCornerRadius">4</CornerRadius>
			<Thickness x:Key="SnackbarBorderThickness">0</Thickness>
			<Thickness x:Key="SnackbarPadding">16,14,16,14</Thickness>
			<Thickness x:Key="SnackbarPaddingWithActions">16,14,8,14</Thickness>
			<x:Double x:Key="SnackbarMinHeight">48</x:Double>
			<x:Double x:Key="SnackbarMinWidth">344</x:Double>
			<x:Double x:Key="SnackbarMaxWidth">672</x:Double>

			<SolidColorBrush x:Key="SnackbarMessageForeground" Color="#1C1B1F" />
			<x:Double x:Key="SnackbarMessageFontSize">14</x:Double>

			<SolidColorBrush x:Key="SnackbarActionForeground" Color="#6750A4" />
			<x:Double x:Key="SnackbarActionFontSize">14</x:Double>

			<SolidColorBrush x:Key="SnackbarDismissForeground" Color="#1C1B1F" />
			<x:Double x:Key="SnackbarDismissIconSize">24</x:Double>

			<Thickness x:Key="SnackbarHostMargin">8,0,8,8</Thickness>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<!-- Material Snackbar style -->
	<Style x:Key="MaterialSnackbarStyle"
		   TargetType="utu:Snackbar"
		   BasedOn="{StaticResource DefaultSnackbar}">
		<Setter Property="Background" Value="{ThemeResource SnackbarBackground}" />
		<Setter Property="BorderBrush" Value="{ThemeResource SnackbarBorderBrush}" />
		<Setter Property="BorderThickness" Value="{ThemeResource SnackbarBorderThickness}" />
		<Setter Property="CornerRadius" Value="{ThemeResource SnackbarCornerRadius}" />
		<Setter Property="Padding" Value="{ThemeResource SnackbarPadding}" />
		<Setter Property="MinHeight" Value="{ThemeResource SnackbarMinHeight}" />
		<Setter Property="MinWidth" Value="{ThemeResource SnackbarMinWidth}" />
		<Setter Property="MaxWidth" Value="{ThemeResource SnackbarMaxWidth}" />
	</Style>

	<!-- Material SnackbarHost style -->
	<Style x:Key="MaterialSnackbarHostStyle"
		   TargetType="utu:SnackbarHost"
		   BasedOn="{StaticResource DefaultSnackbarHost}">
		<Setter Property="SnackbarStyle" Value="{StaticResource MaterialSnackbarStyle}" />
	</Style>

</ResourceDictionary>
