<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Display name -->
    <ApplicationTitle>Orb</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.orbfidget</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>OrbFidget</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Orb — a digital fidget toy powered by Uno Platform.</Description>

    <UnoFeatures>
      Skia;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

</Project>
