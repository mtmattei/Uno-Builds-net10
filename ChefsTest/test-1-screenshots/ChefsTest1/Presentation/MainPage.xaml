<Page x:Class="ChefsTest1.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:local="using:ChefsTest1.Presentation"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <Grid uen:Region.Attached="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          uen:Region.Attached="True"
          uen:Region.Navigator="Visibility">
      <local:HomePage uen:Region.Name="Home" Visibility="Collapsed" />
      <local:SearchPage uen:Region.Name="Search" Visibility="Collapsed" />
      <local:FavoritesPage uen:Region.Name="Favorites" Visibility="Collapsed" />
    </Grid>

    <utu:TabBar Grid.Row="1"
                uen:Region.Attached="True"
                Style="{StaticResource BottomTabBarStyle}">
      <utu:TabBarItem uen:Region.Name="Home">
        <utu:TabBarItem.Icon>
          <FontIcon Glyph="&#xE80F;" />
        </utu:TabBarItem.Icon>
        <TextBlock Text="Home" />
      </utu:TabBarItem>
      <utu:TabBarItem uen:Region.Name="Search">
        <utu:TabBarItem.Icon>
          <FontIcon Glyph="&#xE721;" />
        </utu:TabBarItem.Icon>
        <TextBlock Text="Search" />
      </utu:TabBarItem>
      <utu:TabBarItem uen:Region.Name="Favorites">
        <utu:TabBarItem.Icon>
          <FontIcon Glyph="&#xEB52;" />
        </utu:TabBarItem.Icon>
        <TextBlock Text="Favorites" />
      </utu:TabBarItem>
    </utu:TabBar>
  </Grid>
</Page>
