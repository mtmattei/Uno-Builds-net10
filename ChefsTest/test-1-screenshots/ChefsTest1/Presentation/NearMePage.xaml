<Page x:Class="ChefsTest1.Presentation.NearMePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="8,8,16,8" Height="56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Background="Transparent" Command="{x:Bind ViewModel.BackCommand}"
              Foreground="{ThemeResource OnBackgroundBrush}">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <TextBlock Grid.Column="1" Text="Near me" Margin="8,0,0,0" VerticalAlignment="Center"
                 FontWeight="SemiBold" FontSize="18"
                 Foreground="{ThemeResource OnBackgroundBrush}" />
    </Grid>

    <Grid Grid.Row="1">
      <Border Background="{ThemeResource SurfaceVariantBrush}">
        <Image Source="ms-appx:///Assets/Maps/location_pin.svg"
               Width="120" Height="120"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <Border HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              Margin="16,0,16,80"
              Background="{ThemeResource SecondaryBrush}"
              CornerRadius="12"
              Padding="12"
              Tapped="OnChefTapped">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <PersonPicture Width="40" Height="40"
                         ProfilePicture="{x:Bind ViewModel.SelectedChef.UrlProfileImage, Mode=OneWay, FallbackValue=''}" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="{x:Bind ViewModel.SelectedChef.ShortName, Mode=OneWay, FallbackValue=''}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource OnSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.SelectedChef.FollowersText, Mode=OneWay, FallbackValue=''}"
                       FontSize="12" Foreground="{ThemeResource OnSecondaryBrush}" />
          </StackPanel>
        </Grid>
      </Border>
      <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,16,16" Width="48" Height="48" CornerRadius="24"
              Background="{ThemeResource PrimaryBrush}"
              Foreground="{ThemeResource OnPrimaryBrush}">
        <FontIcon Glyph="&#xE81D;" />
      </Button>
    </Grid>
  </Grid>
</Page>
