<Page x:Class="ChefsTest1.Presentation.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest1.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="8,8,16,8" Height="56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Background="Transparent" Command="{x:Bind ViewModel.BackCommand}"
              Foreground="{ThemeResource OnBackgroundBrush}">
        <FontIcon Glyph="&#xE711;" />
      </Button>
      <TextBlock Grid.Column="1" Text="Profile" Margin="8,0,0,0" VerticalAlignment="Center"
                 FontWeight="SemiBold" FontSize="22"
                 Foreground="{ThemeResource OnBackgroundBrush}" />
      <Button Grid.Column="2" Background="Transparent" Command="{x:Bind ViewModel.SettingsCommand}"
              Foreground="{ThemeResource OnBackgroundBrush}">
        <FontIcon Glyph="&#xE713;" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="12" Padding="16,12,16,32">
        <PersonPicture Width="96" Height="96" HorizontalAlignment="Center"
                       ProfilePicture="{x:Bind ViewModel.User.UrlProfileImage, Mode=OneWay, FallbackValue=''}" />
        <TextBlock Text="{x:Bind ViewModel.User.FullName, Mode=OneWay, FallbackValue='Jenna Smith'}"
                   FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{ThemeResource OnBackgroundBrush}" />
        <Grid HorizontalAlignment="Center" ColumnSpacing="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <TextBlock Text="{x:Bind ViewModel.User.Recipes, Mode=OneWay, FallbackValue='0'}"
                       FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{ThemeResource OnBackgroundBrush}" />
            <TextBlock Text="Recipes" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock Text="{x:Bind ViewModel.User.Followers, Mode=OneWay, FallbackValue='0'}"
                       FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{ThemeResource OnBackgroundBrush}" />
            <TextBlock Text="Followers" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock Text="{x:Bind ViewModel.User.Following, Mode=OneWay, FallbackValue='0'}"
                       FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{ThemeResource OnBackgroundBrush}" />
            <TextBlock Text="Following" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          </StackPanel>
        </Grid>

        <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" Margin="0,8,0,8" />

        <Grid Visibility="{x:Bind ViewModel.HasRecipes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="My Recipes" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{ThemeResource OnBackgroundBrush}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.MyRecipes}">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="150" MinItemHeight="200" MinRowSpacing="12" MinColumnSpacing="12" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="m:Recipe">
                  <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="16"
                          BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                      <StackPanel Grid.Row="1" Padding="10,8">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource OnSurfaceBrush}" />
                        <TextBlock Text="{x:Bind Calories}" FontSize="11"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
        </Grid>

        <StackPanel HorizontalAlignment="Center" Spacing="12" Padding="32"
                    Visibility="{x:Bind ViewModel.HasNoRecipes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
          <Image Source="ms-appx:///Assets/Images/empty_recipe_light.svg" Width="100" Height="100" />
          <TextBlock Text="No Recipes Created" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" />
          <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                     Foreground="{ThemeResource OnSurfaceVariantBrush}"
                     Text="You haven't created any recipes yet. Share your culinary creativity with the community!" />
          <Button Style="{StaticResource TextButtonStyle}" Foreground="{ThemeResource PrimaryBrush}"
                  HorizontalAlignment="Center"
                  Command="{x:Bind ViewModel.CreateRecipeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE710;" FontSize="14" />
              <TextBlock Text="Create Recipe" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,16,16" Width="56" Height="56" CornerRadius="28"
            Background="{ThemeResource PrimaryBrush}"
            Foreground="{ThemeResource OnPrimaryBrush}"
            Command="{x:Bind ViewModel.CreateRecipeCommand}"
            Visibility="{x:Bind ViewModel.HasRecipes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
      <FontIcon Glyph="&#xE710;" />
    </Button>
  </Grid>
</Page>
