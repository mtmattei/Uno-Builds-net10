<Page x:Class="ChefsTest1.Presentation.LiveCookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="220" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0"
          Background="{ThemeResource SurfaceInverseBrush}"
          Height="56"
          Padding="8,8,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Background="Transparent"
              Foreground="{ThemeResource OnSurfaceInverseBrush}"
              Command="{x:Bind ViewModel.BackCommand}">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                 Text="{x:Bind ViewModel.AppBarTitle}"
                 FontWeight="SemiBold" FontSize="18"
                 Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    </Grid>

    <Grid Grid.Row="1">
      <Image Source="{x:Bind ViewModel.Recipe.ImageUrl}" Stretch="UniformToFill" />
      <Grid VerticalAlignment="Bottom" Background="#88000000" Padding="12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Grid.Column="0" Glyph="&#xE768;" Foreground="White" />
        <ProgressBar Grid.Column="1" Margin="12,0" Value="40" Maximum="100"
                     Foreground="{ThemeResource PrimaryBrush}" Background="#55FFFFFF" />
        <FontIcon Grid.Column="2" Glyph="&#xE767;" Foreground="White" Margin="12,0,8,0" />
        <FontIcon Grid.Column="3" Glyph="&#xE7F4;" Foreground="White" Margin="0,0,8,0" />
        <FontIcon Grid.Column="4" Glyph="&#xEC15;" Foreground="White" Margin="0,0,8,0" />
        <FontIcon Grid.Column="5" Glyph="&#xE740;" Foreground="White" />
      </Grid>
    </Grid>

    <ScrollViewer Grid.Row="2">
      <StackPanel Padding="16,16,16,16" Spacing="16">
        <TextBlock Text="{x:Bind ViewModel.CurrentStep.DisplayTitle, Mode=OneWay, FallbackValue=''}"
                   HorizontalAlignment="Center"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{ThemeResource OnBackgroundBrush}" />
        <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Ingredients:" HorizontalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{ThemeResource OnSurfaceBrush}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentStep.Ingredients, Mode=OneWay, FallbackValue=''}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource PrimaryBrush}" />
                    <TextBlock Text="{Binding}" Foreground="{ThemeResource OnSurfaceBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <TextBlock Text="{x:Bind ViewModel.CurrentStep.Description, Mode=OneWay, FallbackValue=''}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Spacing="12" Padding="16,8,16,16">
      <PipsPager NumberOfPages="{x:Bind ViewModel.Steps.Count, Mode=OneWay}"
                 SelectedPageIndex="{x:Bind ViewModel.CurrentStepIndex, Mode=TwoWay}"
                 HorizontalAlignment="Center" />
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="Previous" HorizontalAlignment="Stretch"
                Style="{StaticResource OutlinedButtonStyle}"
                Command="{x:Bind ViewModel.PreviousCommand}" />
        <Button Grid.Column="1" Content="Next" HorizontalAlignment="Stretch"
                Style="{StaticResource FilledButtonStyle}"
                Command="{x:Bind ViewModel.NextCommand}" />
      </Grid>
    </StackPanel>
  </Grid>
</Page>
