<Page x:Class="ChefsTest1.Presentation.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest1.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="8,8,16,8" Height="56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Background="Transparent" Command="{x:Bind ViewModel.CloseCommand}"
              Foreground="{ThemeResource OnBackgroundBrush}">
        <FontIcon Glyph="&#xE711;" />
      </Button>
      <TextBlock Grid.Column="1" Text="Notifications" Margin="8,0,0,0" VerticalAlignment="Center"
                 FontWeight="SemiBold" FontSize="18"
                 Foreground="{ThemeResource OnBackgroundBrush}" />
    </Grid>

    <Grid Grid.Row="1" Padding="8,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch"
              Command="{x:Bind ViewModel.SelectAllCommand}">
        <StackPanel>
          <TextBlock Text="All" HorizontalAlignment="Center" FontWeight="SemiBold" />
          <Border Height="2" Background="{ThemeResource PrimaryBrush}" Margin="0,6,0,0"
                  Visibility="{x:Bind ViewModel.IsAll, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch"
              Command="{x:Bind ViewModel.SelectUnreadCommand}">
        <StackPanel>
          <TextBlock Text="Unread" HorizontalAlignment="Center" FontWeight="SemiBold" />
          <Border Height="2" Background="{ThemeResource PrimaryBrush}" Margin="0,6,0,0"
                  Visibility="{x:Bind ViewModel.IsUnread, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch"
              Command="{x:Bind ViewModel.SelectReadCommand}">
        <StackPanel>
          <TextBlock Text="Read" HorizontalAlignment="Center" FontWeight="SemiBold" />
          <Border Height="2" Background="{ThemeResource PrimaryBrush}" Margin="0,6,0,0"
                  Visibility="{x:Bind ViewModel.IsRead, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="2">
      <ScrollViewer Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items}" Margin="16,8,16,16">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Vertical" Spacing="10" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="m:Notification">
              <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="12">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xEA8F;" FontSize="20"
                            Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>
      <StackPanel Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Padding="32">
        <Image Source="ms-appx:///Assets/Images/empty_notification_light.svg" Width="120" Height="120" />
        <TextBlock Text="No Notifications Yet" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" />
        <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   Text="Notifications about your activity, updates, and community interactions will appear here." />
        <Button Background="{ThemeResource SecondaryBrush}"
                Foreground="{ThemeResource OnSecondaryBrush}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.CloseCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE711;" FontSize="14" />
            <TextBlock Text="Close" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
