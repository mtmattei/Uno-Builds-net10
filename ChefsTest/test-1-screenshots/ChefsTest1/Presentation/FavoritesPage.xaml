<Page x:Class="ChefsTest1.Presentation.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest1.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Inverted top app bar -->
    <Grid Grid.Row="0"
          Background="{ThemeResource SurfaceInverseBrush}"
          Height="56"
          Padding="16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="unoChefs"
                 VerticalAlignment="Center"
                 FontWeight="Bold"
                 FontSize="20"
                 Foreground="{ThemeResource OnSurfaceInverseBrush}" />
      <Button Grid.Column="1"
              Background="Transparent"
              Foreground="{ThemeResource OnSurfaceInverseBrush}"
              Command="{x:Bind ViewModel.OpenOwnProfileCommand}">
        <FontIcon Glyph="&#xE77B;" />
      </Button>
      <Button Grid.Column="2"
              Background="Transparent"
              Foreground="{ThemeResource OnSurfaceInverseBrush}"
              Command="{x:Bind ViewModel.OpenNotificationsCommand}">
        <FontIcon Glyph="&#xEA8F;" />
      </Button>
    </Grid>

    <!-- Segmented tabs -->
    <Grid Grid.Row="1" Padding="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
              Style="{StaticResource TextButtonStyle}"
              HorizontalAlignment="Stretch"
              Command="{x:Bind ViewModel.SelectRecipesCommand}">
        <StackPanel>
          <TextBlock Text="All Recipes"
                     HorizontalAlignment="Center"
                     FontWeight="SemiBold" />
          <Border Height="2"
                  Background="{ThemeResource PrimaryBrush}"
                  Margin="0,8,0,0"
                  Visibility="{x:Bind ViewModel.IsRecipesTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
          <Border Height="1"
                  Background="{ThemeResource OutlineVariantBrush}"
                  Margin="0,9,0,0"
                  Visibility="{x:Bind ViewModel.IsRecipesTab, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1"
              Style="{StaticResource TextButtonStyle}"
              HorizontalAlignment="Stretch"
              Command="{x:Bind ViewModel.SelectCookbooksCommand}">
        <StackPanel>
          <TextBlock Text="My Cookbooks"
                     HorizontalAlignment="Center"
                     FontWeight="SemiBold" />
          <Border Height="2"
                  Background="{ThemeResource PrimaryBrush}"
                  Margin="0,8,0,0"
                  Visibility="{x:Bind ViewModel.IsCookbooksTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
          <Border Height="1"
                  Background="{ThemeResource OutlineVariantBrush}"
                  Margin="0,9,0,0"
                  Visibility="{x:Bind ViewModel.IsCookbooksTab, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Recipes tab content -->
    <Grid Grid.Row="2"
          Visibility="{x:Bind ViewModel.IsRecipesTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
      <Grid Visibility="{x:Bind ViewModel.HasFavoriteRecipes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.FavoriteCountLabel, Mode=OneWay}"
                   Margin="16,12,16,8"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource OnBackgroundBrush}" />
        <ScrollViewer Grid.Row="1">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.FavoriteRecipes}" Margin="16,0,16,16">
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="150" MinItemHeight="200" MinRowSpacing="12" MinColumnSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="m:Recipe">
                <Border Background="{ThemeResource SurfaceBrush}"
                        CornerRadius="16"
                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                        BorderThickness="1"
                        Tapped="OnRecipeTapped">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="130" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                    <StackPanel Grid.Row="1" Padding="10,8">
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 Foreground="{ThemeResource OnSurfaceBrush}" />
                      <TextBlock Text="{x:Bind Calories}" FontSize="11"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
      </Grid>
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  Padding="32"
                  Visibility="{x:Bind ViewModel.HasNoFavoriteRecipes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
        <Image Source="ms-appx:///Assets/Images/empty_box_light.svg"
               Width="120" Height="120" Stretch="Uniform" />
        <TextBlock Text="No Favorites Yet" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" />
        <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   Text="You haven't added any recipes to your favorites. Start exploring and find delicious recipes to try and love!" />
      </StackPanel>
    </Grid>

    <!-- Cookbooks tab content -->
    <Grid Grid.Row="2"
          Visibility="{x:Bind ViewModel.IsCookbooksTab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
      <Grid Visibility="{x:Bind ViewModel.HasCookbooks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
        <ScrollViewer>
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cookbooks}" Margin="16,12,16,16">
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="160" MinItemHeight="200" MinRowSpacing="12" MinColumnSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="m:Cookbook">
                <Border Background="{ThemeResource SurfaceBrush}"
                        CornerRadius="16"
                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                        BorderThickness="1"
                        Tapped="OnCookbookTapped">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="140" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                      </Grid.RowDefinitions>
                      <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Source="{x:Bind Image1}" Stretch="UniformToFill" />
                      <Image Grid.Row="0" Grid.Column="1" Source="{x:Bind Image2}" Stretch="UniformToFill" />
                      <Image Grid.Row="1" Grid.Column="1" Source="{x:Bind Image3}" Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel Grid.Row="1" Padding="12,8">
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                 Foreground="{ThemeResource OnSurfaceBrush}" />
                      <TextBlock Text="{x:Bind RecipeCountLabel}" FontSize="11"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Width="56" Height="56"
                CornerRadius="28"
                Background="{ThemeResource PrimaryBrush}"
                Foreground="{ThemeResource OnPrimaryBrush}"
                Command="{x:Bind ViewModel.CreateCookbookCommand}">
          <FontIcon Glyph="&#xE710;" />
        </Button>
      </Grid>
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  Padding="32"
                  Visibility="{x:Bind ViewModel.HasNoCookbooks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
        <Image Source="ms-appx:///Assets/Images/empty_box_light.svg"
               Width="120" Height="120" Stretch="Uniform" />
        <TextBlock Text="No Cookbooks Created" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" />
        <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   Text="It looks like you haven't created any cookbooks yet. Cookbooks are a great way to organize your recipes into collections." />
        <Button Style="{StaticResource TextButtonStyle}"
                Foreground="{ThemeResource PrimaryBrush}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.CreateCookbookCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE710;" FontSize="14" />
            <TextBlock Text="Create cookbook" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
