<Page x:Class="ChefsTest1.Presentation.LiveCookingFinishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="{ThemeResource SurfaceInverseBrush}" Height="56" Padding="8,8,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Background="Transparent"
              Foreground="{ThemeResource OnSurfaceInverseBrush}"
              Command="{x:Bind ViewModel.BackCommand}">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                 Text="{x:Bind ViewModel.AppBarTitle}" FontWeight="SemiBold" FontSize="18"
                 Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    </Grid>

    <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
      <Image Source="ms-appx:///Assets/Images/success_light.svg" Width="100" Height="100" />
      <TextBlock Text="Hurray!" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                 Foreground="{ThemeResource OnSurfaceBrush}" />
      <TextBlock Text="All steps are completed. Now it's time to enjoy your meal!"
                 TextAlignment="Center" TextWrapping="Wrap"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="16,16">
        <StackPanel Spacing="12">
          <TextBlock Text="Tell us how was your cooking experience!" HorizontalAlignment="Center"
                     Foreground="{ThemeResource OnSurfaceBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Style="{StaticResource TextButtonStyle}" Command="{x:Bind ViewModel.Rate1Command}">
              <FontIcon Glyph="&#xE735;" FontSize="28" Foreground="{ThemeResource PrimaryBrush}"
                        Visibility="{x:Bind ViewModel.Star1, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Button>
            <Button Style="{StaticResource TextButtonStyle}" Command="{x:Bind ViewModel.Rate2Command}">
              <FontIcon Glyph="&#xE735;" FontSize="28"
                        Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </Button>
            <Button Style="{StaticResource TextButtonStyle}" Command="{x:Bind ViewModel.Rate3Command}">
              <FontIcon Glyph="&#xE735;" FontSize="28"
                        Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </Button>
            <Button Style="{StaticResource TextButtonStyle}" Command="{x:Bind ViewModel.Rate4Command}">
              <FontIcon Glyph="&#xE735;" FontSize="28"
                        Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </Button>
            <Button Style="{StaticResource TextButtonStyle}" Command="{x:Bind ViewModel.Rate5Command}">
              <FontIcon Glyph="&#xE735;" FontSize="28"
                        Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="12" Padding="16,8,16,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Previous" HorizontalAlignment="Stretch"
              Style="{StaticResource OutlinedButtonStyle}"
              Command="{x:Bind ViewModel.PreviousCommand}" />
      <Button Grid.Column="1" HorizontalAlignment="Stretch"
              Style="{StaticResource FilledButtonStyle}"
              Command="{x:Bind ViewModel.FavoriteCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xEB52;" />
          <TextBlock Text="Favorite" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Page>
