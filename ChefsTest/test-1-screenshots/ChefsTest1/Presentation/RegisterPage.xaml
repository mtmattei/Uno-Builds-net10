<Page x:Class="ChefsTest1.Presentation.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <utu:SafeArea Insets="VisibleBounds,SoftInput" Mode="Padding">
    <ScrollViewer>
      <StackPanel Padding="32,48,32,32" Spacing="20" MaxWidth="480" HorizontalAlignment="Stretch">
        <Image Source="ms-appx:///Assets/Images/chefsappsignature_light.svg"
               Width="160" Height="80" Stretch="Uniform"
               HorizontalAlignment="Center" Margin="0,32,0,32" />
        <TextBox PlaceholderText="Username"
                 Style="{StaticResource OutlinedTextBoxStyle}"
                 Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />
        <TextBox PlaceholderText="Email"
                 Style="{StaticResource OutlinedTextBoxStyle}"
                 Text="{x:Bind ViewModel.Email, Mode=TwoWay}" />
        <PasswordBox PlaceholderText="Password"
                     Style="{StaticResource OutlinedPasswordBoxStyle}"
                     Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
        <Button Content="Sign Up"
                HorizontalAlignment="Stretch"
                Height="48"
                Style="{StaticResource FilledButtonStyle}"
                Command="{x:Bind ViewModel.SignUpCommand}" />
        <StackPanel Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
          <TextBlock Text="Already a member?" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          <Button Content="Login Now"
                  Style="{StaticResource TextButtonStyle}"
                  Foreground="{ThemeResource PrimaryBrush}"
                  Padding="0"
                  Command="{x:Bind ViewModel.LoginCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </utu:SafeArea>
</Page>
