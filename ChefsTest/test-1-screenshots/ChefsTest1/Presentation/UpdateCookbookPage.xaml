<Page x:Class="ChefsTest1.Presentation.UpdateCookbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest1.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="{ThemeResource SurfaceInverseBrush}" Height="56" Padding="8,8,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Background="Transparent" Command="{x:Bind ViewModel.CancelCommand}"
              Foreground="{ThemeResource OnSurfaceInverseBrush}">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Title}" Margin="8,0,0,0"
                 VerticalAlignment="Center" FontWeight="SemiBold" FontSize="18"
                 Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    </Grid>

    <TextBox Grid.Row="1" Margin="16,12,16,8"
             PlaceholderText="Cookbook name"
             Style="{StaticResource OutlinedTextBoxStyle}"
             Text="{x:Bind ViewModel.CookbookName, Mode=TwoWay}" />
    <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.SectionTitle}" Margin="16,8" FontWeight="SemiBold"
               Foreground="{ThemeResource OnBackgroundBrush}" />

    <ScrollViewer Grid.Row="3">
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.AvailableRecipes}" Margin="16,0,16,16">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinItemWidth="150" MinItemHeight="200" MinRowSpacing="12" MinColumnSpacing="12" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="m:Recipe">
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="16"
                    BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="130" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                <StackPanel Grid.Row="1" Padding="10,8">
                  <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             Foreground="{ThemeResource OnSurfaceBrush}" />
                  <TextBlock Text="{x:Bind Calories}" FontSize="11"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </ScrollViewer>

    <Grid Grid.Row="4" Padding="16" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch" Height="48"
              Style="{StaticResource OutlinedButtonStyle}"
              Command="{x:Bind ViewModel.CancelCommand}" />
      <Button Grid.Column="1" Content="{x:Bind ViewModel.ApplyButton}" HorizontalAlignment="Stretch" Height="48"
              Style="{StaticResource FilledButtonStyle}"
              Command="{x:Bind ViewModel.ApplyCommand}" />
    </Grid>
  </Grid>
</Page>
