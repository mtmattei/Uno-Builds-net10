<Page x:Class="ChefsTest1.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="8,8,16,8" Height="56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Background="Transparent" Command="{x:Bind ViewModel.BackCommand}"
              Foreground="{ThemeResource OnBackgroundBrush}">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <TextBlock Grid.Column="1" Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center"
                 FontWeight="SemiBold" FontSize="22"
                 Foreground="{ThemeResource OnBackgroundBrush}" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16" Padding="16">
        <TextBlock Text="Personal Information" FontWeight="SemiBold"
                   Foreground="{ThemeResource OnBackgroundBrush}" />
        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="0">
          <StackPanel>
            <Grid Padding="12,8" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE77B;" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Name" FontSize="11" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay}" BorderThickness="0" Background="Transparent" />
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
            <Grid Padding="12,8" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE715;" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Email" FontSize="11" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <TextBox Text="{x:Bind ViewModel.Email, Mode=TwoWay}" BorderThickness="0" Background="Transparent" />
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
            <Grid Padding="12,8" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE8EA;" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Mobile Number" FontSize="11" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <TextBox Text="{x:Bind ViewModel.Mobile, Mode=TwoWay}" PlaceholderText="Mobile Number"
                         BorderThickness="0" Background="Transparent" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Application settings" FontWeight="SemiBold"
                   Foreground="{ThemeResource OnBackgroundBrush}" />
        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="0">
          <StackPanel>
            <Grid Padding="12,12" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xEA8F;" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Notifications" VerticalAlignment="Center"
                         Foreground="{ThemeResource OnSurfaceBrush}" />
              <ToggleSwitch Grid.Column="2" OffContent="" OnContent=""
                            IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
            </Grid>
            <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />
            <Grid Padding="12,12" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE708;" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Night Mode" VerticalAlignment="Center"
                         Foreground="{ThemeResource OnSurfaceBrush}" />
              <ToggleSwitch Grid.Column="2" OffContent="" OnContent=""
                            IsOn="{x:Bind ViewModel.NightMode, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Padding="16" Spacing="8">
      <Button Content="Save Changes" HorizontalAlignment="Stretch" Height="48"
              Style="{StaticResource FilledButtonStyle}"
              Command="{x:Bind ViewModel.SaveCommand}" />
      <Button Content="Log out" HorizontalAlignment="Stretch" Height="40"
              Style="{StaticResource TextButtonStyle}"
              Foreground="{ThemeResource OnSurfaceVariantBrush}"
              Command="{x:Bind ViewModel.LogOutCommand}" />
    </StackPanel>
  </Grid>
</Page>
