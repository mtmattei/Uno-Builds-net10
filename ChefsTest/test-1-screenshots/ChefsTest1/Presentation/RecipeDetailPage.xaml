<Page x:Class="ChefsTest1.Presentation.RecipeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest1.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Inverted top app bar with back chevron -->
    <Grid Grid.Row="0"
          Background="{ThemeResource SurfaceInverseBrush}"
          Height="56"
          Padding="8,8,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Background="Transparent"
              Foreground="{ThemeResource OnSurfaceInverseBrush}"
              Command="{x:Bind ViewModel.BackCommand}">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <TextBlock Grid.Column="1"
                 VerticalAlignment="Center"
                 Margin="8,0,0,0"
                 Text="{x:Bind ViewModel.Recipe.Name}"
                 FontWeight="SemiBold"
                 FontSize="18"
                 Foreground="{ThemeResource OnSurfaceInverseBrush}" />
      <Button Grid.Column="2" Background="Transparent"
              Foreground="{ThemeResource OnSurfaceInverseBrush}">
        <FontIcon Glyph="&#xE721;" />
      </Button>
      <Button Grid.Column="3" Background="Transparent"
              Foreground="{ThemeResource OnSurfaceInverseBrush}">
        <FontIcon Glyph="&#xE712;" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel>
        <!-- Author strip -->
        <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,12,16,12"
                    Background="{ThemeResource BackgroundBrush}">
          <PersonPicture Width="32" Height="32" ProfilePicture="{x:Bind ViewModel.Recipe.Creator.UrlProfileImage}" />
          <TextBlock Text="{x:Bind ViewModel.CreatorByline}"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource OnBackgroundBrush}" />
        </StackPanel>
        <!-- Hero -->
        <Image Source="{x:Bind ViewModel.Recipe.ImageUrl}"
               Height="240"
               Stretch="UniformToFill" />
        <!-- 3-up stat row in card -->
        <Border Background="{ThemeResource SurfaceBrush}"
                CornerRadius="12"
                Margin="16,-24,16,12"
                BorderBrush="{ThemeResource OutlineVariantBrush}"
                BorderThickness="1"
                Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
              <FontIcon Glyph="&#xE916;" FontSize="20" />
              <TextBlock Text="{x:Bind ViewModel.CookTimeLabel}" FontSize="13"
                         HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="4">
              <FontIcon Glyph="&#xE735;" FontSize="20" />
              <TextBlock Text="{x:Bind ViewModel.DifficultyLabel}" FontSize="13"
                         HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
              <FontIcon Glyph="&#xEDB1;" FontSize="20" />
              <TextBlock Text="{x:Bind ViewModel.CaloriesLabel}" FontSize="13"
                         HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Tabs -->
        <Grid Margin="16,8,16,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.SelectIngredientsCommand}">
            <StackPanel>
              <TextBlock Text="Ingredients" HorizontalAlignment="Center" />
              <Border Height="2" Background="{ThemeResource PrimaryBrush}" Margin="0,6,0,0"
                      Visibility="{x:Bind ViewModel.IsIngredients, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.SelectStepsCommand}">
            <StackPanel>
              <TextBlock Text="Steps" HorizontalAlignment="Center" />
              <Border Height="2" Background="{ThemeResource PrimaryBrush}" Margin="0,6,0,0"
                      Visibility="{x:Bind ViewModel.IsSteps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.SelectReviewsCommand}">
            <StackPanel>
              <TextBlock Text="Reviews" HorizontalAlignment="Center" />
              <Border Height="2" Background="{ThemeResource PrimaryBrush}" Margin="0,6,0,0"
                      Visibility="{x:Bind ViewModel.IsReviews, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.SelectNutritionCommand}">
            <StackPanel>
              <TextBlock Text="Nutrition" HorizontalAlignment="Center" />
              <Border Height="2" Background="{ThemeResource PrimaryBrush}" Margin="0,6,0,0"
                      Visibility="{x:Bind ViewModel.IsNutrition, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Ingredients list -->
        <StackPanel Visibility="{x:Bind ViewModel.IsIngredients, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Padding="16,8,16,16" Spacing="6">
          <TextBlock Text="{x:Bind ViewModel.IngredientsLabel, Mode=OneWay}" FontWeight="SemiBold"
                     Foreground="{ThemeResource OnBackgroundBrush}" />
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Ingredients}">
            <ItemsRepeater.Layout>
              <StackLayout Orientation="Vertical" Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="m:Ingredient">
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="10" Padding="10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{x:Bind UrlIcon}" Width="32" Height="32" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{x:Bind Name}" FontWeight="SemiBold"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <Border Grid.Column="2" Padding="8,4" CornerRadius="8"
                            Background="{ThemeResource SurfaceVariantBrush}">
                      <TextBlock Text="{x:Bind Quantity}" FontSize="12"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>

        <!-- Steps list -->
        <StackPanel Visibility="{x:Bind ViewModel.IsSteps, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Padding="16,8,16,16" Spacing="6">
          <TextBlock Text="{x:Bind ViewModel.StepsLabel, Mode=OneWay}" FontWeight="SemiBold"
                     Foreground="{ThemeResource OnBackgroundBrush}" />
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Steps}">
            <ItemsRepeater.Layout>
              <StackLayout Orientation="Vertical" Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="m:Step">
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="10" Padding="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock Text="{x:Bind ShortDescription}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>

        <!-- Reviews list -->
        <Grid Visibility="{x:Bind ViewModel.IsReviews, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
              Padding="16,8,16,16">
          <StackPanel Visibility="{x:Bind ViewModel.HasReviews, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.ReviewsLabel, Mode=OneWay}" FontWeight="SemiBold"
                       Foreground="{ThemeResource OnBackgroundBrush}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Reviews}">
              <ItemsRepeater.Layout>
                <StackLayout Orientation="Vertical" Spacing="8" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="m:Review">
                  <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PersonPicture Width="32" Height="32" ProfilePicture="{x:Bind UrlAuthorImage}" />
                        <StackPanel>
                          <TextBlock Text="{x:Bind PublisherName}" FontWeight="SemiBold"
                                     Foreground="{ThemeResource OnSurfaceBrush}" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="13"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <FontIcon Glyph="&#xE19F;" FontSize="14" Foreground="{ThemeResource PrimaryBrush}" />
                          <TextBlock Text="{x:Bind LikeCount}" FontSize="12"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <FontIcon Glyph="&#xE19E;" FontSize="14"
                                    Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                          <TextBlock Text="{x:Bind DislikeCount}" FontSize="12"
                                     Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
          <StackPanel Visibility="{x:Bind ViewModel.HasNoReviews, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                      HorizontalAlignment="Center" Spacing="12" Padding="32">
            <Image Source="ms-appx:///Assets/Images/empty_recipe_light.svg" Width="120" Height="120" />
            <TextBlock Text="No Reviews Yet" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" />
            <Button Style="{StaticResource TextButtonStyle}"
                    Foreground="{ThemeResource PrimaryBrush}"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.AddCommentCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                <TextBlock Text="Add comment" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Nutrition view -->
        <StackPanel Visibility="{x:Bind ViewModel.IsNutrition, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Padding="16,8,16,16" Spacing="12">
          <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="16"
                  BorderBrush="{ThemeResource PrimaryContainerBrush}" BorderThickness="1"
                  Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="Intake per serving" HorizontalAlignment="Center"
                         FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" />
              <Grid HorizontalAlignment="Center">
                <Border Width="120" Height="120" CornerRadius="60"
                        BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="6" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind ViewModel.CaloriesLabel}"
                             FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                             Foreground="{ThemeResource OnSurfaceBrush}" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Protein" Foreground="{ThemeResource OnSurfaceBrush}" />
                  <TextBlock Grid.Column="1" Text="30/110g"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </Grid>
                <ProgressBar Maximum="110" Value="30" Foreground="{ThemeResource PrimaryBrush}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Carbs" Foreground="{ThemeResource OnSurfaceBrush}" />
                  <TextBlock Grid.Column="1" Text="101/300g"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </Grid>
                <ProgressBar Maximum="300" Value="101" Foreground="{ThemeResource TertiaryBrush}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Fat" Foreground="{ThemeResource OnSurfaceBrush}" />
                  <TextBlock Grid.Column="1" Text="30/75g"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                </Grid>
                <ProgressBar Maximum="75" Value="30" Foreground="{ThemeResource PrimaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Sticky CTA -->
    <Button Grid.Row="2"
            Content="Start Cooking!"
            Margin="16,12,16,16"
            Height="48"
            HorizontalAlignment="Stretch"
            Style="{StaticResource FilledButtonStyle}"
            Command="{x:Bind ViewModel.StartCookingCommand}" />
  </Grid>
</Page>
