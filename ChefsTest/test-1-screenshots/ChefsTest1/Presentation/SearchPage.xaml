<Page x:Class="ChefsTest1.Presentation.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest1.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Inverted top app bar -->
    <Grid Grid.Row="0"
          Background="{ThemeResource SurfaceInverseBrush}"
          Height="56"
          Padding="16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="unoChefs"
                 VerticalAlignment="Center"
                 FontWeight="Bold"
                 FontSize="20"
                 Foreground="{ThemeResource OnSurfaceInverseBrush}" />
      <Button Grid.Column="1"
              Background="Transparent"
              Foreground="{ThemeResource OnSurfaceInverseBrush}"
              Command="{x:Bind ViewModel.OpenNotificationsCommand}">
        <FontIcon Glyph="&#xE787;" />
      </Button>
      <Button Grid.Column="2"
              Background="Transparent"
              Foreground="{ThemeResource OnSurfaceInverseBrush}"
              Command="{x:Bind ViewModel.OpenOwnProfileCommand}">
        <FontIcon Glyph="&#xE721;" />
      </Button>
    </Grid>

    <!-- Search box -->
    <AutoSuggestBox Grid.Row="1"
                    Margin="16,12"
                    PlaceholderText="Search"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

    <!-- Result count + Filters -->
    <Grid Grid.Row="2" Margin="16,0,16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Foreground="{ThemeResource OnBackgroundBrush}" />
      <Button Grid.Column="1"
              Style="{StaticResource TextButtonStyle}"
              Foreground="{ThemeResource PrimaryBrush}"
              Command="{x:Bind ViewModel.OpenFiltersCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE71C;" FontSize="16" />
          <TextBlock Text="Filters" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Result grid OR empty state -->
    <Grid Grid.Row="3">
      <ScrollViewer Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Results}" Margin="16,0,16,16">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="150" MinItemHeight="200" MinRowSpacing="12" MinColumnSpacing="12" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="m:Recipe">
              <Border Background="{ThemeResource SurfaceBrush}"
                      CornerRadius="16"
                      BorderBrush="{ThemeResource OutlineVariantBrush}"
                      BorderThickness="1"
                      Tapped="OnRecipeTapped">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="130" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                  <StackPanel Grid.Row="1" Padding="10,8">
                    <TextBlock Text="{x:Bind Name}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource OnSurfaceBrush}" />
                    <TextBlock Text="{x:Bind Calories}"
                               FontSize="11"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  Padding="32"
                  Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
        <Image Source="ms-appx:///Assets/Images/empty_box_light.svg"
               Width="120" Height="120" Stretch="Uniform" />
        <TextBlock Text="No Results Found"
                   FontSize="20"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource OnSurfaceBrush}" />
        <TextBlock TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   Text="We couldn't find any recipes matching your search. Try adjusting your keywords or filters, or explore our popular categories to discover something delicious!" />
        <Button Style="{StaticResource TextButtonStyle}"
                Foreground="{ThemeResource PrimaryBrush}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.OpenPopularCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE734;" FontSize="14" />
            <TextBlock Text="View popular recipes" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
