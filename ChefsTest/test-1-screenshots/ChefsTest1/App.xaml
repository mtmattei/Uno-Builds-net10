<Application x:Class="ChefsTest1.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:p="using:ChefsTest1.Presentation"
       xmlns:utum="using:Uno.Toolkit.UI.Material">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme
          ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <p:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <p:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <p:CountToVisibilityConverter x:Key="CountToVisibility" />
      <p:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility" />
      <p:BoolToRedHeartConverter x:Key="BoolToRedHeart" />

    </ResourceDictionary>
  </Application.Resources>

</Application>
