<UserControl x:Class="ChefsTest5.Presentation.SearchView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest5.Models"
      xmlns:conv="using:ChefsTest5.Presentation.Converters">
  <UserControl.Resources>
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
  </UserControl.Resources>
  <Grid Background="{ThemeResource ChefBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource ChefAppBarBrush}" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="ms-appx:///Assets/Images/chefsappsignature_dark.svg"
               Width="100" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button Background="Transparent" BorderThickness="0" Padding="8">
            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                       Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
          </Button>
          <Button Background="Transparent" BorderThickness="0" Padding="8">
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                       Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16,16,16,32" Spacing="14">
        <Border Background="{ThemeResource ChefSurfaceBrush}" CornerRadius="22" Padding="14,10">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{ThemeResource ChefMutedBrush}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" PlaceholderText="Search"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent" />
          </Grid>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource ChefBody}">
            <Run Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" />
            <Run Text=" results" />
          </TextBlock>
          <HyperlinkButton Grid.Column="1" Padding="0"
                           Foreground="{ThemeResource ChefPinkBrush}"
                           FontWeight="SemiBold"
                           Command="{x:Bind ViewModel.OpenFiltersCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="&#xE15E;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
              <TextBlock Text="Filters" />
            </StackPanel>
          </HyperlinkButton>
        </Grid>

        <Grid Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="160" MinColumnSpacing="12" MinRowSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="m:RecipeData">
                <Border Style="{StaticResource ChefCard}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="120" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="12,12,0,0">
                      <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChefBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource ChefMuted}">
                        <Run Text="{x:Bind Calories}" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </Grid>

        <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,40,0,0"
                    Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource CountToVisibility}, ConverterParameter=empty}">
          <Image Source="ms-appx:///Assets/Images/empty_recipe_light.svg"
                 Width="160" Height="160" />
          <TextBlock Text="No results" Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
          <TextBlock Text="Try a different keyword or adjust your filters." Style="{StaticResource ChefMuted}"
                     TextAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
