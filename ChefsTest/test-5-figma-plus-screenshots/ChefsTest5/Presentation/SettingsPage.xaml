<Page x:Class="ChefsTest5.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,12">
      <Button Background="Transparent" BorderThickness="0" Padding="6"
              Command="{x:Bind ViewModel.BackCommand}">
        <TextBlock Text="&#xE0C4;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                   Foreground="{ThemeResource ChefBodyBrush}" />
      </Button>
      <TextBlock Text="Settings" Style="{StaticResource ChefH1}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="16,8,16,16">
      <StackPanel Spacing="20">
        <TextBlock Text="Personal Information" Style="{StaticResource ChefSectionTitle}" />
        <Border Style="{StaticResource ChefCard}" Padding="14">
          <StackPanel Spacing="14">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         Foreground="{ThemeResource ChefPinkBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Name" Style="{StaticResource ChefMuted}" />
                <TextBox Text="{x:Bind ViewModel.UserName, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" Padding="0" />
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{ThemeResource ChefDividerBrush}" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         Foreground="{ThemeResource ChefPinkBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Email" Style="{StaticResource ChefMuted}" />
                <TextBox Text="{x:Bind ViewModel.Email, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" Padding="0" />
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{ThemeResource ChefDividerBrush}" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         Foreground="{ThemeResource ChefPinkBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Mobile Number" Style="{StaticResource ChefMuted}" />
                <TextBox Text="{x:Bind ViewModel.PhoneNumber, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" Padding="0" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Application settings" Style="{StaticResource ChefSectionTitle}" />
        <Border Style="{StaticResource ChefCard}" Padding="14">
          <StackPanel Spacing="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         Foreground="{ThemeResource ChefPinkBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" Text="Notifications"
                         Style="{StaticResource ChefBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="2" OnContent="" OffContent=""
                            IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
            </Grid>
            <Border Height="1" Background="{ThemeResource ChefDividerBrush}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         Foreground="{ThemeResource ChefPinkBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" Text="Night Mode"
                         Style="{StaticResource ChefBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="2" OnContent="" OffContent=""
                            IsOn="{x:Bind ViewModel.NightMode, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </Border>

        <Button Style="{StaticResource ChefOutlineButton}" HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.LogoutCommand}" Content="Log out" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="16,12">
      <Button Style="{StaticResource ChefPrimaryButton}" Content="Save Changes"
              Command="{x:Bind ViewModel.SaveCommand}" />
    </Border>
  </Grid>
</Page>
