<Page x:Class="ChefsTest5.Presentation.LiveCookingFinishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource ChefAppBarBrush}" Padding="8,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.BackCommand}">
          <TextBlock Text="&#xE0C4;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
        </Button>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource ChefAppBarTitle}">
          <Run Text="Making " />
          <Run Text="{x:Bind ViewModel.RecipeName, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Spacing="20" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" MaxWidth="380">
      <Image Source="ms-appx:///Assets/Images/success_light.svg" Width="160" Height="160" HorizontalAlignment="Center" />
      <TextBlock Text="Hurray!" Style="{StaticResource ChefH1}" HorizontalAlignment="Center" />
      <TextBlock Text="All steps are completed. Now it's time to enjoy your meal!"
                 Style="{StaticResource ChefBody}" TextAlignment="Center" />
      <Border Style="{StaticResource ChefCard}" Padding="20" Background="{ThemeResource ChefBackgroundBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="Tell us how was your cooking experience!"
                     Style="{StaticResource ChefBody}" TextAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                       Foreground="{ThemeResource ChefRatingInactiveBrush}" />
            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                       Foreground="{ThemeResource ChefRatingInactiveBrush}" />
            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                       Foreground="{ThemeResource ChefRatingInactiveBrush}" />
            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                       Foreground="{ThemeResource ChefRatingInactiveBrush}" />
            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                       Foreground="{ThemeResource ChefRatingInactiveBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" Padding="16,12" Background="{ThemeResource ChefSurfaceBrush}"
          BorderBrush="{ThemeResource ChefDividerBrush}" BorderThickness="0,1,0,0"
          ColumnSpacing="12" utu:SafeArea.Insets="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource ChefOutlineButton}" Content="Previous" Command="{x:Bind ViewModel.BackCommand}" />
      <Button Grid.Column="1" Style="{StaticResource ChefPrimaryButton}" Command="{x:Bind ViewModel.FavoriteCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
          <TextBlock Text="Favorite" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Page>
