<Page x:Class="ChefsTest5.Presentation.NearMeMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,12">
      <Button Background="Transparent" BorderThickness="0" Padding="6"
              Command="{x:Bind ViewModel.BackCommand}">
        <TextBlock Text="&#xE0C4;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                   Foreground="{ThemeResource ChefBodyBrush}" />
      </Button>
      <TextBlock Text="Near me" Style="{StaticResource ChefH2}" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Border Background="#E8F0F2" />
      <Image Source="ms-appx:///Assets/Maps/location_pin.svg" Width="40" Height="40" />
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="16,0,16,80"
              Style="{StaticResource ChefCard}" Padding="14,10">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Ellipse Width="44" Height="44">
            <Ellipse.Fill>
              <ImageBrush ImageSource="ms-appx:///Assets/Profiles/niki_samantha.png" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="HealthyFoodie" Style="{StaticResource ChefBody}" FontWeight="SemiBold" />
            <TextBlock Text="0.5 km away" Style="{StaticResource ChefMuted}" />
          </StackPanel>
        </Grid>
      </Border>
      <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
              Background="{ThemeResource ChefPinkBrush}" Foreground="White"
              Width="56" Height="56" CornerRadius="28" BorderThickness="0">
        <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="22" />
      </Button>
    </Grid>
  </Grid>
</Page>
