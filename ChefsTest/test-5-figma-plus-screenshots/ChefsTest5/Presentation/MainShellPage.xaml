<Page x:Class="ChefsTest5.Presentation.MainShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest5.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:conv="using:ChefsTest5.Presentation.Converters"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Page.Resources>
    <conv:IndexToVisibilityConverter x:Key="IndexToVis" />
  </Page.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <local:HomeView Visibility="{x:Bind ViewModel.SelectedIndex, Mode=OneWay, Converter={StaticResource IndexToVis}, ConverterParameter=0}" />
      <local:SearchView Visibility="{x:Bind ViewModel.SelectedIndex, Mode=OneWay, Converter={StaticResource IndexToVis}, ConverterParameter=1}" />
      <local:FavoritesView Visibility="{x:Bind ViewModel.SelectedIndex, Mode=OneWay, Converter={StaticResource IndexToVis}, ConverterParameter=2}" />
    </Grid>

    <Border Grid.Row="1"
            Background="{ThemeResource ChefSurfaceBrush}"
            BorderBrush="{ThemeResource ChefDividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,8"
            utu:SafeArea.Insets="Bottom">
      <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:NavTab Grid.Column="0" Glyph="&#xE80F;" Label="Home"
                      IsActive="{x:Bind ViewModel.IsHomeSelected, Mode=OneWay}"
                      Command="{x:Bind ViewModel.SelectTabCommand}"
                      CommandParameter="0" />
        <local:NavTab Grid.Column="1" Glyph="&#xE721;" Label="Search"
                      IsActive="{x:Bind ViewModel.IsSearchSelected, Mode=OneWay}"
                      Command="{x:Bind ViewModel.SelectTabCommand}"
                      CommandParameter="1" />
        <local:NavTab Grid.Column="2" Glyph="&#xEB52;" Label="Favorites"
                      IsActive="{x:Bind ViewModel.IsFavoritesSelected, Mode=OneWay}"
                      Command="{x:Bind ViewModel.SelectTabCommand}"
                      CommandParameter="2" />
      </Grid>
    </Border>
  </Grid>
</Page>
