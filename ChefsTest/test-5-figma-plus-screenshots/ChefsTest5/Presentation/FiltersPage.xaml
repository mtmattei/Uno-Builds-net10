<Page x:Class="ChefsTest5.Presentation.FiltersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="12" Padding="16,12">
      <Button Background="Transparent" BorderThickness="0" Padding="6"
              Command="{x:Bind ViewModel.CloseCommand}">
        <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                   Foreground="{ThemeResource ChefBodyBrush}" />
      </Button>
      <TextBlock Text="Filters" Style="{StaticResource ChefH1}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="16,8,16,16">
      <StackPanel Spacing="20">
        <TextBlock Text="Recipe Categories" Style="{StaticResource ChefSectionTitle}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Style="{StaticResource ChefChip}" Content="Popular" />
          <Button Style="{StaticResource ChefChip}" Content="Trending" />
          <Button Style="{StaticResource ChefChip}" Content="Recent" />
        </StackPanel>
        <TextBlock Text="Cooking Time" Style="{StaticResource ChefSectionTitle}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Style="{StaticResource ChefChip}" Content="15 min" />
          <Button Style="{StaticResource ChefChip}" Content="30 min" />
          <Button Style="{StaticResource ChefChip}" Content="60 min" />
        </StackPanel>
        <TextBlock Text="Skill Level" Style="{StaticResource ChefSectionTitle}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Style="{StaticResource ChefChip}" Content="Beginner" />
          <Button Style="{StaticResource ChefChip}" Content="Intermediate" />
          <Button Style="{StaticResource ChefChip}" Content="Advance" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Padding="16,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource ChefOutlineButton}" Content="Reset" Command="{x:Bind ViewModel.ResetCommand}" />
      <Button Grid.Column="1" Style="{StaticResource ChefPrimaryButton}" Content="Apply filter"
              Command="{x:Bind ViewModel.ApplyCommand}" />
    </Grid>
  </Grid>
</Page>
