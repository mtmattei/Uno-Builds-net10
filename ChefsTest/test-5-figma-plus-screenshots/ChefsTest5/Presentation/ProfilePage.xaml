<Page x:Class="ChefsTest5.Presentation.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest5.Models"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource ChefAppBarBrush}" Padding="8,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.BackCommand}">
          <TextBlock Text="&#xE0C4;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
        </Button>
        <TextBlock Grid.Column="1" Text="Profile" Style="{StaticResource ChefAppBarTitle}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8"
                Command="{x:Bind ViewModel.GoSettingsCommand}">
          <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16,16,16,32" Spacing="20">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Ellipse Width="100" Height="100">
            <Ellipse.Fill>
              <ImageBrush ImageSource="{x:Bind ViewModel.User.UrlProfileImage, Mode=OneWay}" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock Text="{x:Bind ViewModel.User.FullName, Mode=OneWay}" Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
        </StackPanel>

        <Border Style="{StaticResource ChefCard}" Padding="14,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind ViewModel.User.Recipes, Mode=OneWay}" Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
              <TextBlock Text="Recipes" Style="{StaticResource ChefMuted}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind ViewModel.User.Followers, Mode=OneWay}" Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
              <TextBlock Text="Followers" Style="{StaticResource ChefMuted}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind ViewModel.User.Following, Mode=OneWay}" Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
              <TextBlock Text="Following" Style="{StaticResource ChefMuted}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="My Recipes" Style="{StaticResource ChefSectionTitle}" />
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.MyRecipes, Mode=OneWay}">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="160" MinColumnSpacing="12" MinRowSpacing="12" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="m:RecipeData">
              <Border Style="{StaticResource ChefCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border CornerRadius="12,12,0,0">
                    <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChefBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Calories}" Style="{StaticResource ChefMuted}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
