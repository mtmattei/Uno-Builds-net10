<UserControl x:Class="ChefsTest5.Presentation.NavTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button x:Name="RootButton"
          Background="Transparent" BorderThickness="0" Padding="6,4"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
    <StackPanel Spacing="2" HorizontalAlignment="Center">
      <Border x:Name="IconHost"
              CornerRadius="14" Padding="14,4"
              Background="Transparent">
        <TextBlock x:Name="GlyphText"
                   FontFamily="Segoe MDL2 Assets" FontSize="18"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource ChefBodyBrush}" />
      </Border>
      <TextBlock x:Name="LabelText"
                 FontSize="11" HorizontalAlignment="Center"
                 Foreground="{ThemeResource ChefBodyBrush}" />
    </StackPanel>
  </Button>
</UserControl>
