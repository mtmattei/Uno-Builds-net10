<Page x:Class="ChefsTest5.Presentation.LiveCookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest5.Models"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="220" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource ChefAppBarBrush}" Padding="8,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.BackCommand}">
          <TextBlock Text="&#xE0C4;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
        </Button>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource ChefAppBarTitle}">
          <Run Text="Making " />
          <Run Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Image Source="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Stretch="UniformToFill" />
      <Border VerticalAlignment="Bottom" Background="#88000000" Padding="14,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <ProgressBar Grid.Column="1" Value="40" Maximum="100" Foreground="{ThemeResource ChefPinkBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Grid.Column="2" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Margin="6,0" />
          <TextBlock Grid.Column="3" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Margin="6,0" />
          <TextBlock Grid.Column="4" Text="&#xE93E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Margin="6,0" />
          <TextBlock Grid.Column="5" Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Margin="6,0" />
        </Grid>
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="2" Padding="16,12">
      <StackPanel Spacing="12">
        <TextBlock Text="{x:Bind ViewModel.CurrentStepHeading, Mode=OneWay}"
                   Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
        <Border Style="{StaticResource ChefCard}" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="Ingredients:" Style="{StaticResource ChefBody}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentIngredients, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{ThemeResource ChefPinkBrush}" />
                    <TextBlock Text="{x:Bind}" Style="{StaticResource ChefBody}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <TextBlock Text="{x:Bind ViewModel.CurrentDescription, Mode=OneWay}"
                   Style="{StaticResource ChefBody}" TextAlignment="Center" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.PipDots, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:Boolean">
              <Ellipse Width="8" Height="8" Fill="{ThemeResource ChefPipInactiveBrush}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="3" Padding="16,12" Background="{ThemeResource ChefSurfaceBrush}"
          BorderBrush="{ThemeResource ChefDividerBrush}" BorderThickness="0,1,0,0"
          ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource ChefOutlineButton}" Content="Previous" Command="{x:Bind ViewModel.PreviousCommand}" />
      <Button Grid.Column="1" Style="{StaticResource ChefPrimaryButton}" Content="{x:Bind ViewModel.NextLabel, Mode=OneWay}"
              Command="{x:Bind ViewModel.NextCommand}" />
    </Grid>
  </Grid>
</Page>
