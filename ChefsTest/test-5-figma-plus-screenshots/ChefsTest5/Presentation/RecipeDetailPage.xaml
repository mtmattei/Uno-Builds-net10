<Page x:Class="ChefsTest5.Presentation.RecipeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest5.Models"
      xmlns:conv="using:ChefsTest5.Presentation.Converters"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Page.Resources>
    <conv:IndexToVisibilityConverter x:Key="IdxVis" />
  </Page.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource ChefAppBarBrush}" Padding="8,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Background="Transparent" BorderThickness="0" Padding="8"
                Command="{x:Bind ViewModel.BackCommand}">
          <TextBlock Text="&#xE0C4;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
        </Button>
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}"
                   Style="{StaticResource ChefAppBarTitle}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8">
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="8">
          <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel>
        <Border Background="{ThemeResource ChefSurfaceBrush}" Padding="16,10">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Width="32" Height="32">
              <Ellipse.Fill>
                <ImageBrush ImageSource="{x:Bind ViewModel.Recipe.Creator.UrlProfileImage, Mode=OneWay}" Stretch="UniformToFill" />
              </Ellipse.Fill>
            </Ellipse>
            <TextBlock Style="{StaticResource ChefBody}" VerticalAlignment="Center">
              <Run Text="By " />
              <Run Text="{x:Bind ViewModel.Recipe.Creator.FullName, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
          </StackPanel>
        </Border>

        <Image Source="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Height="220" Stretch="UniformToFill" />

        <Border Background="{ThemeResource ChefSurfaceBrush}" Margin="16,12" CornerRadius="12" Padding="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         HorizontalAlignment="Center" Foreground="{ThemeResource ChefBodyBrush}" />
              <TextBlock Text="{x:Bind ViewModel.CookTimeText, Mode=OneWay}"
                         Style="{StaticResource ChefBody}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         HorizontalAlignment="Center" Foreground="{ThemeResource ChefBodyBrush}" />
              <TextBlock Text="{x:Bind ViewModel.DifficultyText, Mode=OneWay}"
                         Style="{StaticResource ChefBody}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         HorizontalAlignment="Center" Foreground="{ThemeResource ChefBodyBrush}" />
              <TextBlock Text="{x:Bind ViewModel.Recipe.Calories, Mode=OneWay}"
                         Style="{StaticResource ChefBody}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Padding="16,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Background="Transparent" BorderThickness="0,0,0,2"
                  BorderBrush="{ThemeResource ChefPinkBrush}" Padding="0,10"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="0">
            <TextBlock Text="Ingredients" FontWeight="SemiBold"
                       Foreground="{ThemeResource ChefPinkBrush}" />
          </Button>
          <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,10"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="1">
            <TextBlock Text="Steps" Foreground="{ThemeResource ChefMutedBrush}" />
          </Button>
          <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0,10"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="2">
            <TextBlock Text="Reviews" Foreground="{ThemeResource ChefMutedBrush}" />
          </Button>
          <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0,10"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{x:Bind ViewModel.SelectTabCommand}" CommandParameter="3">
            <TextBlock Text="Nutrition" Foreground="{ThemeResource ChefMutedBrush}" />
          </Button>
        </Grid>

        <Grid Padding="16,8,16,16">
          <Grid Visibility="{x:Bind ViewModel.SelectedTab, Mode=OneWay, Converter={StaticResource IdxVis}, ConverterParameter=0}">
            <StackPanel Spacing="10">
              <TextBlock Style="{StaticResource ChefBody}">
                <Run Text="{x:Bind ViewModel.IngredientCount, Mode=OneWay}" />
                <Run Text=" items" />
              </TextBlock>
              <ItemsControl ItemsSource="{x:Bind ViewModel.Recipe.Ingredients, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:IngredientData">
                    <Border Style="{StaticResource ChefCard}" Padding="10,10" Margin="0,0,0,8">
                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="40" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{x:Bind UrlIcon}" Width="32" Height="32" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                   VerticalAlignment="Center" Style="{StaticResource ChefBody}" />
                        <Border Grid.Column="2" Background="{ThemeResource ChefBackgroundBrush}"
                                CornerRadius="4" Padding="6,3">
                          <TextBlock Text="{x:Bind Quantity}" Style="{StaticResource ChefMuted}" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
          <Grid Visibility="{x:Bind ViewModel.SelectedTab, Mode=OneWay, Converter={StaticResource IdxVis}, ConverterParameter=1}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Recipe.Steps, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:StepData">
                  <Border Style="{StaticResource ChefCard}" Padding="14" Margin="0,0,0,10">
                    <StackPanel Spacing="6">
                      <TextBlock Style="{StaticResource ChefBody}" FontWeight="SemiBold">
                        <Run Text="{x:Bind Number}" />
                        <Run Text=". " />
                        <Run Text="{x:Bind Name}" />
                      </TextBlock>
                      <TextBlock Text="{x:Bind Description}" Style="{StaticResource ChefMuted}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <Grid Visibility="{x:Bind ViewModel.SelectedTab, Mode=OneWay, Converter={StaticResource IdxVis}, ConverterParameter=2}">
            <StackPanel Spacing="10">
              <TextBlock Style="{StaticResource ChefBody}">
                <Run Text="{x:Bind ViewModel.ReviewCount, Mode=OneWay}" />
                <Run Text=" reviews" />
              </TextBlock>
              <Border Style="{StaticResource ChefCard}" Padding="14" Visibility="{x:Bind ViewModel.HasReviews, Mode=OneWay}">
                <TextBlock Text="Reviews go here when available." Style="{StaticResource ChefMuted}" />
              </Border>
              <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,40,0,0"
                          Visibility="{x:Bind ViewModel.NoReviews, Mode=OneWay}">
                <Image Source="ms-appx:///Assets/Images/empty_box_light.svg" Width="140" Height="140" />
                <TextBlock Text="No reviews yet" Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <Grid Visibility="{x:Bind ViewModel.SelectedTab, Mode=OneWay, Converter={StaticResource IdxVis}, ConverterParameter=3}">
            <StackPanel Spacing="14">
              <TextBlock Text="Nutrition Charts" Style="{StaticResource ChefSectionTitle}" />
              <Border Style="{StaticResource ChefCard}" Padding="16">
                <StackPanel Spacing="14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Protein" Style="{StaticResource ChefBody}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ProteinText, Mode=OneWay}"
                               Style="{StaticResource ChefBody}" FontWeight="SemiBold" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Carbs" Style="{StaticResource ChefBody}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CarbsText, Mode=OneWay}"
                               Style="{StaticResource ChefBody}" FontWeight="SemiBold" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fat" Style="{StaticResource ChefBody}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FatText, Mode=OneWay}"
                               Style="{StaticResource ChefBody}" FontWeight="SemiBold" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="16,12" Background="{ThemeResource ChefSurfaceBrush}"
            BorderBrush="{ThemeResource ChefDividerBrush}" BorderThickness="0,1,0,0"
            utu:SafeArea.Insets="Bottom">
      <Button Style="{StaticResource ChefPrimaryButton}" Content="Start Cooking!"
              Command="{x:Bind ViewModel.StartCookingCommand}" />
    </Border>
  </Grid>
</Page>
