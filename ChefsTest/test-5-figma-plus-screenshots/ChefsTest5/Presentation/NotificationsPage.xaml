<Page x:Class="ChefsTest5.Presentation.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest5.Models"
      xmlns:conv="using:ChefsTest5.Presentation.Converters"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Page.Resources>
    <conv:IndexToVisibilityConverter x:Key="IdxVis" />
    <conv:CountToVisibilityConverter x:Key="CountVis" />
  </Page.Resources>
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,12">
      <Button Background="Transparent" BorderThickness="0" Padding="6"
              Command="{x:Bind ViewModel.BackCommand}">
        <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                   Foreground="{ThemeResource ChefBodyBrush}" />
      </Button>
      <TextBlock Text="Notifications" Style="{StaticResource ChefH1}" />
    </StackPanel>

    <Grid Grid.Row="1" Padding="16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Background="Transparent" BorderThickness="0,0,0,2"
              BorderBrush="{ThemeResource ChefPinkBrush}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
              Command="{x:Bind ViewModel.SelectFilterCommand}" CommandParameter="0">
        <TextBlock Text="All" FontWeight="SemiBold" Foreground="{ThemeResource ChefPinkBrush}" />
      </Button>
      <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
              Command="{x:Bind ViewModel.SelectFilterCommand}" CommandParameter="1">
        <TextBlock Text="Unread" Foreground="{ThemeResource ChefMutedBrush}" />
      </Button>
      <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
              Command="{x:Bind ViewModel.SelectFilterCommand}" CommandParameter="2">
        <TextBlock Text="Read" Foreground="{ThemeResource ChefMutedBrush}" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="2" Padding="16,8,16,32">
      <StackPanel Spacing="14">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:NotificationData">
              <Border Style="{StaticResource ChefCard}" Padding="14,12" Margin="0,0,0,10">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                             Foreground="{ThemeResource ChefPinkBrush}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource ChefBody}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource ChefMuted}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,40,0,0"
                    Visibility="{x:Bind ViewModel.NotificationCount, Mode=OneWay, Converter={StaticResource CountVis}, ConverterParameter=empty}">
          <Image Source="ms-appx:///Assets/Images/empty_notification_light.svg" Width="160" Height="160" />
          <TextBlock Text="No notifications" Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
