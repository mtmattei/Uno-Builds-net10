<Page x:Class="ChefsTest5.Presentation.CreateCookbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest5.Models"
      Background="{ThemeResource ChefBackgroundBrush}">
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource ChefAppBarBrush}" Padding="8,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.BackCommand}">
          <TextBlock Text="&#xE0C4;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
        </Button>
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                   Style="{StaticResource ChefAppBarTitle}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="16,16,16,8">
      <StackPanel Spacing="14">
        <Border Style="{StaticResource ChefCard}" BorderBrush="{ThemeResource ChefDividerBrush}" BorderThickness="1" Padding="12,8">
          <TextBox Text="{x:Bind ViewModel.CookbookName, Mode=TwoWay}"
                   PlaceholderText="Cookbook name" BorderThickness="0" Background="Transparent" />
        </Border>
        <TextBlock Text="Add recipes" Style="{StaticResource ChefSectionTitle}" />
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recipes, Mode=OneWay}">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="160" MinColumnSpacing="12" MinRowSpacing="12" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="m:RecipeData">
              <Border Style="{StaticResource ChefCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Border CornerRadius="12,12,0,0">
                      <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{ThemeResource ChefHeartActiveBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" />
                  </Grid>
                  <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChefBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Calories}" Style="{StaticResource ChefMuted}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Padding="16,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource ChefOutlineButton}" Content="Cancel" Command="{x:Bind ViewModel.BackCommand}" />
      <Button Grid.Column="1" Style="{StaticResource ChefPrimaryButton}"
              Content="{x:Bind ViewModel.PrimaryLabel, Mode=OneWay}"
              Command="{x:Bind ViewModel.SaveCommand}" />
    </Grid>
  </Grid>
</Page>
