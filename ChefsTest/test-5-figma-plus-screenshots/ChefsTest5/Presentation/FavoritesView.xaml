<UserControl x:Class="ChefsTest5.Presentation.FavoritesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest5.Models"
      xmlns:conv="using:ChefsTest5.Presentation.Converters">
  <UserControl.Resources>
    <conv:IndexToVisibilityConverter x:Key="IdxVis" />
    <conv:CountToVisibilityConverter x:Key="CountVis" />
  </UserControl.Resources>

  <Grid Background="{ThemeResource ChefBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource ChefAppBarBrush}" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="ms-appx:///Assets/Images/chefsappsignature_dark.svg"
               Width="100" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button Background="Transparent" BorderThickness="0" Padding="8"
                  Command="{x:Bind ViewModel.GoProfileCommand}">
            <TextBlock Text="&#xE13D;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                       Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
          </Button>
          <Button Background="Transparent" BorderThickness="0" Padding="8"
                  Command="{x:Bind ViewModel.GoNotificationsCommand}">
            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                       Foreground="{ThemeResource ChefAppBarForegroundBrush}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Padding="16,12" Background="{ThemeResource ChefBackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Background="Transparent" BorderThickness="0,0,0,2"
              BorderBrush="{Binding SelectedSegment, Converter={StaticResource IdxVis}, ConverterParameter=0}"
              Command="{x:Bind ViewModel.SelectSegmentCommand}" CommandParameter="0"
              Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
        <TextBlock Text="All Recipes" FontWeight="SemiBold"
                   Foreground="{ThemeResource ChefBodyBrush}" />
      </Button>
      <Button Grid.Column="1" Background="Transparent" BorderThickness="0,0,0,2"
              BorderBrush="{Binding SelectedSegment, Converter={StaticResource IdxVis}, ConverterParameter=1}"
              Command="{x:Bind ViewModel.SelectSegmentCommand}" CommandParameter="1"
              Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
        <TextBlock Text="My Cookbooks" FontWeight="SemiBold"
                   Foreground="{ThemeResource ChefBodyBrush}" />
      </Button>
    </Grid>

    <Grid Grid.Row="2">
      <Grid Visibility="{x:Bind ViewModel.SelectedSegment, Mode=OneWay, Converter={StaticResource IdxVis}, ConverterParameter=0}">
        <ScrollViewer>
          <StackPanel Spacing="14" Padding="16,8,16,32">
            <TextBlock Style="{StaticResource ChefBody}">
              <Run Text="{x:Bind ViewModel.RecipeCount, Mode=OneWay}" />
              <Run Text=" results" />
            </TextBlock>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recipes, Mode=OneWay}">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="160" MinColumnSpacing="12" MinRowSpacing="12" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="m:RecipeData">
                  <Border Style="{StaticResource ChefCard}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Border CornerRadius="12,12,0,0">
                        <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChefBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource ChefMuted}">
                          <Run Text="{x:Bind Calories}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,40,0,0"
                        Visibility="{x:Bind ViewModel.RecipeCount, Mode=OneWay, Converter={StaticResource CountVis}, ConverterParameter=empty}">
              <Image Source="ms-appx:///Assets/Images/empty_box_light.svg" Width="160" Height="160" />
              <TextBlock Text="No favorites yet" Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid Visibility="{x:Bind ViewModel.SelectedSegment, Mode=OneWay, Converter={StaticResource IdxVis}, ConverterParameter=1}">
        <ScrollViewer>
          <StackPanel Spacing="14" Padding="16,8,16,32">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cookbooks, Mode=OneWay}">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="160" MinColumnSpacing="12" MinRowSpacing="12" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="m:CookbookData">
                  <Border Style="{StaticResource ChefCard}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="140" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Border CornerRadius="12,12,0,0" Background="{ThemeResource ChefDividerBrush}" />
                      <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChefBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource ChefMuted}">
                          <Run Text="{x:Bind PinsNumber}" />
                          <Run Text=" recipes" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,40,0,0"
                        Visibility="{x:Bind ViewModel.CookbookCount, Mode=OneWay, Converter={StaticResource CountVis}, ConverterParameter=empty}">
              <Image Source="ms-appx:///Assets/Images/empty_box_light.svg" Width="160" Height="160" />
              <TextBlock Text="No cookbooks yet" Style="{StaticResource ChefH2}" HorizontalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                Background="{ThemeResource ChefPinkBrush}" Foreground="White"
                Width="56" Height="56" CornerRadius="28" BorderThickness="0"
                Command="{x:Bind ViewModel.CreateCookbookCommand}">
          <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="22" />
        </Button>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
