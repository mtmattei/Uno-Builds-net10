<Application x:Class="ChefsTest7.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       xmlns:conv="using:ChefsTest7.Converters">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme
          ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
      <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
      <conv:NullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" Invert="True" />
      <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
      <conv:CountToVisibilityConverter x:Key="EmptyCountToVisibilityConverter" ShowWhenEmpty="True" />
      <conv:BoolToFavoriteGlyphConverter x:Key="BoolToFavoriteGlyphConverter" />
      <conv:TicksToMinutesConverter x:Key="TicksToMinutesConverter" />
      <conv:DifficultyToLabelConverter x:Key="DifficultyToLabelConverter" />
      <conv:RelativeDateConverter x:Key="RelativeDateConverter" />

    </ResourceDictionary>
  </Application.Resources>

</Application>
