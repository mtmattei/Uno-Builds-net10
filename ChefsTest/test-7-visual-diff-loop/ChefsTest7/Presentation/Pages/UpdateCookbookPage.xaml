<Page x:Class="ChefsTest7.Presentation.Pages.UpdateCookbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest7.Models"
      xmlns:vm="using:ChefsTest7.Presentation.Pages"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="Update cookbook"
                       Background="{ThemeResource SurfaceInverseBrush}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    <TextBox Grid.Row="1" Header="Cookbook name" Margin="16,12" Text="{x:Bind ViewModel.Name, Mode=TwoWay}"/>
    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{x:Bind ViewModel.AllRecipes, Mode=OneWay}" Padding="16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <utu:AutoLayout Orientation="Horizontal" Spacing="8" Justify="Stack" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecipePickItem">
            <Border Width="140" Height="180" CornerRadius="12" Background="{ThemeResource SurfaceVariantBrush}">
              <Grid>
                <Image Source="{x:Bind Recipe.ImageUrl}" Stretch="UniformToFill"/>
                <Border VerticalAlignment="Bottom" Background="#88000000" Padding="8">
                  <TextBlock Text="{x:Bind Recipe.Name}" Foreground="White" Style="{ThemeResource LabelMedium}" TextTrimming="CharacterEllipsis"/>
                </Border>
                <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                              IsChecked="{x:Bind IsPicked, Mode=TwoWay}"
                              Background="#AAFFFFFF" CornerRadius="14" MinWidth="0" MinHeight="0" Padding="8">
                  <FontIcon Glyph="" Foreground="{ThemeResource PrimaryBrush}" FontSize="14"/>
                </ToggleButton>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Grid Grid.Row="3" Padding="16" Background="{ThemeResource SurfaceBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch" Margin="0,0,8,0"
              Style="{ThemeResource OutlinedButtonStyle}"
              Command="{x:Bind ViewModel.CancelCommand}"/>
      <Button Grid.Column="1" Content="Apply changes" HorizontalAlignment="Stretch" Margin="8,0,0,0"
              Style="{ThemeResource FilledButtonStyle}"
              Command="{x:Bind ViewModel.ApplyCommand}"/>
    </Grid>
  </Grid>
</Page>
