<Page x:Class="ChefsTest7.Presentation.Pages.FavoritesAllPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest7.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="Favorites"
                       Background="{ThemeResource SurfaceInverseBrush}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    <Grid Grid.Row="1" Padding="16,8" Background="{ThemeResource SurfaceBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="All Recipes" HorizontalAlignment="Stretch"
              Style="{ThemeResource FilledButtonStyle}" />
      <Button Grid.Column="1" Content="My Cookbooks" HorizontalAlignment="Stretch" Margin="8,0,0,0"
              Style="{ThemeResource OutlinedButtonStyle}"
              Command="{x:Bind ViewModel.GoToCookbooksCommand}" />
    </Grid>
    <Grid Grid.Row="2">
      <ScrollViewer Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.SavedRecipes, Mode=OneWay}" Padding="16">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <utu:AutoLayout Orientation="Horizontal" Spacing="12" Justify="Stack" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Recipe">
              <Button Padding="0" Background="Transparent" BorderThickness="0" Width="160"
                      Command="{Binding DataContext.OpenRecipeCommand, ElementName=FavRoot}"
                      CommandParameter="{Binding}">
                <Border CornerRadius="12" Background="{ThemeResource SurfaceVariantBrush}">
                  <Grid Height="200">
                    <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                    <Border VerticalAlignment="Bottom" Background="#88000000" Padding="10">
                      <TextBlock Text="{x:Bind Name}" Style="{ThemeResource TitleSmall}" Foreground="White"/>
                    </Border>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Grid x:Name="FavRoot"/>
      <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="❤️" FontSize="64" HorizontalAlignment="Center"/>
        <TextBlock Text="No favorites yet" Style="{ThemeResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Tap the heart icon on a recipe to save it here" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
