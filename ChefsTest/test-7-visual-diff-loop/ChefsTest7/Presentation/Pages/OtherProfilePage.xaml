<Page x:Class="ChefsTest7.Presentation.Pages.OtherProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest7.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="{x:Bind ViewModel.User.FullName, Mode=OneWay, FallbackValue=Profile}"
                       Background="{ThemeResource SurfaceInverseBrush}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    <ScrollViewer Grid.Row="1" x:Name="OtherRoot">
      <StackPanel Spacing="16" Padding="16">
        <Border Width="100" Height="100" CornerRadius="50" HorizontalAlignment="Center" Background="{ThemeResource SurfaceVariantBrush}">
          <Image Source="{x:Bind ViewModel.User.UrlProfileImage, Mode=OneWay, FallbackValue=''}" Stretch="UniformToFill"/>
        </Border>
        <TextBlock Text="{x:Bind ViewModel.User.FullName, Mode=OneWay, FallbackValue=Chef}"
                   Style="{ThemeResource HeadlineSmall}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="{x:Bind ViewModel.User.Description, Mode=OneWay, FallbackValue=''}"
                   Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="0,0,4,0">
            <StackPanel HorizontalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.User.Recipes, Mode=OneWay, FallbackValue=0}" Style="{ThemeResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/><TextBlock Text="Recipes" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center"/></StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="4,0">
            <StackPanel HorizontalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.User.Followers, Mode=OneWay, FallbackValue=0}" Style="{ThemeResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/><TextBlock Text="Followers" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center"/></StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="4,0,0,0">
            <StackPanel HorizontalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.User.Following, Mode=OneWay, FallbackValue=0}" Style="{ThemeResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/><TextBlock Text="Following" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center"/></StackPanel>
          </Border>
        </Grid>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Recipes, Mode=OneWay}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><utu:AutoLayout Orientation="Horizontal" Spacing="12" Justify="Stack" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Recipe">
              <Button Width="160" Height="180" Padding="0" Background="Transparent" BorderThickness="0"
                      Command="{Binding DataContext.OpenRecipeCommand, ElementName=OtherRoot}"
                      CommandParameter="{Binding}">
                <Border CornerRadius="12" Background="{ThemeResource SurfaceVariantBrush}">
                  <Grid>
                    <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                    <Border VerticalAlignment="Bottom" Background="#88000000" Padding="8">
                      <TextBlock Text="{x:Bind Name}" Foreground="White" Style="{ThemeResource LabelMedium}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
