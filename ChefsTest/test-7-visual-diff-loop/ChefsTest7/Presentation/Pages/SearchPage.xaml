<Page x:Class="ChefsTest7.Presentation.Pages.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest7.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="Search"
                       Background="{ThemeResource SurfaceInverseBrush}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    <Grid Grid.Row="1" Padding="16,12,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <AutoSuggestBox Grid.Column="0" PlaceholderText="Search recipes…"
                      QueryIcon="Find" Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />
      <Button Grid.Column="1" Margin="8,0,0,0"
              Background="{ThemeResource PrimaryContainerBrush}"
              Foreground="{ThemeResource OnPrimaryContainerBrush}"
              Command="{x:Bind ViewModel.OpenFiltersCommand}">
        <FontIcon Glyph="" />
      </Button>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Padding="16,4,16,8" Spacing="6">
      <TextBlock Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" Style="{ThemeResource LabelLarge}" Foreground="{ThemeResource OnSurfaceBrush}" />
      <TextBlock Text="recipes found" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
    </StackPanel>

    <Grid Grid.Row="3">
      <ScrollViewer Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" Padding="16,0,16,16">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <utu:AutoLayout Orientation="Vertical" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Recipe">
              <Button Padding="0" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                      Command="{Binding DataContext.OpenRecipeCommand, ElementName=ResultsRoot}"
                      CommandParameter="{Binding}">
                <Border CornerRadius="12" Background="{ThemeResource SurfaceVariantBrush}" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Width="120" Height="100" Background="{ThemeResource SurfaceBrush}">
                      <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="{x:Bind Name}" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceBrush}" />
                      <TextBlock Text="Recipe" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Grid x:Name="ResultsRoot" />
      <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="🔍" FontSize="64" HorizontalAlignment="Center"/>
        <TextBlock Text="No results found" Style="{ThemeResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Try a different keyword or remove filters" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
