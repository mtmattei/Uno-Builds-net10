<Page x:Class="ChefsTest7.Presentation.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest7.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0"
                       Content="Hello, Chef!"
                       Background="{ThemeResource SurfaceInverseBrush}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}">
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Icon="Find" Label="Search" />
        <AppBarButton Label="Bell" Command="{x:Bind ViewModel.OpenNotificationsCommand}">
          <AppBarButton.Icon><FontIcon Glyph="" /></AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="20" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Trending Now" Style="{ThemeResource TitleMedium}"
                     Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Near me 📍"
                  Style="{ThemeResource TextButtonStyle}"
                  Foreground="{ThemeResource PrimaryBrush}"
                  Command="{x:Bind ViewModel.OpenNearMeCommand}" />
        </Grid>

        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Height="220">
          <ItemsControl ItemsSource="{x:Bind ViewModel.TrendingRecipes, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Recipe">
                <Button Width="200" Height="200" Padding="0" Background="Transparent" BorderThickness="0"
                        Command="{Binding DataContext.OpenRecipeCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <Border CornerRadius="12" Background="{ThemeResource SurfaceVariantBrush}">
                    <Grid>
                      <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                      <Border VerticalAlignment="Bottom" Background="#88000000" Padding="12">
                        <StackPanel>
                          <TextBlock Text="{x:Bind Name}" Style="{ThemeResource TitleSmall}" Foreground="White" />
                          <TextBlock Text="Trending recipe" Style="{ThemeResource BodySmall}" Foreground="#DDFFFFFF"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="Categories" Style="{ThemeResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" />
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Category">
                <Border Background="{ThemeResource SecondaryContainerBrush}" CornerRadius="20"
                        Padding="14,10" MinWidth="80">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="{x:Bind UrlIcon}" Width="20" Height="20" />
                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource LabelLarge}"
                               Foreground="{ThemeResource OnSecondaryContainerBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="Recently Added" Style="{ThemeResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" />
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Height="220">
          <ItemsControl ItemsSource="{x:Bind ViewModel.RecentlyAdded, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Recipe">
                <Button Width="160" Height="200" Padding="0" Background="Transparent" BorderThickness="0"
                        Command="{Binding DataContext.OpenRecipeCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <Border CornerRadius="12" Background="{ThemeResource SurfaceVariantBrush}">
                    <Grid>
                      <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                      <Border VerticalAlignment="Bottom" Background="#88000000" Padding="10">
                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource TitleSmall}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="Popular Contributors" Style="{ThemeResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" />
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Height="120" x:Name="Root">
          <ItemsControl ItemsSource="{x:Bind ViewModel.PopularContributors, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:User">
                <Button Padding="0" Background="Transparent" BorderThickness="0"
                        Command="{Binding DataContext.OpenContributorCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <StackPanel HorizontalAlignment="Center" Width="84" Spacing="6">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{ThemeResource SurfaceVariantBrush}">
                      <Image Source="{x:Bind UrlProfileImage}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{x:Bind FullName}" Style="{ThemeResource LabelMedium}"
                               Foreground="{ThemeResource OnSurfaceBrush}"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
