<Page x:Class="ChefsTest7.Presentation.Pages.FiltersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest7.Models"
      Background="{ThemeResource SurfaceBrush}">
  <Grid Padding="16,12,16,16" MaxWidth="520" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Filters" Style="{ThemeResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" />
      <Button Grid.Column="1" Content="✕" Style="{ThemeResource TextButtonStyle}" Command="{x:Bind ViewModel.CloseCommand}"/>
    </Grid>
    <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
      <StackPanel Spacing="20">
        <StackPanel>
          <TextBlock Text="Category" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceBrush}" Margin="0,0,0,8"/>
          <ItemsControl ItemsSource="{x:Bind ViewModel.AllCategories, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <utu:AutoLayout Orientation="Horizontal" Spacing="8" Justify="Stack" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Category">
                <Border Background="{ThemeResource SecondaryContainerBrush}" CornerRadius="20" Padding="12,8">
                  <TextBlock Text="{x:Bind Name}" Style="{ThemeResource LabelMedium}" Foreground="{ThemeResource OnSecondaryContainerBrush}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Cooking Time" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceBrush}" Margin="0,0,0,8"/>
          <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.CookingTimeIndex, Mode=TwoWay, FallbackValue=0}">
            <ComboBoxItem Content="Any" />
            <ComboBoxItem Content="&lt; 15 min" />
            <ComboBoxItem Content="15-30 min" />
            <ComboBoxItem Content="30-60 min" />
            <ComboBoxItem Content="&gt; 1 hr" />
          </ComboBox>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Skill Level" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceBrush}" Margin="0,0,0,8"/>
          <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.SkillLevelIndex, Mode=TwoWay, FallbackValue=0}">
            <ComboBoxItem Content="Any" />
            <ComboBoxItem Content="Easy" />
            <ComboBoxItem Content="Medium" />
            <ComboBoxItem Content="Hard" />
          </ComboBox>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Reset" HorizontalAlignment="Stretch" Margin="0,0,8,0"
              Style="{ThemeResource OutlinedButtonStyle}"
              Command="{x:Bind ViewModel.ResetCommand}" />
      <Button Grid.Column="1" Content="Apply" HorizontalAlignment="Stretch" Margin="8,0,0,0"
              Style="{ThemeResource FilledButtonStyle}"
              Command="{x:Bind ViewModel.ApplyCommand}" />
    </Grid>
  </Grid>
</Page>
