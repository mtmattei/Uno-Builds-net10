<Page x:Class="ChefsTest7.Presentation.Pages.FavoritesCookbooksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest7.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="Favorites"
                       Background="{ThemeResource SurfaceInverseBrush}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    <Grid Grid.Row="1" Padding="16,8" Background="{ThemeResource SurfaceBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="All Recipes" HorizontalAlignment="Stretch"
              Style="{ThemeResource OutlinedButtonStyle}"
              Command="{x:Bind ViewModel.GoToAllCommand}"/>
      <Button Grid.Column="1" Content="My Cookbooks" HorizontalAlignment="Stretch" Margin="8,0,0,0"
              Style="{ThemeResource FilledButtonStyle}" />
    </Grid>
    <Grid Grid.Row="2">
      <ScrollViewer Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.SavedCookbooks, Mode=OneWay}" Padding="16">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <utu:AutoLayout Orientation="Horizontal" Spacing="12" Justify="Stack" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Cookbook">
              <Button Padding="0" Background="Transparent" BorderThickness="0" Width="160"
                      Command="{Binding DataContext.OpenCookbookCommand, ElementName=CbRoot}"
                      CommandParameter="{Binding}">
                <Border CornerRadius="12" Background="{ThemeResource SecondaryContainerBrush}" Height="200">
                  <Grid>
                    <Border VerticalAlignment="Bottom" Background="#33000000" Padding="10">
                      <StackPanel>
                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSecondaryContainerBrush}"/>
                        <TextBlock Text="{x:Bind PinsNumber}" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSecondaryContainerBrush}"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Grid x:Name="CbRoot"/>
      <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="📚" FontSize="64" HorizontalAlignment="Center"/>
        <TextBlock Text="No cookbooks yet" Style="{ThemeResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Group your favorite recipes into cookbooks" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center"/>
      </StackPanel>
      <Button Content="+" Width="56" Height="56" CornerRadius="28"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
              Background="{ThemeResource PrimaryBrush}" Foreground="{ThemeResource OnPrimaryBrush}"
              FontSize="24" Command="{x:Bind ViewModel.CreateCookbookCommand}"/>
    </Grid>
  </Grid>
</Page>
