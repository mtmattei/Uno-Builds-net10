<Page x:Class="ChefsTest7.Presentation.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="Settings"
                       Background="{ThemeResource SurfaceInverseBrush}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="20" Padding="16">
        <TextBlock Text="Personal Information" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
        <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12">
          <StackPanel Spacing="12">
            <TextBox Header="Name" Text="{x:Bind ViewModel.FullName, Mode=TwoWay}"/>
            <TextBox Header="Email" InputScope="EmailNameOrAddress" Text="{x:Bind ViewModel.Email, Mode=TwoWay}"/>
            <TextBox Header="Mobile Number" InputScope="TelephoneNumber" Text="{x:Bind ViewModel.MobileNumber, Mode=TwoWay}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="Application Settings" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
        <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12">
          <StackPanel Spacing="6">
            <Grid Padding="0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Notifications" Style="{ThemeResource BodyLarge}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" OffContent="" OnContent=""/>
            </Grid>
            <Grid Padding="0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Night Mode" Style="{ThemeResource BodyLarge}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.NightModeEnabled, Mode=TwoWay}" OffContent="" OnContent=""/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Padding="16" Spacing="8" Background="{ThemeResource SurfaceBrush}">
      <Button Content="Save Changes" HorizontalAlignment="Stretch" Style="{ThemeResource FilledButtonStyle}" Command="{x:Bind ViewModel.SaveChangesCommand}"/>
      <Button Content="Log out" HorizontalAlignment="Stretch" Style="{ThemeResource OutlinedButtonStyle}" Foreground="{ThemeResource ErrorBrush}" Command="{x:Bind ViewModel.LogOutCommand}"/>
    </StackPanel>
  </Grid>
</Page>
