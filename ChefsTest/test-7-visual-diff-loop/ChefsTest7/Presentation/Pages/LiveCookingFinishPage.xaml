<Page x:Class="ChefsTest7.Presentation.Pages.LiveCookingFinishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource BackgroundBrush}">
  <Grid Padding="40">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
      <Border Width="180" Height="180" CornerRadius="90" Background="{ThemeResource PrimaryContainerBrush}">
        <TextBlock Text="🎉" FontSize="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="Hurray!" Style="{ThemeResource HeadlineMedium}" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center"/>
      <TextBlock Text="You finished cooking. How was it?" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <TextBlock Text="⭐" FontSize="32"/>
        <TextBlock Text="⭐" FontSize="32"/>
        <TextBlock Text="⭐" FontSize="32"/>
        <TextBlock Text="⭐" FontSize="32"/>
        <TextBlock Text="⭐" FontSize="32"/>
      </StackPanel>
      <Button Content="Done" HorizontalAlignment="Stretch"
              Style="{ThemeResource FilledButtonStyle}"
              Command="{x:Bind ViewModel.DoneCommand}" MinWidth="200"/>
      <Button Content="Previous" HorizontalAlignment="Center"
              Style="{ThemeResource TextButtonStyle}"
              Command="{x:Bind ViewModel.GoBackCommand}"/>
    </StackPanel>
  </Grid>
</Page>
