<Page x:Class="ChefsTest7.Presentation.Pages.RecipeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest7.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="{x:Bind ViewModel.Recipe.Name, Mode=OneWay, FallbackValue=Recipe}"
                       Background="{ThemeResource SurfaceInverseBrush}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}">
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Command="{x:Bind ViewModel.ToggleFavoriteCommand}">
          <AppBarButton.Icon>
            <FontIcon Glyph="{x:Bind ViewModel.IsFavorite, Mode=OneWay, Converter={StaticResource BoolToFavoriteGlyphConverter}}" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16">
        <Border Height="240" Background="{ThemeResource SurfaceVariantBrush}">
          <Image Source="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Stretch="UniformToFill"/>
        </Border>
        <StackPanel Padding="16,0,16,0" Spacing="12">
          <TextBlock Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay, FallbackValue=Recipe}"
                     Style="{ThemeResource HeadlineSmall}" Foreground="{ThemeResource OnSurfaceBrush}" />
          <Grid x:Name="AuthorRow">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SurfaceVariantBrush}">
              <Image Source="{x:Bind ViewModel.Author.UrlProfileImage, Mode=OneWay, FallbackValue=''}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind ViewModel.Author.FullName, Mode=OneWay, FallbackValue=Chef}" Style="{ThemeResource LabelLarge}" Foreground="{ThemeResource OnSurfaceBrush}"/>
              <TextBlock Text="{x:Bind ViewModel.Author.Description, Mode=OneWay, FallbackValue=''}" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="0,0,4,0">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="⏱️" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.Recipe.CookTime.ticks, Mode=OneWay, Converter={StaticResource TicksToMinutesConverter}, FallbackValue=- min}" Style="{ThemeResource LabelMedium}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Time" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="4,0">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🍽️" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.Recipe.Serves, Mode=OneWay, FallbackValue=-}" Style="{ThemeResource LabelMedium}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Serves" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="4,0,0,0">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.Recipe.Difficulty, Mode=OneWay, Converter={StaticResource DifficultyToLabelConverter}, FallbackValue=Easy}" Style="{ThemeResource LabelMedium}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Level" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
          <Pivot SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}">
            <PivotItem Header="Ingredients">
              <ItemsControl ItemsSource="{x:Bind ViewModel.Ingredients, Mode=OneWay}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:Ingredient">
                    <Grid Padding="0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Image Grid.Column="0" Source="{x:Bind UrlIcon}" Width="32" Height="32"/>
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" Margin="12,0,0,0" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceBrush}"/>
                      <TextBlock Grid.Column="2" Text="{x:Bind Quantity}" VerticalAlignment="Center" Style="{ThemeResource LabelMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </PivotItem>
            <PivotItem Header="Steps">
              <ItemsControl ItemsSource="{x:Bind ViewModel.Steps, Mode=OneWay}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:RecipeStep">
                    <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                      <StackPanel Spacing="6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Background="{ThemeResource PrimaryBrush}" CornerRadius="14" Width="28" Height="28" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Number}" Foreground="{ThemeResource OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource LabelMedium}"/>
                          </Border>
                          <TextBlock Grid.Column="1" Text="{x:Bind Name}" Margin="10,0,0,0" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceBrush}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </PivotItem>
            <PivotItem Header="Reviews">
              <Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Reviews, Mode=OneWay}" Margin="0,12,0,0"
                              Visibility="{x:Bind ViewModel.HasReviews, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Review">
                      <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{x:Bind Rating}" Style="{ThemeResource LabelMedium}" Foreground="{ThemeResource OnSurfaceBrush}"/>
                          <TextBlock Text="{x:Bind Comment}" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{x:Bind ViewModel.HasReviews, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="0,40,0,0">
                  <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center"/>
                  <TextBlock Text="No reviews yet" Style="{ThemeResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Be the first to leave a review" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </PivotItem>
            <PivotItem Header="Nutrition">
              <StackPanel Margin="0,12,0,0" Spacing="12">
                <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Calories" Style="{ThemeResource LabelLarge}" Foreground="{ThemeResource OnSurfaceBrush}"/>
                    <TextBlock Text="320 kcal" Style="{ThemeResource HeadlineSmall}" Foreground="{ThemeResource PrimaryBrush}"/>
                  </StackPanel>
                </Border>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="0,0,4,0">
                    <StackPanel><TextBlock Text="Protein" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/><TextBlock Text="18 g" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceBrush}"/></StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="4,0">
                    <StackPanel><TextBlock Text="Carbs" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/><TextBlock Text="32 g" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceBrush}"/></StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="12" Margin="4,0,0,0">
                    <StackPanel><TextBlock Text="Fat" Style="{ThemeResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/><TextBlock Text="14 g" Style="{ThemeResource TitleSmall}" Foreground="{ThemeResource OnSurfaceBrush}"/></StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </PivotItem>
          </Pivot>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{ThemeResource SurfaceBrush}" Padding="16">
      <Button Content="Start Cooking!" HorizontalAlignment="Stretch"
              Style="{ThemeResource FilledButtonStyle}"
              Command="{x:Bind ViewModel.StartCookingCommand}" />
    </Border>
  </Grid>
</Page>
