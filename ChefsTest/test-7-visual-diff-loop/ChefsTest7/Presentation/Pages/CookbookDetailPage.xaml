<Page x:Class="ChefsTest7.Presentation.Pages.CookbookDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest7.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="{x:Bind ViewModel.Cookbook.Name, Mode=OneWay, FallbackValue=Cookbook}"
                       Background="{ThemeResource SurfaceInverseBrush}"
                       Foreground="{ThemeResource OnSurfaceInverseBrush}" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Padding="16,8" Spacing="6">
      <TextBlock Text="{x:Bind ViewModel.RecipeCount, Mode=OneWay}" Style="{ThemeResource LabelLarge}" Foreground="{ThemeResource OnSurfaceBrush}"/>
      <TextBlock Text="recipes" Style="{ThemeResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <ScrollViewer x:Name="CookbookRoot">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Recipes, Mode=OneWay}" Padding="16">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <utu:AutoLayout Orientation="Horizontal" Spacing="12" Justify="Stack" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Recipe">
              <Button Padding="0" Width="160" Background="Transparent" BorderThickness="0"
                      Command="{Binding DataContext.OpenRecipeCommand, ElementName=CookbookRoot}"
                      CommandParameter="{Binding}">
                <Border CornerRadius="12" Background="{ThemeResource SurfaceVariantBrush}" Height="200">
                  <Grid>
                    <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                    <Border VerticalAlignment="Bottom" Background="#88000000" Padding="10">
                      <TextBlock Text="{x:Bind Name}" Foreground="White" Style="{ThemeResource TitleSmall}"/>
                    </Border>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button Content="✎" Width="56" Height="56" CornerRadius="28"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
              Background="{ThemeResource PrimaryBrush}" Foreground="{ThemeResource OnPrimaryBrush}"
              FontSize="20" Command="{x:Bind ViewModel.EditCookbookCommand}"/>
    </Grid>
  </Grid>
</Page>
