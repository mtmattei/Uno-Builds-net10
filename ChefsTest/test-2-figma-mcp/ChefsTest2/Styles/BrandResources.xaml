<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ChefsTest2.Presentation">

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
  <conv:CountToVisibilityConverter x:Key="HasItemsToVisibility" />
  <conv:CountToVisibilityConverter x:Key="EmptyToVisibility" ShowWhenZero="True" />
  <conv:TimeSpanToMinutesConverter x:Key="TimeSpanToMinutes" />
  <conv:DifficultyToTextConverter x:Key="DifficultyToText" />
  <conv:HexToBrushConverter x:Key="HexToBrush" />
  <conv:RelativeDateConverter x:Key="RelativeDate" />

  <x:Double x:Key="ChefsRadius">12</x:Double>
  <x:Double x:Key="ChefsCardRadius">16</x:Double>

  <!-- Type-scale derived from Figma UNO Semantic tokens (Roboto). Each entry omits
       FontFamily so it inherits from MaterialMediumFontFamily etc. -->
  <Style x:Key="ChefsTitleLarge" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="ChefsTitleMedium" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="ChefsTitleSmall" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="ChefsBodyLarge" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="ChefsBodySmall" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="ChefsLabelLarge" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
</ResourceDictionary>
