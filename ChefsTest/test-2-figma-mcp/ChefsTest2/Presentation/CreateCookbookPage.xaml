<Page x:Class="ChefsTest2.Presentation.CreateCookbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest2.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource SurfaceBrush}"
      NavigationCacheMode="Required">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Grid.Row="0" Content="Create Cookbook" />

    <StackPanel Grid.Row="1" Padding="20,12" Spacing="10">
      <TextBox PlaceholderText="Cookbook name"
               Text="{x:Bind ViewModel.Name, Mode=TwoWay}"
               AutomationProperties.AutomationId="CreateCookbookName" />
      <TextBlock Text="Choose recipes to add" Style="{StaticResource ChefsTitleSmall}"
                 Foreground="{ThemeResource OnSurfaceBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.AvailableRecipes, Mode=OneWay}"
                     Margin="20,0,20,16">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinItemWidth="160" MinItemHeight="200"
                             MinRowSpacing="12" MinColumnSpacing="12" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="m:Recipe">
            <Button Background="Transparent" BorderThickness="0" Padding="0"
                    Click="OnToggleClick" Tag="{x:Bind}">
              <Border CornerRadius="12" Background="{ThemeResource SurfaceBrush}">
                <Grid>
                  <StackPanel>
                    <Image Source="{x:Bind ImageUrl}" Height="120" Stretch="UniformToFill" />
                    <TextBlock Text="{x:Bind Name}" Padding="12,8" FontWeight="Medium"
                               Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="8" Width="32" Height="32" CornerRadius="16"
                          Background="{ThemeResource SurfaceVariantBrush}">
                    <FontIcon Glyph="&#xEB52;" FontSize="14" />
                  </Border>
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </ScrollViewer>

    <Grid Grid.Row="3" Padding="20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Stretch"
              Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
      <Button Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch"
              Content="Create cookbook"
              Background="{ThemeResource PrimaryBrush}"
              Foreground="{ThemeResource OnPrimaryBrush}"
              Command="{x:Bind ViewModel.CreateCommand}"
              AutomationProperties.AutomationId="CreateCookbookSubmit" />
    </Grid>
  </Grid>
</Page>
