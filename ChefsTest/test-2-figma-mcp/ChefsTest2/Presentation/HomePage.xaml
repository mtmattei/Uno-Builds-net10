<Page x:Class="ChefsTest2.Presentation.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest2.Models"
      xmlns:local="using:ChefsTest2.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}"
      NavigationCacheMode="Required">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="20,16,20,8" Background="{ThemeResource SurfaceBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource ChefsTitleMedium}"
                   Foreground="{ThemeResource OnSurfaceBrush}" />
        <TextBlock Text="What are we cooking today?" Style="{StaticResource ChefsBodySmall}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      </StackPanel>
      <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
              Command="{x:Bind ViewModel.OpenNotificationsCommand}"
              AutomationProperties.AutomationId="HomeBellButton">
        <FontIcon Glyph="&#xEA8F;" FontSize="20" Foreground="{ThemeResource OnSurfaceBrush}" />
      </Button>
      <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
              Command="{x:Bind ViewModel.OpenProfileCommand}"
              AutomationProperties.AutomationId="HomeAvatarButton">
        <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="{ThemeResource OnSurfaceBrush}" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="20" Padding="0,12,0,16">

        <StackPanel Spacing="10" Padding="20,0,20,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource ChefsTitleMedium}" Text="Trending Now"
                       Foreground="{ThemeResource OnBackgroundBrush}" />
            <Button Grid.Column="1" Content="Near me" Background="Transparent"
                    Foreground="{ThemeResource PrimaryBrush}"
                    Command="{x:Bind ViewModel.OpenNearMeCommand}"
                    AutomationProperties.AutomationId="HomeNearMeLink" />
          </Grid>
        </StackPanel>

        <ListView ItemsSource="{x:Bind ViewModel.Trending, Mode=OneWay}"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  SelectionMode="None"
                  Padding="20,0,20,0">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,12,0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="m:Recipe">
              <Button Background="Transparent" BorderThickness="0" Padding="0"
                      Click="OnTrendingClick" Tag="{x:Bind}"
                      AutomationProperties.AutomationId="HomeTrendingCard">
                <Border CornerRadius="16" Width="280" Height="200"
                        Background="{ThemeResource SurfaceVariantBrush}">
                  <Grid>
                    <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                    <Border VerticalAlignment="Bottom" Padding="16,12"
                            Background="#88000000">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Creator.FullName}" FontSize="12"
                                   Foreground="#DDDDDD" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <TextBlock Style="{StaticResource ChefsTitleMedium}" Text="Categories"
                   Padding="20,8,20,0" Foreground="{ThemeResource OnBackgroundBrush}" />

        <ListView ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  SelectionMode="None"
                  Padding="20,0,20,0">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="m:Category">
              <Button Background="Transparent" BorderThickness="0" Padding="0"
                      Click="OnCategoryClick" Tag="{x:Bind}"
                      AutomationProperties.AutomationId="HomeCategoryChip">
                <Border CornerRadius="20" Padding="16,8"
                        Background="{x:Bind Color, Converter={StaticResource HexToBrush}}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="{x:Bind UrlIcon}" Width="20" Height="20" />
                    <TextBlock Text="{x:Bind Name}" Foreground="White" FontWeight="Medium" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <TextBlock Style="{StaticResource ChefsTitleMedium}" Text="Recently Added"
                   Padding="20,8,20,0" Foreground="{ThemeResource OnBackgroundBrush}" />

        <ListView ItemsSource="{x:Bind ViewModel.RecentlyAdded, Mode=OneWay}"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  SelectionMode="None"
                  Padding="20,0,20,0">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="m:Recipe">
              <Button Background="Transparent" BorderThickness="0" Padding="0"
                      Click="OnTrendingClick" Tag="{x:Bind}"
                      AutomationProperties.AutomationId="HomeRecentCard">
                <Border CornerRadius="12" Width="160"
                        Background="{ThemeResource SurfaceBrush}">
                  <StackPanel>
                    <Image Source="{x:Bind ImageUrl}" Width="160" Height="120" Stretch="UniformToFill" />
                    <StackPanel Padding="12,8" Spacing="4">
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                 Foreground="{ThemeResource OnSurfaceBrush}"
                                 TextWrapping="Wrap" MaxLines="2" />
                      <TextBlock Text="{x:Bind Category.Name}" FontSize="12"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <TextBlock Style="{StaticResource ChefsTitleMedium}" Text="Popular Contributors"
                   Padding="20,8,20,0" Foreground="{ThemeResource OnBackgroundBrush}" />

        <ListView ItemsSource="{x:Bind ViewModel.Contributors, Mode=OneWay}"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  SelectionMode="None"
                  Padding="20,0,20,16">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="m:User">
              <Button Background="Transparent" BorderThickness="0" Padding="0"
                      Click="OnContributorClick" Tag="{x:Bind}"
                      AutomationProperties.AutomationId="HomeContributorPill">
                <StackPanel Spacing="6" Width="80" HorizontalAlignment="Center">
                  <Border Width="64" Height="64" CornerRadius="32"
                          Background="{ThemeResource SurfaceVariantBrush}">
                    <Image Source="{x:Bind UrlProfileImage}" Stretch="UniformToFill" />
                  </Border>
                  <TextBlock Text="{x:Bind FullName}" FontSize="12" FontWeight="Medium"
                             Foreground="{ThemeResource OnBackgroundBrush}"
                             TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

      </StackPanel>
    </ScrollViewer>

    <local:BottomNavBar Grid.Row="2" ActiveTab="Home" />
  </Grid>
</Page>
