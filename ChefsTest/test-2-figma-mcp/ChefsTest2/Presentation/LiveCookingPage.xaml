<Page x:Class="ChefsTest2.Presentation.LiveCookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}"
      NavigationCacheMode="Required">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Grid.Row="0" Content="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}" />

    <Grid Grid.Row="1" Height="200" Background="Black">
      <Image Source="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.7" />
      <FontIcon Glyph="&#xE768;" FontSize="64" Foreground="White"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Border VerticalAlignment="Bottom" Padding="16,8"
              Background="#88000000">
        <ProgressBar Value="40" Maximum="100" Foreground="{ThemeResource PrimaryBrush}"
                     Background="#33FFFFFF" />
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="2" Padding="20,16,20,16">
      <StackPanel Spacing="14">
        <Border CornerRadius="14" Padding="16"
                Background="{ThemeResource SurfaceBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.CurrentStep.Name, Mode=OneWay}"
                       Style="{StaticResource ChefsTitleMedium}"
                       Foreground="{ThemeResource OnSurfaceBrush}" />
            <TextBlock Text="{x:Bind ViewModel.CurrentStep.Description, Mode=OneWay}"
                       Style="{StaticResource ChefsBodyLarge}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border CornerRadius="14" Padding="16"
                Background="{ThemeResource SurfaceBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="Ingredients" Style="{StaticResource ChefsTitleSmall}"
                       Foreground="{ThemeResource OnSurfaceVariantBrush}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentStep.Ingredients, Mode=OneWay}">
              <ItemsRepeater.Layout>
                <StackLayout Spacing="6" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding}" />
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
        </Border>

        <PipsPager NumberOfPages="{x:Bind ViewModel.TotalSteps, Mode=OneWay}"
                   SelectedPageIndex="{x:Bind ViewModel.CurrentStepIndex, Mode=TwoWay}"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="3" Padding="20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Stretch"
              Content="Previous" Command="{x:Bind ViewModel.PreviousCommand}"
              AutomationProperties.AutomationId="LiveCookingPrev" />
      <Button Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch"
              Content="Next"
              Background="{ThemeResource PrimaryBrush}"
              Foreground="{ThemeResource OnPrimaryBrush}"
              Command="{x:Bind ViewModel.NextCommand}"
              AutomationProperties.AutomationId="LiveCookingNext" />
    </Grid>
  </Grid>
</Page>
