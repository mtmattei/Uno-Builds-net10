<Page x:Class="ChefsTest2.Presentation.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest2.Models"
      xmlns:local="using:ChefsTest2.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}"
      NavigationCacheMode="Required">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="20,16,20,8" Background="{ThemeResource SurfaceBrush}">
      <TextBlock Text="My Favorites" Style="{StaticResource ChefsTitleLarge}"
                 Foreground="{ThemeResource OnSurfaceBrush}" />
    </Grid>

    <utu:TabBar Grid.Row="1" Style="{StaticResource ColoredTopTabBarStyle}"
                Padding="20,0,20,8"
                SelectedIndex="{x:Bind ViewModel.SelectedSegment, Mode=TwoWay}"
                AutomationProperties.AutomationId="FavoritesSegments">
      <utu:TabBarItem Content="All Recipes" />
      <utu:TabBarItem Content="My Cookbooks" />
    </utu:TabBar>

    <Grid Grid.Row="2">
      <!-- All Recipes -->
      <Grid Visibility="{x:Bind ViewModel.SelectedSegment, Mode=OneWay, Converter={StaticResource EmptyToVisibility}}">
        <Grid Visibility="{x:Bind ViewModel.Recipes.Count, Mode=OneWay, Converter={StaticResource EmptyToVisibility}}"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              AutomationProperties.AutomationId="FavoritesRecipesEmpty">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE006;" FontSize="64" Foreground="{ThemeResource OutlineBrush}" />
            <TextBlock Text="No favorites yet" Style="{StaticResource ChefsTitleMedium}"
                       TextAlignment="Center" Foreground="{ThemeResource OnBackgroundBrush}" />
          </StackPanel>
        </Grid>
        <ScrollViewer Visibility="{x:Bind ViewModel.Recipes.Count, Mode=OneWay, Converter={StaticResource HasItemsToVisibility}}">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recipes, Mode=OneWay}" Margin="20,12,20,0">
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="160" MinItemHeight="220"
                                 MinRowSpacing="12" MinColumnSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="m:Recipe">
                <Button Background="Transparent" BorderThickness="0" Padding="0"
                        Click="OnRecipeClick" Tag="{x:Bind}"
                        AutomationProperties.AutomationId="FavoriteRecipeCard">
                  <Border CornerRadius="12" Background="{ThemeResource SurfaceBrush}">
                    <StackPanel>
                      <Image Source="{x:Bind ImageUrl}" Height="120" Stretch="UniformToFill" />
                      <StackPanel Padding="12,8" Spacing="4">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource OnSurfaceBrush}"
                                   TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock Text="{x:Bind Category.Name}" FontSize="12"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
      </Grid>
      <!-- Cookbooks -->
      <Grid Visibility="{x:Bind ViewModel.SelectedSegment, Mode=OneWay, Converter={StaticResource HasItemsToVisibility}}">
        <Grid Visibility="{x:Bind ViewModel.Cookbooks.Count, Mode=OneWay, Converter={StaticResource EmptyToVisibility}}"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              AutomationProperties.AutomationId="FavoritesCookbooksEmpty">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE82D;" FontSize="64" Foreground="{ThemeResource OutlineBrush}" />
            <TextBlock Text="No cookbooks yet" Style="{StaticResource ChefsTitleMedium}"
                       TextAlignment="Center" Foreground="{ThemeResource OnBackgroundBrush}" />
          </StackPanel>
        </Grid>
        <Grid Visibility="{x:Bind ViewModel.Cookbooks.Count, Mode=OneWay, Converter={StaticResource HasItemsToVisibility}}">
          <ScrollViewer>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cookbooks, Mode=OneWay}" Margin="20,12,20,0">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="160" MinItemHeight="180"
                                   MinRowSpacing="12" MinColumnSpacing="12" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="m:Cookbook">
                  <Button Background="Transparent" BorderThickness="0" Padding="0"
                          Click="OnCookbookClick" Tag="{x:Bind}"
                          AutomationProperties.AutomationId="FavoriteCookbookCard">
                    <Border CornerRadius="12" Background="{ThemeResource PrimaryContainerBrush}"
                            Padding="14">
                      <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE82D;" FontSize="32"
                                  Foreground="{ThemeResource OnPrimaryContainerBrush}"
                                  HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource OnPrimaryContainerBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="12"
                                   Foreground="{ThemeResource OnPrimaryContainerBrush}">
                          <Run Text="{x:Bind Recipes.Count}" />
                          <Run Text=" recipes" />
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </ScrollViewer>
          <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,20,20" Width="56" Height="56" CornerRadius="28"
                  Background="{ThemeResource PrimaryBrush}"
                  Foreground="{ThemeResource OnPrimaryBrush}"
                  Command="{x:Bind ViewModel.CreateCookbookCommand}"
                  AutomationProperties.AutomationId="FavoritesCreateCookbookFab">
            <FontIcon Glyph="&#xE710;" FontSize="20" />
          </Button>
        </Grid>
      </Grid>
    </Grid>

    <local:BottomNavBar Grid.Row="3" ActiveTab="Favorites" />
  </Grid>
</Page>
