<Page x:Class="ChefsTest2.Presentation.NearMeMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest2.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}"
      NavigationCacheMode="Required">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Grid.Row="0" Content="Chefs near me" />

    <Grid Grid.Row="1">
      <Border Background="{ThemeResource SurfaceVariantBrush}" />
      <Grid Margin="40">
        <Image Source="ms-appx:///Assets/Maps/location_pin.svg" Width="40" Height="40"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,40,0,0" />
        <Image Source="ms-appx:///Assets/Maps/location_pin.svg" Width="40" Height="40"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" />
        <Image Source="ms-appx:///Assets/Maps/location_pin.svg" Width="40" Height="40"
               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,80,0" />
        <Image Source="ms-appx:///Assets/Maps/location_circle.svg" Width="60" Height="60"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>

      <ScrollViewer HorizontalScrollMode="Enabled"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollMode="Disabled"
                    VerticalAlignment="Bottom" Margin="0,0,0,80"
                    Padding="20,0">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pins, Mode=OneWay}">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Horizontal" Spacing="12" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="m:User">
              <Border Width="240" CornerRadius="14" Padding="14"
                      Background="{ThemeResource SurfaceBrush}">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{ThemeResource SurfaceVariantBrush}">
                      <Image Source="{x:Bind UrlProfileImage}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind FullName}" FontWeight="SemiBold"
                                 Foreground="{ThemeResource OnSurfaceBrush}" />
                      <TextBlock Text="{x:Bind Description}" FontSize="12"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,20,20" Width="56" Height="56" CornerRadius="28"
              Background="{ThemeResource PrimaryBrush}"
              Foreground="{ThemeResource OnPrimaryBrush}"
              AutomationProperties.AutomationId="NearMeMapFab">
        <FontIcon Glyph="&#xE81D;" FontSize="20" />
      </Button>
    </Grid>
  </Grid>
</Page>
