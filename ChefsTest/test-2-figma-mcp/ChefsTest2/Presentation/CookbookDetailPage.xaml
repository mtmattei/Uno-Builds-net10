<Page x:Class="ChefsTest2.Presentation.CookbookDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest2.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}"
      NavigationCacheMode="Required">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Grid.Row="0" Content="{x:Bind ViewModel.Cookbook.Name, Mode=OneWay}">
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Icon="Edit" Label="Edit"
                      Command="{x:Bind ViewModel.EditCommand}" />
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <TextBlock Grid.Row="1" Padding="20,8" Foreground="{ThemeResource OnBackgroundBrush}"
               Style="{StaticResource ChefsBodySmall}">
      <Run Text="{x:Bind ViewModel.Cookbook.Recipes.Count, Mode=OneWay}" />
      <Run Text=" recipes" />
    </TextBlock>

    <Grid Grid.Row="2">
      <ScrollViewer>
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cookbook.Recipes, Mode=OneWay}"
                       Margin="20,0,20,16">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="160" MinItemHeight="220"
                               MinRowSpacing="12" MinColumnSpacing="12" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="m:Recipe">
              <Button Background="Transparent" BorderThickness="0" Padding="0"
                      Click="OnRecipeClick" Tag="{x:Bind}">
                <Border CornerRadius="12" Background="{ThemeResource SurfaceBrush}">
                  <StackPanel>
                    <Image Source="{x:Bind ImageUrl}" Height="120" Stretch="UniformToFill" />
                    <StackPanel Padding="12,8" Spacing="4">
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                 Foreground="{ThemeResource OnSurfaceBrush}"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind Category.Name}" FontSize="12"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>
      <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,20,20" Width="56" Height="56" CornerRadius="28"
              Background="{ThemeResource PrimaryBrush}"
              Foreground="{ThemeResource OnPrimaryBrush}"
              Command="{x:Bind ViewModel.AddRecipeCommand}"
              AutomationProperties.AutomationId="CookbookDetailFab">
        <FontIcon Glyph="&#xE710;" FontSize="20" />
      </Button>
    </Grid>
  </Grid>
</Page>
