<Page x:Class="ChefsTest2.Presentation.RecipeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest2.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}"
      NavigationCacheMode="Required">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Grid.Row="0" Content="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}">
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Icon="Favorite" Label="Save"
                      Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                      AutomationProperties.AutomationId="RecipeDetailFavorite" />
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16">
        <Grid Height="240">
          <Image Source="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Stretch="UniformToFill" />
        </Grid>

        <StackPanel Padding="20,0,20,0" Spacing="6">
          <TextBlock Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}" Style="{StaticResource ChefsTitleLarge}"
                     Foreground="{ThemeResource OnBackgroundBrush}" TextWrapping="Wrap" />
          <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                  Padding="0" Command="{x:Bind ViewModel.ShowAuthorCommand}"
                  AutomationProperties.AutomationId="RecipeDetailAuthor">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="32" Height="32" CornerRadius="16"
                      Background="{ThemeResource SurfaceVariantBrush}">
                <Image Source="{x:Bind ViewModel.Recipe.Creator.UrlProfileImage, Mode=OneWay}" Stretch="UniformToFill" />
              </Border>
              <TextBlock Text="{x:Bind ViewModel.Recipe.Creator.FullName, Mode=OneWay}"
                         Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Grid Padding="20,0,20,0" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="12" Padding="12"
                  Background="{ThemeResource SurfaceBrush}">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="Time" FontSize="12"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <TextBlock Text="{x:Bind ViewModel.Recipe.CookTime, Mode=OneWay, Converter={StaticResource TimeSpanToMinutes}}"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource OnSurfaceBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" CornerRadius="12" Padding="12"
                  Background="{ThemeResource SurfaceBrush}">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="Serves" FontSize="12"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <TextBlock Text="{x:Bind ViewModel.Recipe.Serves, Mode=OneWay}"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource OnSurfaceBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" CornerRadius="12" Padding="12"
                  Background="{ThemeResource SurfaceBrush}">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="Difficulty" FontSize="12"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <TextBlock Text="{x:Bind ViewModel.Recipe.Difficulty, Mode=OneWay, Converter={StaticResource DifficultyToText}}"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource OnSurfaceBrush}" />
            </StackPanel>
          </Border>
        </Grid>

        <Pivot Padding="20,0" SelectedIndex="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
               AutomationProperties.AutomationId="RecipeDetailTabs">
          <PivotItem Header="Ingredients">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recipe.Ingredients, Mode=OneWay}">
              <ItemsRepeater.Layout>
                <StackLayout Spacing="8" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="m:Ingredient">
                  <Border CornerRadius="12" Padding="12,8"
                          Background="{ThemeResource SurfaceBrush}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Image Grid.Column="0" Source="{x:Bind UrlIcon}" Width="36" Height="36"
                             Margin="0,0,12,0" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                                 Foreground="{ThemeResource OnSurfaceBrush}" />
                      <TextBlock Grid.Column="2" Text="{x:Bind Quantity}" VerticalAlignment="Center"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </PivotItem>

          <PivotItem Header="Steps">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recipe.Steps, Mode=OneWay}">
              <ItemsRepeater.Layout>
                <StackLayout Spacing="12" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="m:Step">
                  <Border CornerRadius="12" Padding="14"
                          Background="{ThemeResource SurfaceBrush}">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="14" Width="28" Height="28"
                                Background="{ThemeResource PrimaryBrush}">
                          <TextBlock Text="{x:Bind Number}" Foreground="{ThemeResource OnPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource OnSurfaceBrush}" />
                      </StackPanel>
                      <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </PivotItem>

          <PivotItem Header="Reviews">
            <Grid>
              <TextBlock Text="No reviews yet."
                         Visibility="{x:Bind ViewModel.HasReviews, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}"
                         HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="0,32,0,0"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              <ItemsRepeater Visibility="{x:Bind ViewModel.HasReviews, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                             ItemsSource="{x:Bind ViewModel.Recipe.Reviews, Mode=OneWay}">
                <ItemsRepeater.Layout>
                  <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="m:Review">
                    <Border CornerRadius="12" Padding="12"
                            Background="{ThemeResource SurfaceBrush}">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{x:Bind UserName}" FontWeight="SemiBold"
                                     Foreground="{ThemeResource OnSurfaceBrush}" />
                          <TextBlock Text="{x:Bind Stars}" Foreground="{ThemeResource PrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Comment}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </Grid>
          </PivotItem>

          <PivotItem Header="Nutrition">
            <StackPanel Spacing="12" Padding="0,16,0,0">
              <Border CornerRadius="12" Padding="14"
                      Background="{ThemeResource SurfaceBrush}">
                <StackPanel Spacing="4">
                  <TextBlock Text="Calories" Style="{StaticResource ChefsTitleSmall}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{x:Bind ViewModel.Recipe.Calories, Mode=OneWay}"
                             Style="{StaticResource ChefsTitleLarge}"
                             Foreground="{ThemeResource OnSurfaceBrush}" />
                </StackPanel>
              </Border>
              <TextBlock Text="{x:Bind ViewModel.Recipe.Details, Mode=OneWay}" TextWrapping="Wrap"
                         Padding="4,0" Foreground="{ThemeResource OnBackgroundBrush}" />
            </StackPanel>
          </PivotItem>
        </Pivot>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="20,12"
            Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource OutlineVariantBrush}"
            BorderThickness="0,1,0,0">
      <Button HorizontalAlignment="Stretch" Padding="0,16" Content="Start Cooking!"
              Background="{ThemeResource PrimaryBrush}"
              Foreground="{ThemeResource OnPrimaryBrush}"
              Command="{x:Bind ViewModel.StartCookingCommand}"
              AutomationProperties.AutomationId="RecipeDetailStartCooking" />
    </Border>
  </Grid>
</Page>
