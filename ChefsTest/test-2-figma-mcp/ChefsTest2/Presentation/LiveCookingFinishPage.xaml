<Page x:Class="ChefsTest2.Presentation.LiveCookingFinishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource SurfaceBrush}"
      NavigationCacheMode="Required">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Grid.Row="0" Content="Done!" />

    <StackPanel Grid.Row="1" Spacing="20" Padding="32" HorizontalAlignment="Center"
                VerticalAlignment="Center" MaxWidth="500">
      <FontIcon Glyph="&#xE73E;" FontSize="96"
                Foreground="{ThemeResource PrimaryBrush}"
                HorizontalAlignment="Center" />
      <TextBlock Text="Hurray!" Style="{StaticResource ChefsTitleLarge}"
                 HorizontalAlignment="Center"
                 Foreground="{ThemeResource OnSurfaceBrush}" />
      <TextBlock Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}"
                 Style="{StaticResource ChefsBodyLarge}"
                 HorizontalAlignment="Center"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      <TextBlock Text="Rate this recipe" Style="{StaticResource ChefsTitleSmall}"
                 HorizontalAlignment="Center"
                 Foreground="{ThemeResource OnSurfaceBrush}" Margin="0,12,0,0" />
      <RatingControl Value="{x:Bind ViewModel.Rating, Mode=TwoWay}" MaxRating="5"
                     HorizontalAlignment="Center"
                     AutomationProperties.AutomationId="LiveCookingFinishRating" />
    </StackPanel>

    <Grid Grid.Row="2" Padding="20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Stretch"
              Content="Favorite" Command="{x:Bind ViewModel.ToggleFavoriteCommand}" />
      <Button Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Stretch"
              Content="Done"
              Background="{ThemeResource PrimaryBrush}"
              Foreground="{ThemeResource OnPrimaryBrush}"
              Command="{x:Bind ViewModel.DoneCommand}" />
    </Grid>
  </Grid>
</Page>
