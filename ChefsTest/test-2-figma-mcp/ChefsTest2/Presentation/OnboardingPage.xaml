<Page x:Class="ChefsTest2.Presentation.OnboardingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource SurfaceBrush}"
      NavigationCacheMode="Required">

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <FlipView Grid.Row="0" SelectedIndex="{x:Bind ViewModel.CurrentPage, Mode=TwoWay}"
              Background="Transparent" BorderThickness="0">
      <FlipView.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Image Source="{Binding}" Stretch="UniformToFill" />
          </Grid>
        </DataTemplate>
      </FlipView.ItemTemplate>
      <x:String>ms-appx:///Assets/Welcome/first_splash_screen.png</x:String>
      <x:String>ms-appx:///Assets/Welcome/second_splash_screen.png</x:String>
      <x:String>ms-appx:///Assets/Welcome/third_splash_screen.png</x:String>
    </FlipView>

    <StackPanel Grid.Row="1" Padding="32,16,32,8" Spacing="16">
      <TextBlock Style="{StaticResource ChefsTitleLarge}"
                 Text="{x:Bind GetTitle(ViewModel.CurrentPage), Mode=OneWay}"
                 Foreground="{ThemeResource OnSurfaceBrush}"
                 TextAlignment="Center" />
      <TextBlock Style="{StaticResource ChefsBodyLarge}"
                 Text="{x:Bind GetBody(ViewModel.CurrentPage), Mode=OneWay}"
                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                 TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>

    <PipsPager Grid.Row="2" HorizontalAlignment="Center"
               NumberOfPages="3" SelectedPageIndex="{x:Bind ViewModel.CurrentPage, Mode=TwoWay}"
               Margin="0,8,0,16" />

    <Grid Grid.Row="3" Padding="32,8,32,24" RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Row="0" Grid.Column="0" Margin="0,0,8,0"
              HorizontalAlignment="Stretch" Content="Previous"
              Command="{x:Bind ViewModel.PreviousCommand}"
              AutomationProperties.AutomationId="OnboardingPrevious" />
      <Button Grid.Row="0" Grid.Column="1" Margin="8,0,0,0"
              HorizontalAlignment="Stretch" Content="Next"
              Background="{ThemeResource PrimaryBrush}"
              Foreground="{ThemeResource OnPrimaryBrush}"
              Command="{x:Bind ViewModel.NextCommand}"
              AutomationProperties.AutomationId="OnboardingNext" />
      <Button Grid.Row="1" Grid.ColumnSpan="2"
              HorizontalAlignment="Center" Background="Transparent"
              Foreground="{ThemeResource PrimaryBrush}" Content="Skip"
              Command="{x:Bind ViewModel.SkipCommand}"
              AutomationProperties.AutomationId="OnboardingSkip" />
    </Grid>
  </Grid>
</Page>
