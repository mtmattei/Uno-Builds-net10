<Page x:Class="ChefsTest2.Presentation.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource SurfaceBrush}"
      NavigationCacheMode="Required">

  <ScrollViewer>
    <Grid utu:SafeArea.Insets="VisibleBounds" Padding="32,32,32,24">
      <StackPanel HorizontalAlignment="Stretch" MaxWidth="500" Spacing="24">

        <StackPanel HorizontalAlignment="Center" Margin="0,32,0,16">
          <TextBlock Text="uno" FontSize="48" FontWeight="Light"
                     Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Chefs" FontSize="32" FontStyle="Italic"
                     Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center"
                     Margin="0,-12,0,0" />
        </StackPanel>

        <TextBox PlaceholderText="Username"
                 Text="{x:Bind ViewModel.Username, Mode=TwoWay}"
                 AutomationProperties.AutomationId="LoginUsername" />

        <PasswordBox PlaceholderText="Password"
                     Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                     AutomationProperties.AutomationId="LoginPassword" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" Content="Remember me"
                    IsChecked="{x:Bind ViewModel.RememberMe, Mode=TwoWay}" />
          <Button Grid.Column="1" Content="Forgot password?"
                  Background="Transparent"
                  Foreground="{ThemeResource PrimaryBrush}" />
        </Grid>

        <Button HorizontalAlignment="Stretch" Content="Login" Padding="0,16"
                Background="{ThemeResource PrimaryBrush}"
                Foreground="{ThemeResource OnPrimaryBrush}"
                Command="{x:Bind ViewModel.LoginCommand}"
                AutomationProperties.AutomationId="LoginSubmit" />

        <Border Background="{ThemeResource OutlineVariantBrush}" Height="1" Margin="0,8" />

        <Button HorizontalAlignment="Stretch" Padding="0,16"
                Background="{ThemeResource SecondaryContainerBrush}"
                Foreground="{ThemeResource OnSecondaryContainerBrush}"
                Command="{x:Bind ViewModel.SignInAppleCommand}">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE730;" FontSize="18" />
            <TextBlock Text="Sign in with Apple" />
          </StackPanel>
        </Button>
        <Button HorizontalAlignment="Stretch" Padding="0,16"
                Background="{ThemeResource SecondaryContainerBrush}"
                Foreground="{ThemeResource OnSecondaryContainerBrush}"
                Command="{x:Bind ViewModel.SignInGoogleCommand}">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE774;" FontSize="18" />
            <TextBlock Text="Sign in with Google" />
          </StackPanel>
        </Button>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
          <TextBlock Text="Not a member?" Foreground="{ThemeResource OnSurfaceBrush}" />
          <Button Content="Register Now" Background="Transparent"
                  Foreground="{ThemeResource PrimaryBrush}"
                  Command="{x:Bind ViewModel.RegisterCommand}"
                  AutomationProperties.AutomationId="LoginRegisterLink" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
