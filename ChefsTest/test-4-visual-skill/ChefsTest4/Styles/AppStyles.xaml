<!-- DESIGN.md §7 Typography + §5 Component Inventory + §13 Implementation Notes / Design Tokens.
     4-pt baseline; 8/12/16/20/24/32/40 spacing scale; H4 14/600, H3 16/700, H2 20/700, H1 22/700, Display 26/700, Body-1 16/400, Body-2 14/400, Caption 12/500.
     Audit follow-through: chip min-height 44 (audit #2), Apply filters/changes plural (audit #4), Application Settings Title Case (audit #5), Log out row (open #6 default), 1.5px PrimaryBrush selected chip (open #1 default). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Brushes (theme-aware) ===== -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppBarBackgroundBrush" Color="#2B2B2E" />
      <SolidColorBrush x:Key="AppBarForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CanvasBrush" Color="#F6F7FA" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GroupedBgBrush" Color="#F1F3F8" />
      <SolidColorBrush x:Key="DividerBrush" Color="#E6E8EE" />
      <SolidColorBrush x:Key="InputBorderBrush" Color="#D0D0D0" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#6E6E6E" />
      <SolidColorBrush x:Key="PlaceholderBrush" Color="#9B9B9B" />
      <SolidColorBrush x:Key="HeartActiveBrush" Color="#E91E63" />
      <SolidColorBrush x:Key="HeartInactiveBrush" Color="#9B9B9B" />
      <SolidColorBrush x:Key="BeigeBrush" Color="#EDE4D3" />
      <SolidColorBrush x:Key="BeigePillBrush" Color="#F5EFE3" />
      <SolidColorBrush x:Key="ChartProteinBrush" Color="#3E8BFA" />
      <SolidColorBrush x:Key="ChartCarbsBrush" Color="#8B5CF6" />
      <SolidColorBrush x:Key="ChartFatBrush" Color="#E91E63" />
      <SolidColorBrush x:Key="ChartTrackBrush" Color="#EDEDED" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F9A825" />
      <SolidColorBrush x:Key="MapSurfaceBrush" Color="#E0E5EE" />
      <SolidColorBrush x:Key="VideoSurfaceBrush" Color="#222222" />
      <SolidColorBrush x:Key="VideoOverlayScrimBrush" Color="#99000000" />
      <SolidColorBrush x:Key="VideoScrubberTrackBrush" Color="#66FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBarBackgroundBrush" Color="#ECECEC" />
      <SolidColorBrush x:Key="AppBarForegroundBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="CanvasBrush" Color="#121212" />
      <SolidColorBrush x:Key="CardBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="GroupedBgBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="DividerBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="InputBorderBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#BDBDBD" />
      <SolidColorBrush x:Key="PlaceholderBrush" Color="#9B9B9B" />
      <SolidColorBrush x:Key="HeartActiveBrush" Color="#F8BBD0" />
      <SolidColorBrush x:Key="HeartInactiveBrush" Color="#9B9B9B" />
      <SolidColorBrush x:Key="BeigeBrush" Color="#3A2A20" />
      <SolidColorBrush x:Key="BeigePillBrush" Color="#3A2A20" />
      <SolidColorBrush x:Key="ChartProteinBrush" Color="#3E8BFA" />
      <SolidColorBrush x:Key="ChartCarbsBrush" Color="#8B5CF6" />
      <SolidColorBrush x:Key="ChartFatBrush" Color="#F8BBD0" />
      <SolidColorBrush x:Key="ChartTrackBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#A5D6A7" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFD54F" />
      <SolidColorBrush x:Key="MapSurfaceBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="VideoSurfaceBrush" Color="#000000" />
      <SolidColorBrush x:Key="VideoOverlayScrimBrush" Color="#99000000" />
      <SolidColorBrush x:Key="VideoScrubberTrackBrush" Color="#66FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- ===== Typography (DESIGN.md §7) ===== -->
  <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="Foreground" Value="{ThemeResource OnBackgroundBrush}" />
  </Style>
  <Style x:Key="H1TextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="27" />
    <Setter Property="Foreground" Value="{ThemeResource OnBackgroundBrush}" />
  </Style>
  <Style x:Key="H2TextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="Foreground" Value="{ThemeResource OnBackgroundBrush}" />
  </Style>
  <Style x:Key="H3TextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{ThemeResource OnBackgroundBrush}" />
  </Style>
  <Style x:Key="H4TextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{ThemeResource OnBackgroundBrush}" />
  </Style>
  <Style x:Key="Body1TextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Foreground" Value="{ThemeResource OnBackgroundBrush}" />
  </Style>
  <Style x:Key="Body2TextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{ThemeResource OnBackgroundBrush}" />
  </Style>
  <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
  </Style>
  <Style x:Key="MutedBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Body2TextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
  </Style>

  <!-- ===== Buttons (DESIGN.md §5 Component Inventory + §9 State Map) ===== -->
  <Style x:Key="PrimaryCtaButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style x:Key="SecondaryOutlineButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="SocialButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource BeigeBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSecondaryBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style x:Key="TertiaryLinkButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style x:Key="FabButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style x:Key="FormInputStyle" TargetType="TextBox">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style x:Key="FormPasswordStyle" TargetType="PasswordBox">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===== Cards / Containers ===== -->
  <Style x:Key="CardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style x:Key="GroupedCardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style x:Key="StatCardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource GroupedBgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="MinHeight" Value="88" />
  </Style>
  <Style x:Key="QuantityPillBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource GroupedBgBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,4" />
  </Style>

  <!-- Chip — open question #1 default: selected = 1.5px PrimaryBrush + PrimaryContainer fill. Audit #2 fix: 44px min-height. -->
  <Style x:Key="ChipBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style x:Key="ChipBorderSelectedStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource PrimaryContainerBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <!-- ===== Page chrome ===== -->
  <Style x:Key="InvertedAppBarBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AppBarBackgroundBrush}" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="16,0" />
  </Style>

  <Style x:Key="AppBarTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource H1TextStyle}">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AppBarForegroundBrush}" />
  </Style>

  <!-- ===== FontIcon defaults — use Segoe MDL2 / Symbol Icon fallback ===== -->
  <x:Double x:Key="IconSm">18</x:Double>
  <x:Double x:Key="IconMd">20</x:Double>
  <x:Double x:Key="IconLg">24</x:Double>
  <x:Double x:Key="AvatarSm">24</x:Double>
  <x:Double x:Key="AvatarMd">48</x:Double>
  <x:Double x:Key="AvatarLg">96</x:Double>
  <x:Double x:Key="FabSize">56</x:Double>

  <!-- ===== Section header inline style ===== -->
  <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource H3TextStyle}">
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

</ResourceDictionary>
