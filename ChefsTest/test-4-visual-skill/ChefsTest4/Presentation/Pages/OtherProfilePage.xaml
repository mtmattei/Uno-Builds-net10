<UserControl x:Class="ChefsTest4.Presentation.Pages.OtherProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ChefsTest4.Models"
             xmlns:c="using:ChefsTest4.Presentation.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <UserControl.Resources>
    <c:HeartGlyphConverter x:Key="HeartGlyphConv" />
    <c:HeartBrushConverter x:Key="HeartBrushConv" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource InvertedAppBarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.BackCommand}">
          <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.User.FullName, Mode=OneWay, FallbackValue='Profile'}" Style="{StaticResource AppBarTitleStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Spacing="12" Padding="16,24,16,16" HorizontalAlignment="Center">
      <Border Width="96" Height="96" CornerRadius="48" Background="{ThemeResource SurfaceVariantBrush}">
        <Image Source="{x:Bind ViewModel.User.UrlProfileImage, Mode=OneWay}" Stretch="UniformToFill" />
      </Border>
      <TextBlock Text="{x:Bind ViewModel.User.FullName, Mode=OneWay}" Style="{StaticResource H2TextStyle}" HorizontalAlignment="Center" />
      <TextBlock Text="{x:Bind ViewModel.User.Description, Mode=OneWay}" Style="{StaticResource MutedBodyTextStyle}" TextAlignment="Center" />
      <Grid Margin="0,8,0,0" Width="320">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.User.Recipes, Mode=OneWay, FallbackValue=0}" Style="{StaticResource H2TextStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="Recipes" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.User.Followers, Mode=OneWay, FallbackValue=0}" Style="{StaticResource H2TextStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="Followers" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.User.Following, Mode=OneWay, FallbackValue=0}" Style="{StaticResource H2TextStyle}" HorizontalAlignment="Center" />
          <TextBlock Text="Following" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <ScrollViewer Grid.Row="2" Padding="16,16,16,16">
      <StackPanel Spacing="12">
        <TextBlock Text="Recipes" Style="{StaticResource H3TextStyle}" />
        <ListView ItemsSource="{x:Bind ViewModel.Recipes, Mode=OneWay}" SelectionMode="None" Padding="0">
          <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></ListView.ItemsPanel>
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,12" /></Style></ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="m:RecipeData">
              <Border Style="{StaticResource CardBorderStyle}" Padding="0" Width="172">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="130" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{ThemeResource SurfaceVariantBrush}">
                    <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Row="1" Padding="12">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource H4TextStyle}" MaxLines="2" />
                    <TextBlock Text="{x:Bind Calories}" Style="{StaticResource CaptionTextStyle}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
