<UserControl x:Class="ChefsTest4.Presentation.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <ScrollViewer>
    <Grid Padding="24,40,24,40" MaxWidth="480" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,32" Spacing="4">
        <FontIcon Glyph="&#xE7C0;" FontSize="40" Foreground="{ThemeResource PrimaryBrush}" />
        <TextBlock Text="Uno Chefs" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
      </StackPanel>

      <Border Grid.Row="1" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" MinHeight="56" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{ThemeResource PrimaryBrush}" />
          <TextBox x:Name="EmailBox" Grid.Column="1" PlaceholderText="Username" BorderThickness="0" Background="Transparent"
                   Text="{x:Bind ViewModel.Email, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Grid.Row="2" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" MinHeight="56" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{ThemeResource PrimaryBrush}" />
          <PasswordBox Grid.Column="1" PlaceholderText="Password" BorderThickness="0" Background="Transparent"
                       Password="{x:Bind ViewModel.Password, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" Content="Remember me" IsChecked="{x:Bind ViewModel.RememberMe, Mode=TwoWay}" />
        <Button Grid.Column="1" Style="{StaticResource TertiaryLinkButtonStyle}" Content="Forgot password?" Command="{x:Bind ViewModel.ForgotPasswordCommand}" />
      </Grid>

      <Button Grid.Row="4" Style="{StaticResource PrimaryCtaButtonStyle}" Content="Log in" Command="{x:Bind ViewModel.LogInCommand}" />

      <TextBlock Grid.Row="5" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" Margin="0,12,0,0" Style="{StaticResource Body2TextStyle}" />

      <Border Grid.Row="6" Background="{ThemeResource DividerBrush}" Height="1" Margin="0,24,0,24" Opacity="0.5" />

      <Button Grid.Row="7" Style="{StaticResource SocialButtonStyle}" Margin="0,0,0,12" Command="{x:Bind ViewModel.SignInAppleCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE116;" FontSize="18" />
          <TextBlock Text="Sign in with Apple" />
        </StackPanel>
      </Button>

      <Button Grid.Row="8" Style="{StaticResource SocialButtonStyle}" Command="{x:Bind ViewModel.SignInGoogleCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE774;" FontSize="18" />
          <TextBlock Text="Sign in with Google" />
        </StackPanel>
      </Button>

      <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0" Spacing="4">
        <TextBlock Text="Not a member?" Style="{StaticResource Body2TextStyle}" />
        <Button Style="{StaticResource TertiaryLinkButtonStyle}" Content="Register Now" Command="{x:Bind ViewModel.RegisterCommand}" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
