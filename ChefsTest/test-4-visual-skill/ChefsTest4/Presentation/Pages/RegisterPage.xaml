<UserControl x:Class="ChefsTest4.Presentation.Pages.RegisterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <ScrollViewer>
    <Grid Padding="24,40,24,40" MaxWidth="480" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,32" Spacing="4">
        <FontIcon Glyph="&#xE7C0;" FontSize="40" Foreground="{ThemeResource PrimaryBrush}" />
        <TextBlock Text="Uno Chefs" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
      </StackPanel>

      <Border Grid.Row="1" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" MinHeight="56" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{ThemeResource PrimaryBrush}" />
          <TextBox Grid.Column="1" PlaceholderText="Username" BorderThickness="0" Background="Transparent" Text="{x:Bind ViewModel.Username, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Grid.Row="2" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" MinHeight="56" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <FontIcon Grid.Column="0" Glyph="&#xE715;" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{ThemeResource PrimaryBrush}" />
          <TextBox Grid.Column="1" PlaceholderText="Email" BorderThickness="0" Background="Transparent" Text="{x:Bind ViewModel.Email, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Grid.Row="3" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" MinHeight="56" Margin="0,0,0,24">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{ThemeResource PrimaryBrush}" />
          <PasswordBox Grid.Column="1" PlaceholderText="Password" BorderThickness="0" Background="Transparent" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Button Grid.Row="4" Style="{StaticResource PrimaryCtaButtonStyle}" Content="Sign Up" Command="{x:Bind ViewModel.SignUpCommand}" />

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0" Spacing="4">
        <TextBlock Text="Already a member?" Style="{StaticResource Body2TextStyle}" />
        <Button Style="{StaticResource TertiaryLinkButtonStyle}" Content="Login" Command="{x:Bind ViewModel.LoginCommand}" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
