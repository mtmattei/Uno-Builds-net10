<UserControl x:Class="ChefsTest4.Presentation.Pages.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ChefsTest4.Models"
             xmlns:c="using:ChefsTest4.Presentation.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <UserControl.Resources>
    <c:RelativeDateGroupConverter x:Key="DateGrpConv" />
    <c:BoolToVisibilityConverter x:Key="BoolVis" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource InvertedAppBarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.CloseCommand}">
          <FontIcon Glyph="&#xE711;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
        <TextBlock Grid.Column="1" Text="Notifications" Style="{StaticResource AppBarTitleStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </Grid>
    </Border>

    <Pivot Grid.Row="1" SelectedIndex="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}" Background="Transparent" Padding="0">
      <PivotItem Header="All" />
      <PivotItem Header="Unread" />
      <PivotItem Header="Read" />
    </Pivot>

    <Grid Grid.Row="2">
      <ScrollViewer Padding="16,16,16,16" Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolVis}}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Visible, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:NotificationData">
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{x:Bind Date, Converter={StaticResource DateGrpConv}}" Style="{StaticResource CaptionTextStyle}" />
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{ThemeResource PrimaryContainerBrush}">
                      <FontIcon Glyph="&#xEA8F;" FontSize="18" Foreground="{ThemeResource PrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{x:Bind Title}" Style="{StaticResource H4TextStyle}" />
                      <TextBlock Text="{x:Bind Description}" Style="{StaticResource MutedBodyTextStyle}" TextWrapping="Wrap" MaxLines="3" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32"
                  Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVis}}">
        <Image Source="ms-appx:///Assets/Images/empty_notification_light.svg" Width="120" Height="120" Stretch="Uniform" />
        <TextBlock Text="No Notifications Yet" Style="{StaticResource H1TextStyle}" HorizontalAlignment="Center" />
        <TextBlock Text="When you have new alerts they'll show up here." Style="{StaticResource MutedBodyTextStyle}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
