<UserControl x:Class="ChefsTest4.Presentation.Pages.CookbookDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ChefsTest4.Models"
             xmlns:c="using:ChefsTest4.Presentation.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <UserControl.Resources>
    <c:HeartGlyphConverter x:Key="HeartGlyphConv" />
    <c:HeartBrushConverter x:Key="HeartBrushConv" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource InvertedAppBarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.BackCommand}">
          <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CookbookName, Mode=OneWay}" Style="{StaticResource AppBarTitleStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.UpdateCommand}">
          <FontIcon Glyph="&#xE712;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Padding="16,12,16,4">
      <Run Text="{x:Bind ViewModel.RecipeCount, Mode=OneWay}" />
      <Run Text=" results" />
    </TextBlock>

    <Grid Grid.Row="2">
      <ListView ItemsSource="{x:Bind ViewModel.Recipes, Mode=OneWay}" Padding="16,8,16,16" SelectionMode="None">
        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></ListView.ItemsPanel>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,12" /></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="m:RecipeData">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0" Width="172">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="130" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{ThemeResource SurfaceVariantBrush}">
                  <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Row="1" Padding="12">
                  <TextBlock Text="{x:Bind Name}" Style="{StaticResource H4TextStyle}" MaxLines="2" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Calories}" Style="{StaticResource CaptionTextStyle}" />
                    <FontIcon Grid.Column="1" Glyph="{x:Bind IsFavorite, Converter={StaticResource HeartGlyphConv}}" FontSize="16"
                              Foreground="{x:Bind IsFavorite, Converter={StaticResource HeartBrushConv}}" />
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <Button Style="{StaticResource FabButtonStyle}" Margin="0,0,16,16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Command="{x:Bind ViewModel.UpdateCommand}">
        <FontIcon Glyph="&#xE710;" FontSize="22" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
