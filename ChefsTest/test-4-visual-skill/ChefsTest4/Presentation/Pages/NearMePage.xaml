<UserControl x:Class="ChefsTest4.Presentation.Pages.NearMePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ChefsTest4.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource InvertedAppBarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.BackCommand}">
          <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
        <TextBlock Grid.Column="1" Text="Near me" Style="{StaticResource AppBarTitleStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="{ThemeResource MapSurfaceBrush}">

      <!-- Faux map: pins distributed -->
      <Canvas>
        <FontIcon Canvas.Left="64"  Canvas.Top="120" Glyph="&#xE707;" FontSize="36" Foreground="{ThemeResource PrimaryBrush}" />
        <FontIcon Canvas.Left="200" Canvas.Top="80"  Glyph="&#xE707;" FontSize="36" Foreground="{ThemeResource PrimaryBrush}" />
        <FontIcon Canvas.Left="120" Canvas.Top="200" Glyph="&#xE707;" FontSize="36" Foreground="{ThemeResource PrimaryBrush}" />
        <FontIcon Canvas.Left="260" Canvas.Top="220" Glyph="&#xE707;" FontSize="36" Foreground="{ThemeResource PrimaryBrush}" />
        <FontIcon Canvas.Left="320" Canvas.Top="140" Glyph="&#xE735;" FontSize="32" Foreground="{ThemeResource TertiaryBrush}" />
      </Canvas>

      <!-- Contributor card overlay -->
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="360" Margin="16,0,16,80" Style="{StaticResource CardBorderStyle}" Padding="16">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{ThemeResource SurfaceVariantBrush}">
            <Image Source="{x:Bind ViewModel.SelectedContributor.UrlProfileImage, Mode=OneWay}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{x:Bind ViewModel.SelectedContributor.FullName, Mode=OneWay, FallbackValue='Contributor'}" Style="{StaticResource H4TextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.SelectedContributor.Description, Mode=OneWay, FallbackValue='Nearby chef'}" Style="{StaticResource CaptionTextStyle}" />
          </StackPanel>
        </Grid>
      </Border>

      <Button Style="{StaticResource FabButtonStyle}" Margin="0,0,16,16" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <FontIcon Glyph="&#xE707;" FontSize="22" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
