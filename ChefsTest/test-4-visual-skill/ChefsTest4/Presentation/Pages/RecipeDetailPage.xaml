<UserControl x:Class="ChefsTest4.Presentation.Pages.RecipeDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ChefsTest4.Models"
             xmlns:c="using:ChefsTest4.Presentation.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <UserControl.Resources>
    <c:CookTimeMinutesConverter x:Key="CookTimeConv" />
    <c:DifficultyLabelConverter x:Key="DiffConv" />
    <c:BoolToVisibilityConverter x:Key="BoolVis" />
    <c:HeartGlyphConverter x:Key="HeartGlyphConv" />
    <c:HeartBrushConverter x:Key="HeartBrushConv" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- App bar back + title -->
    <Border Grid.Row="0" Style="{StaticResource InvertedAppBarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.BackCommand}">
          <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay, FallbackValue='Recipe'}" Style="{StaticResource AppBarTitleStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8">
          <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.ToggleFavoriteCommand}">
          <FontIcon Glyph="&#xEB52;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <!-- Author strip -->
    <Border Grid.Row="1" Background="{ThemeResource CardBrush}" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Width="24" Height="24" CornerRadius="12" Background="{ThemeResource SurfaceVariantBrush}">
          <Image Source="{x:Bind ViewModel.AuthorAvatar, Mode=OneWay}" Stretch="UniformToFill" />
        </Border>
        <TextBlock Text="By" Style="{StaticResource Body2TextStyle}" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{x:Bind ViewModel.AuthorName, Mode=OneWay}" Style="{StaticResource H4TextStyle}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" Padding="16,16,16,16">
      <StackPanel Spacing="16">
        <!-- Hero -->
        <Border CornerRadius="12" Height="225" Background="{ThemeResource SurfaceVariantBrush}">
          <Image Source="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Stretch="UniformToFill" />
        </Border>

        <!-- Stat row -->
        <Border Style="{StaticResource StatCardBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE823;" FontSize="18" />
              <TextBlock Text="{x:Bind ViewModel.Recipe.CookTime, Mode=OneWay, Converter={StaticResource CookTimeConv}}" Style="{StaticResource H4TextStyle}" HorizontalAlignment="Center" />
              <TextBlock Text="time" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Background="{ThemeResource DividerBrush}" Width="1" />
            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE735;" FontSize="18" />
              <TextBlock Text="{x:Bind ViewModel.Recipe.Difficulty, Mode=OneWay, Converter={StaticResource DiffConv}}" Style="{StaticResource H4TextStyle}" HorizontalAlignment="Center" />
              <TextBlock Text="difficulty" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="3" Background="{ThemeResource DividerBrush}" Width="1" />
            <StackPanel Grid.Column="4" Spacing="4" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE945;" FontSize="18" />
              <TextBlock Text="{x:Bind ViewModel.Recipe.Calories, Mode=OneWay}" Style="{StaticResource H4TextStyle}" HorizontalAlignment="Center" />
              <TextBlock Text="calories" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Tab strip -->
        <Pivot SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}" Background="Transparent">

          <!-- Ingredients -->
          <PivotItem Header="Ingredients">
            <StackPanel Spacing="12" Padding="0,12,0,0">
              <TextBlock>
                <Run Text="{x:Bind ViewModel.IngredientCount, Mode=OneWay}" />
                <Run Text=" items" />
              </TextBlock>
              <ItemsControl ItemsSource="{x:Bind ViewModel.Recipe.Ingredients, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:IngredientData">
                    <Grid Padding="0,8" ColumnSpacing="12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{ThemeResource GroupedBgBrush}">
                        <Image Source="{x:Bind UrlIcon}" Stretch="Uniform" Margin="6" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" Style="{StaticResource Body1TextStyle}" />
                      <Border Grid.Column="2" Style="{StaticResource QuantityPillBorderStyle}">
                        <TextBlock Text="{x:Bind Quantity}" Style="{StaticResource CaptionTextStyle}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </PivotItem>

          <!-- Steps -->
          <PivotItem Header="Steps">
            <StackPanel Spacing="12" Padding="0,12,0,0">
              <TextBlock>
                <Run Text="{x:Bind ViewModel.StepCount, Mode=OneWay}" />
                <Run Text=" steps" />
              </TextBlock>
              <ItemsControl ItemsSource="{x:Bind ViewModel.Recipe.Steps, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="m:StepData">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Background="{ThemeResource PrimaryContainerBrush}" CornerRadius="999" Padding="8,2" MinWidth="28">
                            <TextBlock Text="{x:Bind Number}" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource OnPrimaryContainerBrush}" HorizontalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{x:Bind Name}" Style="{StaticResource H4TextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource MutedBodyTextStyle}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </PivotItem>

          <!-- Reviews -->
          <PivotItem Header="Reviews">
            <Grid Padding="0,12,0,0">
              <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasReviews, Mode=OneWay, Converter={StaticResource BoolVis}}">
                <TextBlock>
                  <Run Text="{x:Bind ViewModel.ReviewCount, Mode=OneWay}" />
                  <Run Text=" comments" />
                </TextBlock>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Recipe.Reviews, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:ReviewData">
                      <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource SurfaceVariantBrush}">
                              <Image Source="{x:Bind UrlAuthorImage}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{x:Bind PublisherName}" Style="{StaticResource H4TextStyle}" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="{x:Bind Description}" Style="{StaticResource Body2TextStyle}" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE19F;" FontSize="14" /><TextBlock Text="0" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE19E;" FontSize="14" /><TextBlock Text="0" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{x:Bind ViewModel.HasNoReviews, Mode=OneWay, Converter={StaticResource BoolVis}}" Padding="32">
                <FontIcon Glyph="&#xE82D;" FontSize="64" Foreground="{ThemeResource MutedTextBrush}" />
                <TextBlock Text="No Reviews Yet" Style="{StaticResource H1TextStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Be the first to leave a review!" Style="{StaticResource MutedBodyTextStyle}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </PivotItem>

          <!-- Nutrition -->
          <PivotItem Header="Nutrition">
            <StackPanel Spacing="16" Padding="0,12,0,0">
              <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                  <TextBlock Text="Intake per serving" Style="{StaticResource H3TextStyle}" HorizontalAlignment="Center" />
                  <Grid Width="140" Height="140">
                    <Ellipse Width="140" Height="140" Stroke="{ThemeResource ChartTrackBrush}" StrokeThickness="10" />
                    <Ellipse Width="140" Height="140" Stroke="{ThemeResource PrimaryBrush}" StrokeThickness="10"
                             StrokeDashArray="3 1" StrokeDashOffset="0" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind ViewModel.Recipe.Calories, Mode=OneWay, FallbackValue='250 kcal'}" Style="{StaticResource DisplayTextStyle}" HorizontalAlignment="Center" />
                      <TextBlock Text="Calories" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Protein" Style="{StaticResource Body2TextStyle}" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                      <Border Background="{ThemeResource ChartTrackBrush}" CornerRadius="3" />
                      <Border Background="{ThemeResource ChartProteinBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="80" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="30/110g" Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Carbs" Style="{StaticResource Body2TextStyle}" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                      <Border Background="{ThemeResource ChartTrackBrush}" CornerRadius="3" />
                      <Border Background="{ThemeResource ChartCarbsBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="120" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="101/300g" Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Fat" Style="{StaticResource Body2TextStyle}" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                      <Border Background="{ThemeResource ChartTrackBrush}" CornerRadius="3" />
                      <Border Background="{ThemeResource ChartFatBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="60" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="30/75g" Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </PivotItem>

        </Pivot>
      </StackPanel>
    </ScrollViewer>

    <!-- Sticky Start Cooking! CTA -->
    <Border Grid.Row="3" Padding="16,12,16,16" Background="{ThemeResource CanvasBrush}">
      <Button Style="{StaticResource PrimaryCtaButtonStyle}" Content="Start Cooking!" Command="{x:Bind ViewModel.StartCookingCommand}" />
    </Border>
  </Grid>
</UserControl>
