<UserControl x:Class="ChefsTest4.Presentation.Pages.CreateCookbookPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChefsTest4.ViewModels"
             xmlns:m="using:ChefsTest4.Models"
             xmlns:c="using:ChefsTest4.Presentation.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <UserControl.Resources>
    <c:HeartGlyphConverter x:Key="HeartGlyphConv" />
    <c:HeartBrushConverter x:Key="HeartBrushConv" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource InvertedAppBarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.CancelCommand}">
          <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
        <TextBlock Grid.Column="1" Text="Create Cookbook" Style="{StaticResource AppBarTitleStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Margin="16,16,16,12" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" MinHeight="56">
      <TextBox PlaceholderText="Cookbook name" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
    </Border>

    <TextBlock Grid.Row="2" Text="Add recipes" Style="{StaticResource H3TextStyle}" Padding="16,4,16,12" />

    <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Picks, Mode=OneWay}" Padding="16,0,16,16" SelectionMode="None">
      <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></ListView.ItemsPanel>
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,12" /></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:RecipePickItem">
          <Button Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.TogglePickCommand, ElementName=Root}" CommandParameter="{x:Bind}">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0" Width="172">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="130" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{ThemeResource SurfaceVariantBrush}">
                  <Image Source="{x:Bind Recipe.ImageUrl}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Row="1" Padding="12">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Recipe.Name}" Style="{StaticResource H4TextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="1" Glyph="{x:Bind Selected, Mode=OneWay, Converter={StaticResource HeartGlyphConv}}" FontSize="20"
                              Foreground="{x:Bind Selected, Mode=OneWay, Converter={StaticResource HeartBrushConv}}" />
                  </Grid>
                  <TextBlock Text="{x:Bind Recipe.Calories}" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
              </Grid>
            </Border>
          </Button>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Grid Grid.Row="4" Padding="16,12,16,16" Background="{ThemeResource CanvasBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource SecondaryOutlineButtonStyle}" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
      <Button Grid.Column="2" Style="{StaticResource PrimaryCtaButtonStyle}" Content="Create cookbook" Command="{x:Bind ViewModel.CreateCommand}" />
    </Grid>
  </Grid>
</UserControl>
