<UserControl x:Class="ChefsTest4.Presentation.Pages.FavoritesPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ChefsTest4.Models"
             xmlns:c="using:ChefsTest4.Presentation.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <UserControl.Resources>
    <c:HeartGlyphConverter x:Key="HeartGlyphConv" />
    <c:HeartBrushConverter x:Key="HeartBrushConv" />
    <c:BoolToVisibilityConverter x:Key="BoolVis" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource InvertedAppBarBorderStyle}">
      <TextBlock Text="Favorites" Style="{StaticResource AppBarTitleStyle}" VerticalAlignment="Center" />
    </Border>

    <!-- Segmented underline tabs -->
    <Pivot Grid.Row="1" SelectedIndex="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}" Background="Transparent" Padding="0">
      <PivotItem Header="All Recipes">
        <Grid>
          <ListView ItemsSource="{x:Bind ViewModel.Recipes.Items, Mode=OneWay}" Padding="16,12,16,16" SelectionMode="None"
                    Visibility="{x:Bind ViewModel.Recipes.HasItems, Mode=OneWay, Converter={StaticResource BoolVis}}">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,12" /></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="m:RecipeData">
                <Border Style="{StaticResource CardBorderStyle}" Padding="0" Width="172">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="130" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{ThemeResource SurfaceVariantBrush}">
                      <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Row="1" Padding="12">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource H4TextStyle}" MaxLines="2" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Calories}" Style="{StaticResource CaptionTextStyle}" />
                        <FontIcon Grid.Column="1" Glyph="{x:Bind IsFavorite, Converter={StaticResource HeartGlyphConv}}" FontSize="16"
                                  Foreground="{x:Bind IsFavorite, Converter={StaticResource HeartBrushConv}}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32"
                      Visibility="{x:Bind ViewModel.Recipes.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVis}}">
            <Image Source="ms-appx:///Assets/Images/empty_box_light.svg" Width="120" Height="120" Stretch="Uniform" />
            <TextBlock Text="No Favorites Yet" Style="{StaticResource H1TextStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="You haven't added any recipes to your favorites yet." Style="{StaticResource MutedBodyTextStyle}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Center" />
            <Button Style="{StaticResource TertiaryLinkButtonStyle}" Command="{x:Bind ViewModel.Recipes.SeePopularCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE735;" FontSize="14" /><TextBlock Text="See popular recipes" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </PivotItem>

      <PivotItem Header="My Cookbooks">
        <Grid>
          <ListView ItemsSource="{x:Bind ViewModel.Cookbooks.Items, Mode=OneWay}" Padding="16,12,16,16" SelectionMode="None"
                    Visibility="{x:Bind ViewModel.Cookbooks.HasItems, Mode=OneWay, Converter={StaticResource BoolVis}}">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,12" /></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="m:CookbookData">
                <Border Style="{StaticResource CardBorderStyle}" Padding="0" Width="172">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="172" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" CornerRadius="12,12,0,0" RowSpacing="2" ColumnSpacing="2" Background="{ThemeResource SurfaceVariantBrush}">
                      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource GroupedBgBrush}"><Image Stretch="UniformToFill" /></Border>
                      <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource GroupedBgBrush}"><Image Stretch="UniformToFill" /></Border>
                      <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource GroupedBgBrush}"><Image Stretch="UniformToFill" /></Border>
                      <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource GroupedBgBrush}">
                        <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="{ThemeResource MutedTextBrush}" />
                      </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Padding="12">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource H4TextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource CaptionTextStyle}">
                        <Run Text="{x:Bind PinsNumber, FallbackValue=0}" />
                        <Run Text=" recipes" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32"
                      Visibility="{x:Bind ViewModel.Cookbooks.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVis}}">
            <Image Source="ms-appx:///Assets/Images/empty_box_light.svg" Width="120" Height="120" Stretch="Uniform" />
            <TextBlock Text="No Cookbooks Created" Style="{StaticResource H1TextStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Cookbooks are a great way to organize your recipes." Style="{StaticResource MutedBodyTextStyle}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Center" />
            <Button Style="{StaticResource TertiaryLinkButtonStyle}" Command="{x:Bind ViewModel.Cookbooks.CreateCookbookCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Create cookbook" /></StackPanel>
            </Button>
          </StackPanel>

          <Button Style="{StaticResource FabButtonStyle}" Margin="0,0,16,16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Command="{x:Bind ViewModel.Cookbooks.CreateCookbookCommand}">
            <FontIcon Glyph="&#xE710;" FontSize="22" />
          </Button>
        </Grid>
      </PivotItem>
    </Pivot>
  </Grid>
</UserControl>
