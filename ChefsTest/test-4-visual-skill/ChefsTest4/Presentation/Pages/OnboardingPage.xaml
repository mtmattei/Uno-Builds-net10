<UserControl x:Class="ChefsTest4.Presentation.Pages.OnboardingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChefsTest4.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <Grid Padding="24,32,24,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <FlipView x:Name="Flip" Grid.Row="0" SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
              ItemsSource="{x:Bind ViewModel.Frames}" Background="Transparent">
      <FlipView.ItemTemplate>
        <DataTemplate x:DataType="vm:OnboardingFrame">
          <Grid Padding="0,0,0,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="16" Background="{ThemeResource SurfaceVariantBrush}">
              <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
            </Border>
            <TextBlock Grid.Row="1" Text="{x:Bind Title}" Style="{StaticResource H1TextStyle}" HorizontalAlignment="Center" Margin="0,24,0,12" />
            <TextBlock Grid.Row="2" Text="{x:Bind Body}" Style="{StaticResource Body1TextStyle}" Foreground="{ThemeResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </FlipView.ItemTemplate>
    </FlipView>

    <PipsPager Grid.Row="1" NumberOfPages="3" SelectedPageIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Center" Margin="0,16,0,16" />

    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource SecondaryOutlineButtonStyle}" Content="Previous" Command="{x:Bind ViewModel.PreviousCommand}" />
      <Button Grid.Column="2" Style="{StaticResource PrimaryCtaButtonStyle}" Content="Next" Command="{x:Bind ViewModel.NextCommand}" />
    </Grid>

    <Button Grid.Row="3" Style="{StaticResource TertiaryLinkButtonStyle}" Content="Skip" HorizontalAlignment="Center" Command="{x:Bind ViewModel.SkipCommand}" />
  </Grid>
</UserControl>
