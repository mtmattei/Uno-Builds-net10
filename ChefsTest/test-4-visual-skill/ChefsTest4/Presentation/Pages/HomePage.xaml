<UserControl x:Class="ChefsTest4.Presentation.Pages.HomePage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:ChefsTest4.Models"
             xmlns:c="using:ChefsTest4.Presentation.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{ThemeResource CanvasBrush}">
  <UserControl.Resources>
    <c:CookTimeMinutesConverter x:Key="CookTimeConv" />
    <c:HeartGlyphConverter x:Key="HeartGlyphConv" />
    <c:HeartBrushConverter x:Key="HeartBrushConv" />
    <c:HexToBrushConverter x:Key="HexConv" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- App bar: Wordmark + person + bell (DESIGN.md NavigationBar Wordmark variant) -->
    <Border Grid.Row="0" Style="{StaticResource InvertedAppBarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Uno Chefs" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource AppBarForegroundBrush}" />
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.ProfileCommand}">
          <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8" Command="{x:Bind ViewModel.NotificationsCommand}">
          <FontIcon Glyph="&#xEA8F;" FontSize="20" Foreground="{ThemeResource AppBarForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="16,16,16,80">
      <StackPanel Spacing="24">

        <!-- Trending Now -->
        <StackPanel Spacing="12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Trending Now" Style="{StaticResource H3TextStyle}" />
            <Button Grid.Column="1" Style="{StaticResource TertiaryLinkButtonStyle}" Content="View all" Command="{x:Bind ViewModel.NearMeCommand}" />
          </Grid>
          <ListView ItemsSource="{x:Bind ViewModel.Trending, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectionMode="None">
            <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="m:RecipeData">
                <Button Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.OpenRecipeCommand, ElementName=Root}" CommandParameter="{x:Bind}">
                  <Border Style="{StaticResource CardBorderStyle}" Padding="0" Width="160">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="112" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{ThemeResource SurfaceVariantBrush}">
                        <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Row="1" Padding="12,8,12,12" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource H4TextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{x:Bind Calories}" Style="{StaticResource CaptionTextStyle}" />
                          <FontIcon Grid.Column="1" Glyph="{x:Bind IsFavorite, Converter={StaticResource HeartGlyphConv}}" FontSize="16"
                                    Foreground="{x:Bind IsFavorite, Converter={StaticResource HeartBrushConv}}" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>

        <!-- Categories -->
        <StackPanel Spacing="12">
          <TextBlock Text="Categories" Style="{StaticResource H3TextStyle}" />
          <ListView ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectionMode="None">
            <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="m:CategoryData">
                <Border Background="{ThemeResource CardBrush}" CornerRadius="999" Padding="8,8,16,8" MinHeight="48">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="32" Height="32" Fill="{x:Bind Color, Converter={StaticResource HexConv}}" />
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource H4TextStyle}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>

        <!-- Recently Added -->
        <StackPanel Spacing="12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Recently Added" Style="{StaticResource H3TextStyle}" />
            <Button Grid.Column="1" Style="{StaticResource TertiaryLinkButtonStyle}" Content="View all" />
          </Grid>
          <ListView ItemsSource="{x:Bind ViewModel.Recent, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectionMode="None">
            <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="m:RecipeData">
                <Border Style="{StaticResource CardBorderStyle}" Padding="0" Width="160">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{ThemeResource SurfaceVariantBrush}">
                      <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Row="1" Padding="12,8,12,12" Spacing="2">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource H4TextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Calories}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>

        <!-- Popular Contributors + Near me -->
        <StackPanel Spacing="12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Popular Contributors" Style="{StaticResource H3TextStyle}" />
            <Button Grid.Column="1" Style="{StaticResource TertiaryLinkButtonStyle}" Content="Near me" Command="{x:Bind ViewModel.NearMeCommand}" />
          </Grid>
          <ListView ItemsSource="{x:Bind ViewModel.Contributors, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectionMode="None">
            <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="m:UserData">
                <StackPanel Width="80" Spacing="6" HorizontalAlignment="Center">
                  <Border CornerRadius="28" Width="56" Height="56" Background="{ThemeResource SurfaceVariantBrush}">
                    <Image Source="{x:Bind UrlProfileImage}" Stretch="UniformToFill" />
                  </Border>
                  <TextBlock Text="{x:Bind FullName}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
