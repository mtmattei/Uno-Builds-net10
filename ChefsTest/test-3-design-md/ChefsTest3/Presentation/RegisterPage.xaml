<Page x:Class="ChefsTest3.Presentation.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      Background="{ThemeResource ScreenBackgroundBrush}">
    <ScrollViewer>
        <Grid Padding="24,40,24,40" RowSpacing="16" MaxWidth="480" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Width="72" Height="72" CornerRadius="16"
                    Background="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center"
                    Margin="0,16,0,16">
                <TextBlock Text="UC" Foreground="White" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="1" Text="Create your account" Style="{StaticResource H1Style}" TextAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Save recipes, build cookbooks, share with friends."
                       Style="{StaticResource BodySecondaryStyle}" TextAlignment="Center"
                       TextWrapping="Wrap"/>

            <TextBox Grid.Row="3" PlaceholderText="Username"
                     Style="{StaticResource FormInputStyle}"
                     Text="{x:Bind ViewModel.Username, Mode=TwoWay}"/>
            <TextBox Grid.Row="4" PlaceholderText="Email"
                     Style="{StaticResource FormInputStyle}"
                     Text="{x:Bind ViewModel.Email, Mode=TwoWay}"/>
            <PasswordBox Grid.Row="5" PlaceholderText="Password"
                         Style="{StaticResource FormPasswordStyle}"
                         Password="{x:Bind ViewModel.Password, Mode=TwoWay}"/>

            <Button Grid.Row="6" Command="{x:Bind ViewModel.SignUpCommand}"
                    Style="{StaticResource PrimaryCtaButtonStyle}" Margin="0,8,0,0">
                <TextBlock Text="Sign Up"/>
            </Button>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,12,0,0" Spacing="6">
                <TextBlock Text="Already have an account?" Style="{StaticResource BodySecondaryStyle}"/>
                <HyperlinkButton Command="{x:Bind ViewModel.GoToLoginCommand}"
                                 Foreground="{ThemeResource PrimaryBrush}">
                    <TextBlock Text="Login" FontWeight="SemiBold"/>
                </HyperlinkButton>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
