<Page x:Class="ChefsTest3.Presentation.RecipeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      xmlns:models="using:ChefsTest3.Models"
      Background="{ThemeResource ScreenBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Inverted app bar -->
        <Grid Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}"
              Padding="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource AppBarIconButtonStyle}"
                    Command="{x:Bind ViewModel.GoBackCommand}">
                <TextBlock Text="‹" FontSize="22"/>
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}"
                       Foreground="{ThemeResource AppBarForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Style="{StaticResource AppBarIconButtonStyle}"
                    Command="{x:Bind ViewModel.ToggleFavoriteCommand}">
                <TextBlock x:Name="FavGlyph" Text="{x:Bind local:BindableHelpers.Heart(ViewModel.IsFavorite), Mode=OneWay}"
                           FontSize="20" Foreground="{ThemeResource FavoriteBrush}"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <!-- Hero -->
                <Border Height="220" CornerRadius="0">
                    <Image Source="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Spacing="20" Padding="20,0,20,0">
                    <!-- Author strip -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                               >
                            <Image Source="{x:Bind ViewModel.CreatorAvatar, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CreatorName, Mode=OneWay}"
                                       Style="{StaticResource BodyLargeStyle}"/>
                            <TextBlock Text="Chef" Style="{StaticResource CaptionStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Title + 3-up stat row -->
                    <TextBlock Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}"
                               Style="{StaticResource H1Style}" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="⏱" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource PrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CookTimeDisplay, Mode=OneWay}"
                                       Style="{StaticResource BodyLargeStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="time" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource PrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.ServesDisplay, Mode=OneWay}"
                                       Style="{StaticResource BodyLargeStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="serves" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="🔥" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource PrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CaloriesDisplay, Mode=OneWay}"
                                       Style="{StaticResource BodyLargeStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="calories" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tab strip -->
                    <Grid Background="{ThemeResource SurfaceVariantColor}" CornerRadius="12" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.SetTabCommand}" CommandParameter="Ingredients"
                                HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="40">
                            <TextBlock Text="Ingredients" FontWeight="SemiBold"/>
                        </Button>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.SetTabCommand}" CommandParameter="Steps"
                                HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="40">
                            <TextBlock Text="Steps" FontWeight="SemiBold"/>
                        </Button>
                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.SetTabCommand}" CommandParameter="Reviews"
                                HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="40">
                            <TextBlock Text="Reviews" FontWeight="SemiBold"/>
                        </Button>
                        <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.SetTabCommand}" CommandParameter="Nutrition"
                                HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="40">
                            <TextBlock Text="Nutrition" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>

                    <!-- Active tab indicator (subtle text) -->
                    <TextBlock Style="{StaticResource BodySecondaryStyle}">
                        <Run Text="Showing: "/><Run Text="{x:Bind ViewModel.ActiveTab, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- Tab content -->
                    <StackPanel Visibility="{x:Bind local:BindableHelpers.BoolToVisibility(ViewModel.ShowIngredients), Mode=OneWay}"
                                Spacing="12">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Ingredients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:IngredientData">
                                    <Border Style="{StaticResource RecipeCardStyle}" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                                                    Background="{ThemeResource SurfaceVariantColor}">
                                                <Image Source="{x:Bind UrlIcon}" Width="28" Height="28"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource BodyLargeStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Quantity}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource BodySecondaryStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{x:Bind local:BindableHelpers.BoolToVisibility(ViewModel.ShowSteps), Mode=OneWay}"
                                Spacing="12">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StepData">
                                    <Border Style="{StaticResource RecipeCardStyle}" Padding="14" Margin="0,0,0,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock>
                                                <Run Text="Step "/><Run Text="{x:Bind Number}"/><Run Text=": "/><Run Text="{x:Bind Name}"/>
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource BodySecondaryStyle}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{x:Bind local:BindableHelpers.BoolToVisibility(ViewModel.ShowReviews), Mode=OneWay}"
                                Spacing="12">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Reviews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ReviewData">
                                    <Border Style="{StaticResource RecipeCardStyle}" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                    VerticalAlignment="Top">
                                                <Image Source="{x:Bind UrlAuthorImage}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
                                                <TextBlock Text="{x:Bind PublisherName}"
                                                           Style="{StaticResource BodyLargeStyle}"/>
                                                <TextBlock Text="{x:Bind Description}"
                                                           Style="{StaticResource BodySecondaryStyle}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Visibility="{x:Bind local:BindableHelpers.CountToEmpty(ViewModel.Reviews.Count), Mode=OneWay}"
                                   Text="No reviews yet"
                                   Style="{StaticResource BodySecondaryStyle}" HorizontalAlignment="Center"
                                   Padding="0,16,0,16"/>
                    </StackPanel>

                    <StackPanel Visibility="{x:Bind local:BindableHelpers.BoolToVisibility(ViewModel.ShowNutrition), Mode=OneWay}"
                                Spacing="14">
                        <Border Style="{StaticResource RecipeCardStyle}" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Protein" Style="{StaticResource BodyLargeStyle}"/>
                                    <ProgressBar Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                                 Foreground="{ThemeResource PrimaryBrush}"
                                                 Maximum="{x:Bind ViewModel.Nutrition.ProteinBase, Mode=OneWay}"
                                                 Value="{x:Bind ViewModel.Nutrition.Protein, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource BodySecondaryStyle}">
                                        <Run Text="{x:Bind ViewModel.Nutrition.Protein, Mode=OneWay}"/><Run Text=" g"/>
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Carbs" Style="{StaticResource BodyLargeStyle}"/>
                                    <ProgressBar Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                                 Foreground="{ThemeResource PrimaryBrush}"
                                                 Maximum="{x:Bind ViewModel.Nutrition.CarbsBase, Mode=OneWay}"
                                                 Value="{x:Bind ViewModel.Nutrition.Carbs, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource BodySecondaryStyle}">
                                        <Run Text="{x:Bind ViewModel.Nutrition.Carbs, Mode=OneWay}"/><Run Text=" g"/>
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Fat" Style="{StaticResource BodyLargeStyle}"/>
                                    <ProgressBar Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                                 Foreground="{ThemeResource PrimaryBrush}"
                                                 Maximum="{x:Bind ViewModel.Nutrition.FatBase, Mode=OneWay}"
                                                 Value="{x:Bind ViewModel.Nutrition.Fat, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource BodySecondaryStyle}">
                                        <Run Text="{x:Bind ViewModel.Nutrition.Fat, Mode=OneWay}"/><Run Text=" g"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12,20,16" Background="{ThemeResource ScreenBackgroundBrush}">
            <Button Style="{StaticResource PrimaryCtaButtonStyle}"
                    Command="{x:Bind ViewModel.StartCookingCommand}">
                <TextBlock Text="Start Cooking!"/>
            </Button>
        </Border>
    </Grid>
</Page>
