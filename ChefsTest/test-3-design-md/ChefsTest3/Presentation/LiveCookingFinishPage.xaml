<Page x:Class="ChefsTest3.Presentation.LiveCookingFinishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      Background="{ThemeResource ScreenBackgroundBrush}">
    <Grid Padding="24,40,24,40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" MaxWidth="400">
            <Image Source="ms-appx:///Assets/Images/success_light.svg" Width="200" Height="200"/>
            <TextBlock Text="Hurray!" Style="{StaticResource H1Style}"
                       FontSize="32" TextAlignment="Center"/>
            <TextBlock Text="You finished cooking. How was the recipe?"
                       Style="{StaticResource BodySecondaryStyle}"
                       TextAlignment="Center" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Button Background="Transparent" BorderThickness="0" Padding="6"
                        Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="1">
                    <TextBlock Text="★" FontSize="32" Foreground="{ThemeResource PrimaryBrush}"/>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Padding="6"
                        Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="2">
                    <TextBlock Text="★" FontSize="32" Foreground="{ThemeResource PrimaryBrush}"/>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Padding="6"
                        Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="3">
                    <TextBlock Text="★" FontSize="32" Foreground="{ThemeResource PrimaryBrush}"/>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Padding="6"
                        Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="4">
                    <TextBlock Text="★" FontSize="32" Foreground="{ThemeResource PrimaryBrush}"/>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Padding="6"
                        Command="{x:Bind ViewModel.SetRatingCommand}" CommandParameter="5">
                    <TextBlock Text="☆" FontSize="32" Foreground="{ThemeResource TextTertiaryBrush}"/>
                </Button>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.Rating, Mode=OneWay}"
                       Style="{StaticResource BodySecondaryStyle}" HorizontalAlignment="Center"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SecondaryCtaButtonStyle}"
                        Command="{x:Bind ViewModel.PreviousCommand}">
                    <TextBlock Text="Previous"/>
                </Button>
                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PrimaryCtaButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}">
                    <TextBlock Text="{x:Bind local:BindableHelpers.Heart(ViewModel.IsFavorite), Mode=OneWay}" Padding="0,0,8,0"/>
                </Button>
            </Grid>

            <HyperlinkButton Command="{x:Bind ViewModel.GoHomeCommand}"
                             Foreground="{ThemeResource TextSecondaryBrush}"
                             HorizontalAlignment="Center">
                <TextBlock Text="Done — back to Home" FontWeight="SemiBold"/>
            </HyperlinkButton>
        </StackPanel>
    </Grid>
</Page>
