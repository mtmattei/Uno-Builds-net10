<Page x:Class="ChefsTest3.Presentation.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      xmlns:models="using:ChefsTest3.Models"
      Background="{ThemeResource ScreenBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Inverted top app bar -->
        <Grid Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}"
              Padding="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                           Foreground="{ThemeResource AppBarMutedBrush}"
                           FontSize="12"/>
                <TextBlock Foreground="{ThemeResource AppBarForegroundBrush}"
                           FontWeight="Bold" FontSize="20">
                    <Run Text="Hi, "/><Run Text="{x:Bind ViewModel.UserName, Mode=OneWay}"/><Run Text=" 👋"/>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AppBarIconButtonStyle}"
                    Command="{x:Bind ViewModel.OpenNotificationsCommand}">
                <TextBlock Text="🔔" FontSize="18"/>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource AppBarIconButtonStyle}"
                    Command="{x:Bind ViewModel.OpenProfileCommand}">
                <TextBlock Text="👤" FontSize="18"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,20">
            <StackPanel Spacing="24" Padding="20,20,20,16">

                <!-- Search bar pill -->
                <Grid>
                    <TextBox PlaceholderText="🔍  Search recipes..."
                             Style="{StaticResource SearchBarStyle}"
                             IsReadOnly="True"
                             GotFocus="OnSearchFocus"
                             Tapped="OnSearchTapped"/>
                </Grid>

                <!-- Trending Now -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Trending Now" Style="{StaticResource H2Style}"/>
                        <HyperlinkButton Grid.Column="1"
                                         Command="{x:Bind ViewModel.OpenSearchCommand}"
                                         Foreground="{ThemeResource PrimaryBrush}">
                            <TextBlock Text="See all" FontWeight="SemiBold" FontSize="13"/>
                        </HyperlinkButton>
                    </Grid>
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TrendingRecipes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RecipeData">
                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                            Click="OnTrendingRecipeClick" Tag="{x:Bind}">
                                        <Border Style="{StaticResource RecipeCardStyle}" Width="200">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="140"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" CornerRadius="12,12,0,0">
                                                    <Grid>
                                                        <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Margin="0,8,8,0"
                                                                Background="#80000000" CornerRadius="14"
                                                                Padding="8,4">
                                                            <TextBlock Text="♥" FontSize="14" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="4">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{StaticResource BodyLargeStyle}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{x:Bind Calories}"
                                                               Style="{StaticResource CaptionStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Categories -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Categories" Style="{StaticResource H2Style}"/>
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryData">
                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                            Click="OnCategoryClick" Tag="{x:Bind}">
                                        <StackPanel Width="92" Spacing="6">
                                            <Border Width="72" Height="72" CornerRadius="36"
                                                    Background="{ThemeResource PrimarySoftBrush}"
                                                    HorizontalAlignment="Center">
                                                <Image Source="{x:Bind UrlIcon}" Width="44" Height="44"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyRegularStyle}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Recently Added -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Recently Added" Style="{StaticResource H2Style}"/>
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentlyAdded}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RecipeData">
                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                            Click="OnTrendingRecipeClick" Tag="{x:Bind}">
                                        <Border Style="{StaticResource RecipeCardStyle}" Width="180">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="120"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" CornerRadius="12,12,0,0">
                                                    <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="4">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{StaticResource BodyLargeStyle}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{x:Bind Calories}"
                                                               Style="{StaticResource CaptionStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Popular Contributors -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Popular Contributors" Style="{StaticResource H2Style}"/>
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PopularContributors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:UserData">
                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                            Click="OnContributorClick" Tag="{x:Bind}">
                                        <StackPanel Width="100" Spacing="6">
                                            <Border Width="72" Height="72" CornerRadius="36">
                                                <Image Source="{x:Bind UrlProfileImage}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind FullName}"
                                                       Style="{StaticResource BodyRegularStyle}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       HorizontalAlignment="Center">
                                                <Run Text="{x:Bind Recipes}"/><Run Text=" recipes"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Near me link -->
                <HyperlinkButton Command="{x:Bind ViewModel.OpenNearMeCommand}"
                                 Foreground="{ThemeResource PrimaryBrush}"
                                 HorizontalAlignment="Stretch">
                    <TextBlock Text="📍  Discover chefs near me" FontWeight="SemiBold"/>
                </HyperlinkButton>
            </StackPanel>
        </ScrollViewer>

        <local:BottomNavBar Grid.Row="2" ActiveTab="Home" TabSelected="OnTabSelected"/>
    </Grid>
</Page>
