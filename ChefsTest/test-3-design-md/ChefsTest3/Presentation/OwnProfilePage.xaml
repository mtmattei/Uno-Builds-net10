<Page x:Class="ChefsTest3.Presentation.OwnProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      xmlns:models="using:ChefsTest3.Models"
      Background="{ThemeResource ScreenBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}"
              Padding="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource AppBarIconButtonStyle}"
                    Command="{x:Bind ViewModel.GoBackCommand}">
                <TextBlock Text="‹" FontSize="22"/>
            </Button>
            <TextBlock Grid.Column="1" Text="Profile"
                       Foreground="{ThemeResource AppBarForegroundBrush}"
                       FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button Grid.Column="2" Style="{StaticResource AppBarIconButtonStyle}"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}">
                <TextBlock Text="⚙" FontSize="18"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,20,20,20">
            <StackPanel Spacing="20">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <Border Width="96" Height="96" CornerRadius="48"
                            HorizontalAlignment="Center">
                        <Image Source="{x:Bind ViewModel.User.UrlProfileImage, Mode=OneWay}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.User.FullName, Mode=OneWay}"
                               Style="{StaticResource H1Style}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.User.Description, Mode=OneWay}"
                               Style="{StaticResource BodySecondaryStyle}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.User.Recipes, Mode=OneWay}"
                                   Style="{StaticResource H2Style}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Recipes" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.User.Followers, Mode=OneWay}"
                                   Style="{StaticResource H2Style}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Followers" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.User.Following, Mode=OneWay}"
                                   Style="{StaticResource H2Style}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Following" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="My Recipes" Style="{StaticResource H2Style}"/>

                <Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.MyRecipes}"
                                  Visibility="{x:Bind local:BindableHelpers.BoolToVisibility(ViewModel.HasRecipes), Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                               ItemWidth="170"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeData">
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12"
                                        Click="OnRecipeClick" Tag="{x:Bind}">
                                    <Border Style="{StaticResource RecipeCardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="12,12,0,0">
                                                <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="4">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource BodyLargeStyle}"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{x:Bind Calories}"
                                                           Style="{StaticResource CaptionStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{x:Bind local:BindableHelpers.BoolToCollapsed(ViewModel.HasRecipes), Mode=OneWay}"
                                HorizontalAlignment="Center" Spacing="14" Padding="16">
                        <Image Source="ms-appx:///Assets/Images/empty_recipe_light.svg" Width="140" Height="140"/>
                        <TextBlock Text="No recipes yet" Style="{StaticResource H2Style}" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Button Style="{StaticResource PrimaryCtaButtonStyle}"
                        Command="{x:Bind ViewModel.CreateRecipeCommand}">
                    <TextBlock Text="+ Create"/>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
