<Page x:Class="ChefsTest3.Presentation.OnboardingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      Background="{ThemeResource ScreenBackgroundBrush}">
    <Grid Padding="24,40,24,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <FlipView x:Name="OnboardingFlipView"
                  Grid.Row="0"
                  ItemsSource="{x:Bind ViewModel.Frames}"
                  SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                  Background="Transparent">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="local:OnboardingFrame">
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="20"
                                Background="{ThemeResource SurfaceVariantColor}"
                                Margin="0,0,0,24">
                            <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{x:Bind Title}" Style="{StaticResource H1Style}"
                                   TextAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="2" Text="{x:Bind Description}"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <PipsPager Grid.Row="1"
                   Margin="0,16,0,16"
                   NumberOfPages="{x:Bind ViewModel.Frames.Count}"
                   SelectedPageIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                   HorizontalAlignment="Center"/>

        <Button Grid.Row="2"
                Command="{x:Bind ViewModel.NextCommand}"
                Style="{StaticResource PrimaryCtaButtonStyle}"
                Margin="0,0,0,12">
            <TextBlock Text="Next"/>
        </Button>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
            <HyperlinkButton Command="{x:Bind ViewModel.PreviousCommand}"
                             Foreground="{ThemeResource TextSecondaryBrush}">
                <TextBlock Text="Previous" FontWeight="SemiBold"/>
            </HyperlinkButton>
            <HyperlinkButton Command="{x:Bind ViewModel.SkipCommand}"
                             Foreground="{ThemeResource PrimaryBrush}">
                <TextBlock Text="Skip" FontWeight="SemiBold"/>
            </HyperlinkButton>
        </StackPanel>
    </Grid>
</Page>
