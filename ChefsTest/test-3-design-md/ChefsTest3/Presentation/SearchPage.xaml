<Page x:Class="ChefsTest3.Presentation.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      xmlns:models="using:ChefsTest3.Models"
      Background="{ThemeResource ScreenBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}"
              Padding="20,16,20,16">
            <TextBlock Text="Search"
                       Foreground="{ThemeResource AppBarForegroundBrush}"
                       FontSize="20" FontWeight="Bold"/>
        </Grid>

        <Grid Grid.Row="1" Padding="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" PlaceholderText="🔍  Search recipes..."
                     Style="{StaticResource SearchBarStyle}"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Margin="12,0,0,0"
                    Style="{StaticResource AppBarIconButtonStyle}"
                    Background="{ThemeResource SurfaceVariantColor}"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Command="{x:Bind ViewModel.OpenFiltersCommand}">
                <TextBlock Text="⚙" FontSize="18"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2" Padding="20,4,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource BodySecondaryStyle}">
                <Run Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}"/><Run Text=" recipes"/>
            </TextBlock>
            <HyperlinkButton Grid.Column="1" Command="{x:Bind ViewModel.OpenFiltersCommand}"
                             Foreground="{ThemeResource PrimaryBrush}">
                <TextBlock Text="Filters" FontWeight="SemiBold"/>
            </HyperlinkButton>
        </Grid>

        <Grid Grid.Row="3">
            <ScrollViewer Visibility="{x:Bind local:BindableHelpers.BoolToVisibility(ViewModel.HasResults), Mode=OneWay}"
                          Padding="20,0,20,16">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Results}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                           ItemWidth="170"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RecipeData">
                            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12"
                                    Click="OnRecipeClick" Tag="{x:Bind}">
                                <Border Style="{StaticResource RecipeCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="120"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="12,12,0,0">
                                            <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="4">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyLargeStyle}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind Calories}"
                                                       Style="{StaticResource CaptionStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Visibility="{x:Bind local:BindableHelpers.BoolToCollapsed(ViewModel.HasResults), Mode=OneWay}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="14" Padding="32">
                <Image Source="ms-appx:///Assets/Images/empty_recipe_light.svg" Width="160" Height="160"/>
                <TextBlock Text="No results" Style="{StaticResource H2Style}" TextAlignment="Center"/>
                <TextBlock Text="Try a different search term or adjust your filters."
                           Style="{StaticResource BodySecondaryStyle}" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="280"/>
            </StackPanel>
        </Grid>

        <local:BottomNavBar Grid.Row="4" ActiveTab="Search" TabSelected="OnTabSelected"/>
    </Grid>
</Page>
