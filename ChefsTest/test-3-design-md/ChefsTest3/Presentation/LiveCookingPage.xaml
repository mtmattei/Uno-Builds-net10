<Page x:Class="ChefsTest3.Presentation.LiveCookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      xmlns:models="using:ChefsTest3.Models"
      Background="{ThemeResource ScreenBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}"
              Padding="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource AppBarIconButtonStyle}"
                    Command="{x:Bind ViewModel.GoBackCommand}">
                <TextBlock Text="‹" FontSize="22"/>
            </Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}"
                       Foreground="{ThemeResource AppBarForegroundBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Padding="0,0,0,16">
                <!-- Video player surrogate (DESIGN.md §gap 5: media overlay unspecified) -->
                <Border Height="220" Background="#202020">
                    <Grid>
                        <Image Source="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.7"/>
                        <Border Background="#80000000" Width="64" Height="64" CornerRadius="32"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▶" FontSize="28" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border VerticalAlignment="Bottom" Padding="14,10"
                                Background="#90000000">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="0:32" Foreground="White" FontSize="12"/>
                                <ProgressBar Grid.Column="1" Margin="10,0" Value="32" Maximum="120"
                                             Foreground="{ThemeResource PrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="2:00" Foreground="White" FontSize="12"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Padding="20,0,20,0" Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.StepLabel, Mode=OneWay}" Style="{StaticResource CaptionStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.CurrentStep.Name, Mode=OneWay}"
                               Style="{StaticResource H1Style}" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource RecipeCardStyle}" Padding="16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Ingredients for this step" Style="{StaticResource BodyLargeStyle}"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentStep.Ingredients, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <CheckBox Content="{x:Bind}" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Height="1" Fill="{ThemeResource DividerBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentStep.Description, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StepData">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource DividerBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="20,12,20,16" Background="{ThemeResource ScreenBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SecondaryCtaButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                    Command="{x:Bind ViewModel.PreviousCommand}">
                <TextBlock Text="Previous"/>
            </Button>
            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PrimaryCtaButtonStyle}"
                    Command="{x:Bind ViewModel.NextCommand}">
                <TextBlock Text="Next"/>
            </Button>
        </Grid>
    </Grid>
</Page>
