<Page x:Class="ChefsTest3.Presentation.CreateCookbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      xmlns:models="using:ChefsTest3.Models"
      Background="{ThemeResource ScreenBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}"
              Padding="20,16,20,16">
            <TextBlock Text="Create Cookbook"
                       Foreground="{ThemeResource AppBarForegroundBrush}"
                       FontSize="18" FontWeight="Bold"/>
        </Grid>

        <StackPanel Grid.Row="1" Padding="20,16,20,8" Spacing="8">
            <TextBlock Text="Cookbook name" Style="{StaticResource BodySecondaryStyle}"/>
            <TextBox PlaceholderText="My favorites…" Style="{StaticResource FormInputStyle}"
                     Text="{x:Bind ViewModel.Name, Mode=TwoWay}"/>
            <TextBlock Text="Pick recipes" Style="{StaticResource H2Style}" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="20,8,20,8">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Recipes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                       ItemWidth="170"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:RecipeSelection">
                        <Border Style="{StaticResource RecipeCardStyle}" Margin="0,0,12,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Border CornerRadius="12,12,0,0">
                                        <Image Source="{x:Bind Recipe.ImageUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Top"
                                                  Margin="0,8,8,0"
                                                  Background="#80000000"
                                                  CornerRadius="14"
                                                  Padding="8,4"
                                                  BorderThickness="0"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                        <TextBlock Text="♥" FontSize="14" Foreground="{ThemeResource FavoriteBrush}"/>
                                    </ToggleButton>
                                </Grid>
                                <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="4">
                                    <TextBlock Text="{x:Bind Recipe.Name}"
                                               Style="{StaticResource BodyLargeStyle}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    <TextBlock Text="{x:Bind Recipe.Calories}"
                                               Style="{StaticResource CaptionStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Padding="20,12,20,16" Background="{ThemeResource ScreenBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SecondaryCtaButtonStyle}"
                    Command="{x:Bind ViewModel.CancelCommand}">
                <TextBlock Text="Cancel"/>
            </Button>
            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PrimaryCtaButtonStyle}"
                    Command="{x:Bind ViewModel.CreateCommand}">
                <TextBlock Text="Create cookbook"/>
            </Button>
        </Grid>
    </Grid>
</Page>
