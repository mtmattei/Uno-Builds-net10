<Page x:Class="ChefsTest3.Presentation.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      xmlns:models="using:ChefsTest3.Models"
      Background="{ThemeResource ScreenBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}"
              Padding="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource SocialLoginBackgroundBrush}"
                    CornerRadius="20">
                <Button Style="{StaticResource AppBarIconButtonStyle}"
                        Foreground="{ThemeResource SocialLoginForegroundBrush}"
                        Command="{x:Bind ViewModel.CloseCommand}">
                    <TextBlock Text="✕" FontSize="18"/>
                </Button>
            </Border>
            <TextBlock Grid.Column="1" Text="Notifications"
                       Foreground="{ThemeResource AppBarForegroundBrush}"
                       FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Background="{ThemeResource SurfaceVariantColor}" CornerRadius="12"
              Margin="20,16,20,8" Padding="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="40"
                    Command="{x:Bind ViewModel.FilterCommand}" CommandParameter="All">
                <TextBlock Text="All" FontWeight="SemiBold"/>
            </Button>
            <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="40"
                    Command="{x:Bind ViewModel.FilterCommand}" CommandParameter="Unread">
                <TextBlock Text="Unread" FontWeight="SemiBold"/>
            </Button>
            <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" CornerRadius="10" MinHeight="40"
                    Command="{x:Bind ViewModel.FilterCommand}" CommandParameter="Read">
                <TextBlock Text="Read" FontWeight="SemiBold"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer Visibility="{x:Bind local:BindableHelpers.BoolToVisibility(ViewModel.HasItems), Mode=OneWay}"
                          Padding="20,8,20,16">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationData">
                            <Border Style="{StaticResource RecipeCardStyle}" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                            Background="{ThemeResource PrimarySoftBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="🔔" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" Spacing="4">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource BodyLargeStyle}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource BodySecondaryStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind local:BindableHelpers.FormatRelativeDate(Date)}"
                                               Style="{StaticResource CaptionStyle}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Visibility="{x:Bind local:BindableHelpers.BoolToCollapsed(ViewModel.HasItems), Mode=OneWay}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="14" Padding="32">
                <Image Source="ms-appx:///Assets/Images/empty_notification_light.svg" Width="160" Height="160"/>
                <TextBlock Text="No notifications" Style="{StaticResource H2Style}" TextAlignment="Center"/>
                <TextBlock Text="You're all caught up."
                           Style="{StaticResource BodySecondaryStyle}" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
