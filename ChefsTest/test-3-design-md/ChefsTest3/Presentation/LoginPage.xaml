<Page x:Class="ChefsTest3.Presentation.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      Background="{ThemeResource ScreenBackgroundBrush}">

    <ScrollViewer>
        <Grid Padding="24,40,24,40" RowSpacing="20" MaxWidth="480" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand mark -->
            <Border Grid.Row="0" Width="72" Height="72" CornerRadius="16"
                    Background="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center"
                    Margin="0,16,0,16">
                <TextBlock Text="UC" Foreground="White" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="1" Text="Welcome back" Style="{StaticResource H1Style}" TextAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Sign in to continue cooking with UnoChefs"
                       Style="{StaticResource BodySecondaryStyle}" TextAlignment="Center"/>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBox PlaceholderText="Email or username"
                         Style="{StaticResource FormInputStyle}"
                         Text="{x:Bind ViewModel.Email, Mode=TwoWay}"/>
            </Grid>

            <Grid Grid.Row="4">
                <PasswordBox PlaceholderText="Password"
                             Style="{StaticResource FormPasswordStyle}"
                             Password="{x:Bind ViewModel.Password, Mode=TwoWay}"/>
            </Grid>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Remember me"
                          IsChecked="{x:Bind ViewModel.RememberMe, Mode=TwoWay}"
                          Foreground="{ThemeResource TextSecondaryBrush}"/>
                <HyperlinkButton Grid.Column="1" Command="{x:Bind ViewModel.ForgotPasswordCommand}"
                                 Foreground="{ThemeResource PrimaryBrush}">
                    <TextBlock Text="Forgot password?" FontWeight="SemiBold"/>
                </HyperlinkButton>
            </Grid>

            <Button Grid.Row="6" Command="{x:Bind ViewModel.LoginCommand}"
                    Style="{StaticResource PrimaryCtaButtonStyle}">
                <TextBlock Text="Login"/>
            </Button>

            <Grid Grid.Row="7" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="or" Margin="12,0" Style="{StaticResource CaptionStyle}"/>
                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource DividerBrush}" VerticalAlignment="Center"/>
            </Grid>

            <Button Grid.Row="8" Command="{x:Bind ViewModel.AppleCommand}"
                    Style="{StaticResource SocialLoginButtonStyle}">
                <TextBlock Text="🍎  Continue with Apple"/>
            </Button>

            <Button Grid.Row="9" Command="{x:Bind ViewModel.GoogleCommand}"
                    Style="{StaticResource SocialLoginButtonStyle}">
                <TextBlock Text="G  Continue with Google"/>
            </Button>

            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,16,0,0" Spacing="6">
                <TextBlock Text="New here?" Style="{StaticResource BodySecondaryStyle}"/>
                <HyperlinkButton Command="{x:Bind ViewModel.RegisterCommand}"
                                 Foreground="{ThemeResource PrimaryBrush}">
                    <TextBlock Text="Create an account" FontWeight="SemiBold"/>
                </HyperlinkButton>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
