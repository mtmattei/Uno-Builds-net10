<Page x:Class="ChefsTest3.Presentation.FavoritesAllRecipesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest3.Presentation"
      xmlns:models="using:ChefsTest3.Models"
      Background="{ThemeResource ScreenBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}"
              Padding="20,16,20,16">
            <TextBlock Text="Favorites"
                       Foreground="{ThemeResource AppBarForegroundBrush}"
                       FontSize="20" FontWeight="Bold"/>
        </Grid>

        <!-- Segmented control: All Recipes / My Cookbooks -->
        <Grid Grid.Row="1" Background="{ThemeResource SurfaceVariantColor}" CornerRadius="12"
              Margin="20,16,20,8" Padding="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="{ThemeResource PrimaryBrush}"
                    Foreground="{ThemeResource TextOnPrimaryBrush}"
                    BorderThickness="0" CornerRadius="10" MinHeight="40"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="All Recipes" FontWeight="SemiBold"/>
            </Button>
            <Button Grid.Column="1" Background="Transparent"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    BorderThickness="0" CornerRadius="10" MinHeight="40"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.GoToCookbooksCommand}">
                <TextBlock Text="My Cookbooks" FontWeight="SemiBold"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer Visibility="{x:Bind local:BindableHelpers.BoolToVisibility(ViewModel.HasItems), Mode=OneWay}"
                          Padding="20,8,20,16">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Recipes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2"
                                           ItemWidth="170"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RecipeData">
                            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12"
                                    Click="OnRecipeClick" Tag="{x:Bind}">
                                <Border Style="{StaticResource RecipeCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="120"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="12,12,0,0">
                                            <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="4">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyLargeStyle}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{x:Bind Calories}"
                                                       Style="{StaticResource CaptionStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Visibility="{x:Bind local:BindableHelpers.BoolToCollapsed(ViewModel.HasItems), Mode=OneWay}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="14" Padding="32">
                <Image Source="ms-appx:///Assets/Images/empty_recipe_light.svg" Width="160" Height="160"/>
                <TextBlock Text="No favorites yet" Style="{StaticResource H2Style}" TextAlignment="Center"/>
                <TextBlock Text="Save recipes to find them here later."
                           Style="{StaticResource BodySecondaryStyle}" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="280"/>
            </StackPanel>
        </Grid>

        <local:BottomNavBar Grid.Row="3" ActiveTab="Favorites" TabSelected="OnTabSelected"/>
    </Grid>
</Page>
