<UserControl x:Class="ChefsTest6.Presentation.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ChefsTest6.Presentation"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
             xmlns:models="using:ChefsTest6.Models"
             d:DesignHeight="800"
             d:DesignWidth="400"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />

    <DataTemplate x:Key="MyRecipeTemplate" x:DataType="models:Recipe">
      <Button Padding="0" Margin="6"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Background="{ThemeResource SurfaceContainerLowBrush}"
              BorderThickness="0"
              CornerRadius="12"
              Click="OnRecipeClicked">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
          <StackPanel Grid.Row="1" Padding="10,8,10,10">
            <TextBlock Text="{x:Bind Name}"
                       Style="{ThemeResource TitleSmallTextBlockStyle}"
                       TextWrapping="Wrap"
                       MaxLines="2" />
            <TextBlock Text="{x:Bind CookTimeText}"
                       Style="{ThemeResource BodySmallTextBlockStyle}"
                       Opacity="0.7" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Grid Padding="16,12,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Ellipse Width="80" Height="80">
        <Ellipse.Fill>
          <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
        </Ellipse.Fill>
      </Ellipse>
      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding FullName}"
                   Style="{ThemeResource TitleMediumTextBlockStyle}" />
        <TextBlock Text="Passionate about food and life"
                   Opacity="0.7"
                   Style="{ThemeResource BodyMediumTextBlockStyle}" />
      </StackPanel>
      <Button Grid.Column="2"
              Style="{ThemeResource OutlinedButtonStyle}"
              Command="{Binding OpenSettingsCommand}"
              Content="Settings"
              AutomationProperties.AutomationId="OpenSettings"
              VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" Padding="16,4,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="{Binding RecipesAuthoredText}"
                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Recipes" Opacity="0.7" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center">
        <TextBlock Text="{Binding FollowersText}"
                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Followers" Opacity="0.7" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Center">
        <TextBlock Text="{Binding FollowingText}"
                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Following" Opacity="0.7" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <StackPanel Padding="16,16,16,8">
        <TextBlock Text="My Recipes" Style="{ThemeResource TitleMediumTextBlockStyle}" />
        <TextBlock Text="{Binding MyRecipesCountText}" Opacity="0.7" />
      </StackPanel>
      <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
            VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
          <TextBlock Text="🍽" FontSize="48" HorizontalAlignment="Center" />
          <TextBlock Text="No recipes yet"
                     Style="{ThemeResource TitleMediumTextBlockStyle}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Recipes you publish will appear here."
                     Opacity="0.7"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
      <ScrollViewer Padding="8,72,8,16"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
        <muxc:ItemsRepeater ItemsSource="{Binding MyRecipes}"
                            ItemTemplate="{StaticResource MyRecipeTemplate}">
          <muxc:ItemsRepeater.Layout>
            <muxc:UniformGridLayout MinItemWidth="200" MinItemHeight="200"
                                    MinRowSpacing="0" MinColumnSpacing="0" />
          </muxc:ItemsRepeater.Layout>
        </muxc:ItemsRepeater>
      </ScrollViewer>
      <Button Style="{ThemeResource ElevatedButtonStyle}"
              Content="+ New Cookbook"
              Command="{Binding CreateCookbookCommand}"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,16,16" />
    </Grid>
  </Grid>
</UserControl>
