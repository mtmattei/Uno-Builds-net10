<Page x:Class="ChefsTest6.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest6.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <local:NotNullToVisibilityConverter x:Key="NotNullToVis" />
  </Page.Resources>
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="Settings">
      <utu:NavigationBar.MainCommand>
        <AppBarButton Icon="Back" Command="{Binding BackCommand}" />
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16,8,16,16" Spacing="20" MaxWidth="600" HorizontalAlignment="Stretch">
        <TextBlock Text="Personal Information" Style="{ThemeResource TitleMediumTextBlockStyle}" />
        <TextBox Header="Name"
                 Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Header="Email"
                 InputScope="EmailSmtpAddress"
                 Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Header="Mobile Number"
                 InputScope="TelephoneNumber"
                 Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Application Settings" Style="{ThemeResource TitleMediumTextBlockStyle}" />
        <ToggleSwitch Header="Notifications"
                      IsOn="{Binding NotificationsEnabled, Mode=TwoWay}"
                      OffContent="Off"
                      OnContent="On" />
        <ToggleSwitch Header="Night Mode"
                      IsOn="{Binding NightMode, Mode=TwoWay}"
                      OffContent="Light"
                      OnContent="Dark"
                      AutomationProperties.AutomationId="NightModeToggle" />

        <TextBlock Text="{Binding StatusMessage}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVis}}" />

        <Button Content="Save Changes"
                Command="{Binding SaveCommand}"
                Style="{ThemeResource ElevatedButtonStyle}"
                HorizontalAlignment="Stretch" />

        <Button Content="Log out"
                Command="{Binding LogoutCommand}"
                Style="{ThemeResource OutlinedButtonStyle}"
                HorizontalAlignment="Stretch" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
