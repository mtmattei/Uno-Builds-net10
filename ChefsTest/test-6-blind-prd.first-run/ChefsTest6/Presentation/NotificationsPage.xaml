<Page x:Class="ChefsTest6.Presentation.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest6.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:models="using:ChefsTest6.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />

    <DataTemplate x:Key="GroupTemplate" x:DataType="local:NotificationGroup">
      <StackPanel Spacing="6" Padding="0,8,0,8">
        <TextBlock Text="{x:Bind Header}"
                   Style="{ThemeResource LabelLargeTextBlockStyle}"
                   Opacity="0.7" />
        <ItemsControl ItemsSource="{x:Bind Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Notification">
              <Grid Margin="0,4,0,4"
                    Padding="12"
                    CornerRadius="12"
                    Background="{ThemeResource SurfaceContainerLowBrush}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SymbolIcon Symbol="Mail" />
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                  <TextBlock Text="{x:Bind Title}"
                             Style="{ThemeResource TitleSmallTextBlockStyle}" />
                  <TextBlock Text="{x:Bind Description}"
                             TextWrapping="Wrap"
                             Opacity="0.8"
                             Style="{ThemeResource BodyMediumTextBlockStyle}" />
                </StackPanel>
                <Ellipse Grid.Column="2"
                         Width="8" Height="8"
                         Fill="{ThemeResource PrimaryBrush}"
                         VerticalAlignment="Top"
                         Visibility="{x:Bind IsRead, Mode=OneWay, Converter={StaticResource InvBoolToVis}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Grid Padding="16,12,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Notifications"
                 Style="{ThemeResource HeadlineSmallTextBlockStyle}" />
      <Button Grid.Column="1"
              Style="{ThemeResource TextButtonStyle}"
              Command="{Binding CloseCommand}"
              AutomationProperties.AutomationId="CloseNotifications">
        <SymbolIcon Symbol="Cancel" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Padding="16,0,16,8" Spacing="8">
      <Button Content="All"
              Command="{Binding SelectAllCommand}"
              Style="{ThemeResource OutlinedButtonStyle}" />
      <Button Content="Unread"
              Command="{Binding SelectUnreadCommand}"
              Style="{ThemeResource OutlinedButtonStyle}" />
      <Button Content="Read"
              Command="{Binding SelectReadCommand}"
              Style="{ThemeResource OutlinedButtonStyle}" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="🔔" FontSize="48" HorizontalAlignment="Center" />
          <TextBlock Text="Nothing new" HorizontalAlignment="Center"
                     Style="{ThemeResource TitleMediumTextBlockStyle}" />
        </StackPanel>
      </Grid>
      <ScrollViewer Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
        <ItemsControl ItemsSource="{Binding Groups}"
                      ItemTemplate="{StaticResource GroupTemplate}"
                      Padding="16,0,16,16" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
