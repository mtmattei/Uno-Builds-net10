<Page x:Class="ChefsTest6.Presentation.CreateCookbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest6.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:models="using:ChefsTest6.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="PickTemplate" x:DataType="local:CookbookRecipePick">
      <Grid Margin="6"
            CornerRadius="12"
            Background="{ThemeResource SurfaceContainerLowBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="120" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Image Source="{x:Bind Recipe.ImageUrl}" Stretch="UniformToFill" />
        <Border Grid.Row="0"
                Width="32" Height="32"
                CornerRadius="16"
                Background="{ThemeResource SurfaceBrush}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,8,0">
          <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Width="32" Height="32">
            <SymbolIcon Symbol="Favorite" />
          </ToggleButton>
        </Border>
        <StackPanel Grid.Row="1" Padding="8,6,8,10" Spacing="2">
          <TextBlock Text="{x:Bind Recipe.Name}"
                     Style="{ThemeResource TitleSmallTextBlockStyle}"
                     TextWrapping="Wrap"
                     MaxLines="2" />
          <TextBlock Text="{x:Bind Recipe.CookTimeText}"
                     Style="{ThemeResource BodySmallTextBlockStyle}"
                     Opacity="0.7" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="Create cookbook">
      <utu:NavigationBar.MainCommand>
        <AppBarButton Icon="Back" Command="{Binding BackCommand}" />
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <Grid Grid.Row="1" Padding="16,8,16,8">
      <TextBox Header="Cookbook name"
               Text="{Binding CookbookName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="e.g. Italian Favorites" />
    </Grid>

    <ScrollViewer Grid.Row="2" Padding="8,0,8,16">
      <muxc:ItemsRepeater ItemsSource="{Binding Picks}"
                          ItemTemplate="{StaticResource PickTemplate}">
        <muxc:ItemsRepeater.Layout>
          <muxc:UniformGridLayout MinItemWidth="200" MinItemHeight="200"
                                  MinRowSpacing="0" MinColumnSpacing="0" />
        </muxc:ItemsRepeater.Layout>
      </muxc:ItemsRepeater>
    </ScrollViewer>

    <Grid Grid.Row="3" Padding="16,8,16,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Content="Cancel"
              Command="{Binding CancelCommand}"
              Style="{ThemeResource OutlinedButtonStyle}"
              HorizontalAlignment="Stretch"
              Margin="0,0,8,0" />
      <Button Grid.Column="1"
              Content="Create cookbook"
              Command="{Binding CreateCommand}"
              IsEnabled="{Binding CanCreate}"
              Style="{ThemeResource ElevatedButtonStyle}"
              HorizontalAlignment="Stretch"
              Margin="8,0,0,0" />
    </Grid>
  </Grid>
</Page>
