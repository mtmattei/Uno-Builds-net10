<UserControl x:Class="ChefsTest6.Presentation.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ChefsTest6.Presentation"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:models="using:ChefsTest6.Models"
             d:DesignHeight="800"
             d:DesignWidth="400"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

  <UserControl.Resources>
    <DataTemplate x:Key="RecipeCardTemplate" x:DataType="models:Recipe">
      <Button Width="220"
              Margin="0,0,12,0"
              Padding="0"
              Background="{ThemeResource SurfaceContainerLowBrush}"
              BorderThickness="0"
              CornerRadius="12"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              Click="OnRecipeClicked">
        <Grid Padding="0,0,0,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Source="{x:Bind ImageUrl}"
                 Stretch="UniformToFill" />
          <Border Grid.Row="0"
                  Width="32" Height="32"
                  CornerRadius="16"
                  Background="{ThemeResource SurfaceBrush}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,8,8,0">
            <ToggleButton IsChecked="{x:Bind IsFavorite, Mode=TwoWay}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          MinWidth="0" MinHeight="0"
                          Width="32" Height="32">
              <SymbolIcon Symbol="Favorite" />
            </ToggleButton>
          </Border>
          <StackPanel Grid.Row="1"
                      Padding="12,8,12,0"
                      Spacing="2">
            <TextBlock Text="{x:Bind Name}"
                       Style="{ThemeResource TitleSmallTextBlockStyle}"
                       TextWrapping="Wrap"
                       MaxLines="2" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{x:Bind CookTimeText}"
                         Opacity="0.7"
                         Style="{ThemeResource BodySmallTextBlockStyle}" />
              <TextBlock Text="·" Opacity="0.5" />
              <TextBlock Text="{x:Bind Calories}"
                         Opacity="0.7"
                         Style="{ThemeResource BodySmallTextBlockStyle}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="CategoryChipTemplate" x:DataType="models:Category">
      <Button Width="120"
              Padding="12,10,12,10"
              Margin="0,0,8,0"
              CornerRadius="16"
              BorderThickness="0"
              Background="{ThemeResource SurfaceContainerLowBrush}"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              Click="OnCategoryClicked">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Source="{x:Bind UrlIcon}"
                 Width="48" Height="48"
                 Stretch="Uniform" />
          <TextBlock Grid.Row="1"
                     Text="{x:Bind Name}"
                     Style="{ThemeResource LabelLargeTextBlockStyle}"
                     HorizontalAlignment="Center"
                     Margin="0,8,0,0" />
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="ContributorTemplate" x:DataType="models:User">
      <Button Width="100"
              Padding="0"
              Margin="0,0,8,0"
              Background="Transparent"
              BorderThickness="0"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              Click="OnContributorClicked">
        <StackPanel Spacing="6">
          <Ellipse Width="64" Height="64">
            <Ellipse.Fill>
              <ImageBrush ImageSource="{x:Bind UrlProfileImage}"
                          Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock Text="{x:Bind FullName}"
                     Style="{ThemeResource LabelMediumTextBlockStyle}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxLines="2" />
          <TextBlock Text="{x:Bind Followers}"
                     Style="{ThemeResource BodySmallTextBlockStyle}"
                     HorizontalAlignment="Center"
                     Opacity="0.7" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Grid Padding="16,12,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Uno Chefs"
                   Style="{ThemeResource HeadlineSmallTextBlockStyle}" />
        <TextBlock Text="{Binding GreetingMessage}"
                   Style="{ThemeResource BodyMediumTextBlockStyle}"
                   Opacity="0.7" />
      </StackPanel>
      <Button Grid.Column="1"
              Style="{ThemeResource TextButtonStyle}"
              Command="{Binding OpenNotificationsCommand}"
              AutomationProperties.AutomationId="OpenNotifications">
        <SymbolIcon Symbol="Mail" />
      </Button>
      <Button Grid.Column="2"
              Style="{ThemeResource TextButtonStyle}"
              Command="{Binding GoToProfileCommand}"
              AutomationProperties.AutomationId="OpenProfile">
        <SymbolIcon Symbol="Contact" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20"
                  Padding="16,0,16,24">
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Trending Now"
                     Style="{ThemeResource TitleMediumTextBlockStyle}" />
          <HyperlinkButton Grid.Column="1"
                          Content="View all"
                          Command="{Binding GoToSearchCommand}" />
        </Grid>
        <ListView ItemsSource="{Binding Trending}"
                  ItemTemplate="{StaticResource RecipeCardTemplate}"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
            </Style>
          </ListView.ItemContainerStyle>
        </ListView>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Categories"
                     Style="{ThemeResource TitleMediumTextBlockStyle}" />
          <HyperlinkButton Grid.Column="1"
                          Content="Browse"
                          Command="{Binding GoToSearchCommand}" />
        </Grid>
        <ListView ItemsSource="{Binding Categories}"
                  ItemTemplate="{StaticResource CategoryChipTemplate}"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
        </ListView>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Recently Added"
                     Style="{ThemeResource TitleMediumTextBlockStyle}" />
          <HyperlinkButton Grid.Column="1"
                          Content="View all"
                          Command="{Binding GoToSearchCommand}" />
        </Grid>
        <ListView ItemsSource="{Binding RecentlyAdded}"
                  ItemTemplate="{StaticResource RecipeCardTemplate}"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
        </ListView>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Popular Contributors"
                     Style="{ThemeResource TitleMediumTextBlockStyle}" />
          <HyperlinkButton Grid.Column="1"
                          Content="Near me"
                          Command="{Binding OpenMapCommand}"
                          AutomationProperties.AutomationId="NearMe" />
        </Grid>
        <ListView ItemsSource="{Binding PopularContributors}"
                  ItemTemplate="{StaticResource ContributorTemplate}"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
        </ListView>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
