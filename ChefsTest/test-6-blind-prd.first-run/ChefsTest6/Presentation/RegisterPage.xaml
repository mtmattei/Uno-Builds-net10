<Page x:Class="ChefsTest6.Presentation.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest6.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <local:NotNullToVisibilityConverter x:Key="NotNullToVis" />
  </Page.Resources>
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <utu:NavigationBar Content="Create account">
      <utu:NavigationBar.MainCommand>
        <AppBarButton Icon="Back" Command="{Binding BackCommand}" />
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1">
      <Grid Padding="24,16,24,32"
            Width="{utu:Responsive Narrowest=320, Narrow=400, Normal=480, Wide=480, Widest=480}"
            HorizontalAlignment="Center">
        <StackPanel Spacing="20">
          <TextBox Header="Username"
                   Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Header="Email"
                   InputScope="EmailSmtpAddress"
                   Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <PasswordBox Header="Password"
                       Password="{Binding Password, Mode=TwoWay}" />

          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                     Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}"
                     TextWrapping="Wrap" />

          <Button Content="Sign up"
                  Command="{Binding SignUpCommand}"
                  Style="{ThemeResource ElevatedButtonStyle}"
                  HorizontalAlignment="Stretch" />

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="6">
            <TextBlock Text="Have an account?" />
            <HyperlinkButton Content="Login"
                             Command="{Binding GoToLoginCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
