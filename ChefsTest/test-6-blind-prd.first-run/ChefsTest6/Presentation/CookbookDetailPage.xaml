<Page x:Class="ChefsTest6.Presentation.CookbookDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest6.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:models="using:ChefsTest6.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="CookbookRecipeTemplate" x:DataType="models:Recipe">
      <Button Padding="0" Margin="6"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Background="{ThemeResource SurfaceContainerLowBrush}"
              BorderThickness="0"
              CornerRadius="12"
              Click="OnRecipeClicked">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
          <StackPanel Grid.Row="1" Padding="10,8,10,10" Spacing="2">
            <TextBlock Text="{x:Bind Name}"
                       Style="{ThemeResource TitleSmallTextBlockStyle}"
                       TextWrapping="Wrap"
                       MaxLines="2" />
            <TextBlock Text="{x:Bind CookTimeText}"
                       Style="{ThemeResource BodySmallTextBlockStyle}"
                       Opacity="0.7" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </Page.Resources>
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="{Binding Cookbook.Name}">
      <utu:NavigationBar.MainCommand>
        <AppBarButton Icon="Back" Command="{Binding BackCommand}" />
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <TextBlock Grid.Row="1"
               Padding="16,4,16,8"
               Text="{Binding CountText}"
               Opacity="0.8" />

    <Grid Grid.Row="2">
      <ScrollViewer Padding="8,0,8,16">
        <muxc:ItemsRepeater ItemsSource="{Binding Recipes}"
                            ItemTemplate="{StaticResource CookbookRecipeTemplate}">
          <muxc:ItemsRepeater.Layout>
            <muxc:UniformGridLayout MinItemWidth="200" MinItemHeight="200"
                                    MinRowSpacing="0" MinColumnSpacing="0" />
          </muxc:ItemsRepeater.Layout>
        </muxc:ItemsRepeater>
      </ScrollViewer>
      <Button Style="{ThemeResource ElevatedButtonStyle}"
              Content="Edit"
              Command="{Binding EditCommand}"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,16,16"
              AutomationProperties.AutomationId="EditCookbook" />
    </Grid>
  </Grid>
</Page>
