<Page x:Class="ChefsTest6.Presentation.CookingDonePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest6.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="Hurray!">
      <utu:NavigationBar.MainCommand>
        <AppBarButton Icon="Back" Command="{Binding BackCommand}" />
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="32,32,32,16" Spacing="24" HorizontalAlignment="Center" MaxWidth="480">
        <TextBlock Text="🎉" FontSize="96" HorizontalAlignment="Center" />
        <TextBlock Text="Hurray!"
                   Style="{ThemeResource DisplaySmallTextBlockStyle}"
                   HorizontalAlignment="Center" />
        <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center">
          <Run Text="You finished cooking " />
          <Run Text="{Binding Recipe.Name}" FontWeight="SemiBold" />
          <Run Text=". How was it?" />
        </TextBlock>

        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <Button Style="{ThemeResource TextButtonStyle}" Command="{Binding RateOneCommand}">
            <SymbolIcon Symbol="Favorite" />
          </Button>
          <Button Style="{ThemeResource TextButtonStyle}" Command="{Binding RateTwoCommand}">
            <SymbolIcon Symbol="Favorite" />
          </Button>
          <Button Style="{ThemeResource TextButtonStyle}" Command="{Binding RateThreeCommand}">
            <SymbolIcon Symbol="Favorite" />
          </Button>
          <Button Style="{ThemeResource TextButtonStyle}" Command="{Binding RateFourCommand}">
            <SymbolIcon Symbol="Favorite" />
          </Button>
          <Button Style="{ThemeResource TextButtonStyle}" Command="{Binding RateFiveCommand}">
            <SymbolIcon Symbol="Favorite" />
          </Button>
        </StackPanel>

        <TextBlock HorizontalAlignment="Center" Opacity="0.7">
          <Run Text="Your rating: " />
          <Run Text="{Binding Rating}" />
          <Run Text=" / 5" />
        </TextBlock>

        <Button Content="Add to favorites"
                Command="{Binding ToggleFavoriteCommand}"
                Style="{ThemeResource OutlinedButtonStyle}"
                HorizontalAlignment="Stretch" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Padding="16,8,16,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Content="Previous"
              Command="{Binding PreviousCommand}"
              Style="{ThemeResource OutlinedButtonStyle}"
              HorizontalAlignment="Stretch"
              Margin="0,0,8,0" />
      <Button Grid.Column="1"
              Content="Done"
              Command="{Binding DoneCommand}"
              Style="{ThemeResource ElevatedButtonStyle}"
              HorizontalAlignment="Stretch"
              Margin="8,0,0,0" />
    </Grid>
  </Grid>
</Page>
