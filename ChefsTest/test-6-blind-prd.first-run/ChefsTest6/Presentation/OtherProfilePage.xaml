<Page x:Class="ChefsTest6.Presentation.OtherProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest6.Presentation"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:models="using:ChefsTest6.Models"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />

    <DataTemplate x:Key="ProfileRecipeTemplate" x:DataType="models:Recipe">
      <Button Padding="0" Margin="6"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Background="{ThemeResource SurfaceContainerLowBrush}"
              BorderThickness="0"
              CornerRadius="12"
              Click="OnRecipeClicked">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
          <StackPanel Grid.Row="1" Padding="10,8,10,10">
            <TextBlock Text="{x:Bind Name}"
                       Style="{ThemeResource TitleSmallTextBlockStyle}"
                       TextWrapping="Wrap"
                       MaxLines="2" />
            <TextBlock Text="{x:Bind CookTimeText}"
                       Style="{ThemeResource BodySmallTextBlockStyle}"
                       Opacity="0.7" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </Page.Resources>
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="{Binding FullName}">
      <utu:NavigationBar.MainCommand>
        <AppBarButton Icon="Back" Command="{Binding BackCommand}" />
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <Grid Grid.Row="1" Padding="16,12,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Ellipse Width="80" Height="80">
        <Ellipse.Fill>
          <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
        </Ellipse.Fill>
      </Ellipse>
      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding FullName}"
                   Style="{ThemeResource TitleMediumTextBlockStyle}" />
        <TextBlock Text="{Binding Description}"
                   Opacity="0.7" />
      </StackPanel>
      <Button Grid.Column="2"
              Content="Follow"
              Command="{Binding ToggleFollowCommand}"
              Style="{ThemeResource OutlinedButtonStyle}"
              VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="2" Padding="16,4,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="{Binding RecipesText}"
                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Recipes" Opacity="0.7" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center">
        <TextBlock Text="{Binding FollowersText}"
                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Followers" Opacity="0.7" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Center">
        <TextBlock Text="{Binding FollowingText}"
                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Following" Opacity="0.7" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3">
      <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="🍽" FontSize="48" HorizontalAlignment="Center" />
          <TextBlock Text="No recipes yet"
                     Style="{ThemeResource TitleMediumTextBlockStyle}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
      <ScrollViewer Padding="8,0,8,16"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
        <muxc:ItemsRepeater ItemsSource="{Binding Recipes}"
                            ItemTemplate="{StaticResource ProfileRecipeTemplate}">
          <muxc:ItemsRepeater.Layout>
            <muxc:UniformGridLayout MinItemWidth="200" MinItemHeight="200"
                                    MinRowSpacing="0" MinColumnSpacing="0" />
          </muxc:ItemsRepeater.Layout>
        </muxc:ItemsRepeater>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
