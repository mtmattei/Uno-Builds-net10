<UserControl x:Class="ChefsTest6.Presentation.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ChefsTest6.Presentation"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
             xmlns:models="using:ChefsTest6.Models"
             d:DesignHeight="800"
             d:DesignWidth="400"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <UserControl.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />

    <DataTemplate x:Key="SavedRecipeTemplate" x:DataType="models:Recipe">
      <Button Padding="0" Margin="6"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Background="{ThemeResource SurfaceContainerLowBrush}"
              BorderThickness="0"
              CornerRadius="12"
              Click="OnRecipeClicked">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill" />
          <Border Grid.Row="0"
                  Width="32" Height="32"
                  CornerRadius="16"
                  Background="{ThemeResource SurfaceBrush}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,8,8,0">
            <ToggleButton IsChecked="{x:Bind IsFavorite, Mode=TwoWay}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          Width="32" Height="32">
              <SymbolIcon Symbol="Favorite" />
            </ToggleButton>
          </Border>
          <StackPanel Grid.Row="1" Padding="10,8,10,10" Spacing="2">
            <TextBlock Text="{x:Bind Name}"
                       Style="{ThemeResource TitleSmallTextBlockStyle}"
                       TextWrapping="Wrap"
                       MaxLines="2" />
            <TextBlock Text="{x:Bind CookTimeText}"
                       Style="{ThemeResource BodySmallTextBlockStyle}"
                       Opacity="0.7" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="CookbookCardTemplate" x:DataType="models:Cookbook">
      <Button Margin="6" Padding="8"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              CornerRadius="12"
              BorderThickness="0"
              Background="{ThemeResource SurfaceContainerLowBrush}"
              Click="OnCookbookClicked">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0"
                CornerRadius="8">
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="6" Margin="0,0,2,2">
              <Image Source="{x:Bind Cover1, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="6" Margin="2,0,0,2">
              <Image Source="{x:Bind Cover2, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <Border Grid.Row="1" Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="6" Margin="0,2,2,0">
              <Image Source="{x:Bind Cover3, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource SurfaceContainerHighBrush}" CornerRadius="6" Margin="2,2,0,0">
              <Image Source="{x:Bind Cover4, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
          </Grid>
          <StackPanel Grid.Row="1" Padding="4,8,4,4" Spacing="2">
            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                       Style="{ThemeResource TitleSmallTextBlockStyle}"
                       TextWrapping="Wrap"
                       MaxLines="2" />
            <TextBlock>
              <Run Text="{x:Bind RecipeCount, Mode=OneWay}" />
              <Run Text=" recipes" />
            </TextBlock>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Grid Padding="16,12,16,8">
      <TextBlock Text="Favorites"
                 Style="{ThemeResource HeadlineSmallTextBlockStyle}" />
    </Grid>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8"
                Padding="16,0,16,8">
      <Button Content="All Recipes"
              Command="{Binding SelectRecipesCommand}"
              Style="{ThemeResource OutlinedButtonStyle}"
              AutomationProperties.AutomationId="SegRecipes" />
      <Button Content="My Cookbooks"
              Command="{Binding SelectCookbooksCommand}"
              Style="{ThemeResource OutlinedButtonStyle}"
              AutomationProperties.AutomationId="SegCookbooks" />
    </StackPanel>

    <TextBlock Grid.Row="2"
               Padding="16,0,16,8"
               Opacity="0.8">
      <Run Text="{Binding RecipesText}" />
      <Run Text=" · " />
      <Run Text="{Binding CookbooksText}" />
    </TextBlock>

    <Grid Grid.Row="3">
      <Grid Visibility="{Binding IsRecipesTab, Converter={StaticResource BoolToVis}}">
        <Grid Visibility="{Binding IsRecipesEmpty, Converter={StaticResource BoolToVis}}">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="❤"
                       FontSize="48"
                       HorizontalAlignment="Center" />
            <TextBlock Text="No favorites yet"
                       Style="{ThemeResource TitleMediumTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <Button Content="See popular recipes"
                    Command="{Binding GoDiscoverPopularCommand}"
                    Style="{ThemeResource ElevatedButtonStyle}" />
          </StackPanel>
        </Grid>
        <ScrollViewer Padding="8,0,8,16"
                      Visibility="{Binding IsRecipesEmpty, Converter={StaticResource InvBoolToVis}}">
          <muxc:ItemsRepeater ItemsSource="{Binding SavedRecipes}"
                              ItemTemplate="{StaticResource SavedRecipeTemplate}">
            <muxc:ItemsRepeater.Layout>
              <muxc:UniformGridLayout MinItemWidth="200" MinItemHeight="200"
                                      MinRowSpacing="0" MinColumnSpacing="0" />
            </muxc:ItemsRepeater.Layout>
          </muxc:ItemsRepeater>
        </ScrollViewer>
      </Grid>

      <Grid Visibility="{Binding IsCookbooksTab, Converter={StaticResource BoolToVis}}">
        <Grid Visibility="{Binding IsCookbooksEmpty, Converter={StaticResource BoolToVis}}">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="📒"
                       FontSize="48"
                       HorizontalAlignment="Center" />
            <TextBlock Text="No Cookbooks Created"
                       Style="{ThemeResource TitleMediumTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <Button Content="Create cookbook"
                    Command="{Binding CreateCookbookCommand}"
                    Style="{ThemeResource ElevatedButtonStyle}" />
          </StackPanel>
        </Grid>
        <ScrollViewer Padding="8,0,8,16"
                      Visibility="{Binding IsCookbooksEmpty, Converter={StaticResource InvBoolToVis}}">
          <muxc:ItemsRepeater ItemsSource="{Binding Cookbooks}"
                              ItemTemplate="{StaticResource CookbookCardTemplate}">
            <muxc:ItemsRepeater.Layout>
              <muxc:UniformGridLayout MinItemWidth="200" MinItemHeight="200"
                                      MinRowSpacing="0" MinColumnSpacing="0" />
            </muxc:ItemsRepeater.Layout>
          </muxc:ItemsRepeater>
        </ScrollViewer>
        <Button Style="{ThemeResource ElevatedButtonStyle}"
                Content="+ New Cookbook"
                Command="{Binding CreateCookbookCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                AutomationProperties.AutomationId="CreateCookbookFAB" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
