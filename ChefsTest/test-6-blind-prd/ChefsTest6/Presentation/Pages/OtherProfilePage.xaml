<Page x:Class="ChefsTest6.Presentation.Pages.OtherProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest6.Models"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="{Binding User.FullName}" />

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16" Spacing="16">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
          <Border Width="120" Height="120" CornerRadius="60" Background="{ThemeResource SurfaceVariantBrush}">
            <Image Source="{Binding User.UrlProfileImage}" Stretch="UniformToFill" />
          </Border>
          <TextBlock Text="{Binding User.FullName}" Style="{StaticResource HeadlineSmall}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding User.Description}" Style="{StaticResource BodyMedium}" HorizontalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding User.RecipeLabel}" Style="{StaticResource HeadlineSmall}" HorizontalAlignment="Center" />
            <TextBlock Text="Recipes" Style="{StaticResource LabelSmall}" Opacity="0.7" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock Text="{Binding User.FollowerLabel}" Style="{StaticResource HeadlineSmall}" HorizontalAlignment="Center" />
            <TextBlock Text="Followers" Style="{StaticResource LabelSmall}" Opacity="0.7" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Center">
            <TextBlock Text="{Binding User.FollowingLabel}" Style="{StaticResource HeadlineSmall}" HorizontalAlignment="Center" />
            <TextBlock Text="Following" Style="{StaticResource LabelSmall}" Opacity="0.7" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Recipes" Style="{StaticResource TitleLarge}" Margin="0,12,0,0" />

        <StackPanel Spacing="8" HorizontalAlignment="Center"
                    Visibility="{Binding HasRecipes, Converter={StaticResource BoolToVisibleInverted}}">
          <TextBlock Text="No recipes yet" Style="{StaticResource TitleMedium}" HorizontalAlignment="Center" />
        </StackPanel>

        <GridView ItemsSource="{Binding Recipes}" SelectionMode="None"
                  Visibility="{Binding HasRecipes, Converter={StaticResource BoolToVisible}}">
          <GridView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsWrapGrid Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </GridView.ItemsPanel>
          <GridView.ItemTemplate>
            <DataTemplate x:DataType="m:RecipeData">
              <Button Width="180" Margin="4" Background="Transparent" BorderThickness="0" Padding="0"
                      Command="{Binding DataContext.OpenRecipeCommand, ElementName=PageRoot}"
                      CommandParameter="{x:Bind}">
                <Border CornerRadius="16" Background="{ThemeResource SurfaceVariantBrush}">
                  <StackPanel>
                    <Image Source="{x:Bind ImageUrl}" Height="120" Stretch="UniformToFill" />
                    <StackPanel Padding="10" Spacing="2">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource TitleSmall}" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind CookTimeLabel}" Style="{StaticResource BodySmall}" Opacity="0.7" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </GridView.ItemTemplate>
        </GridView>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
