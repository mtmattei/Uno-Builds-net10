<Page x:Class="ChefsTest6.Presentation.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <utu:SafeArea Insets="VisibleBounds,SoftInput">
    <ScrollViewer>
      <Grid Padding="24" MaxWidth="480" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sign in" Style="{StaticResource HeadlineLarge}" Margin="0,32,0,8" />
        <TextBlock Grid.Row="1" Text="Welcome back to Uno Chefs" Style="{StaticResource BodyMedium}" Opacity="0.7" Margin="0,0,0,24" />

        <TextBox Grid.Row="2"
                 Header="Username"
                 Text="{Binding Username, Mode=TwoWay}"
                 Margin="0,0,0,12" />
        <PasswordBox Grid.Row="3"
                     Header="Password"
                     Password="{Binding Password, Mode=TwoWay}"
                     Margin="0,0,0,12" />

        <Grid Grid.Row="4" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" Content="Remember me" IsChecked="{Binding RememberMe, Mode=TwoWay}" />
          <Button Grid.Column="1" Content="Forgot password?" Style="{StaticResource TextButtonStyle}" Command="{Binding ForgotPasswordCommand}" />
        </Grid>

        <TextBlock Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   Foreground="{ThemeResource ErrorBrush}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisible}}"
                   Margin="0,0,0,12" />

        <Button Grid.Row="6"
                Content="Sign in"
                Command="{Binding SignInCommand}"
                HorizontalAlignment="Stretch"
                Style="{StaticResource FilledButtonStyle}"
                Margin="0,0,0,16" />

        <Grid Grid.Row="7" ColumnSpacing="8" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Content="Continue with Apple"
                  Command="{Binding SignInWithSocialCommand}"
                  CommandParameter="Apple"
                  HorizontalAlignment="Stretch"
                  Style="{StaticResource OutlinedButtonStyle}" />
          <Button Grid.Column="1"
                  Content="Continue with Google"
                  Command="{Binding SignInWithSocialCommand}"
                  CommandParameter="Google"
                  HorizontalAlignment="Stretch"
                  Style="{StaticResource OutlinedButtonStyle}" />
        </Grid>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
          <TextBlock Text="No account?" />
          <Button Content="Register" Style="{StaticResource TextButtonStyle}" Command="{Binding GoToRegisterCommand}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </utu:SafeArea>
</Page>
