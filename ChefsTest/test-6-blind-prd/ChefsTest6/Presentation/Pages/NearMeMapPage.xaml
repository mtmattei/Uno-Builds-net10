<Page x:Class="ChefsTest6.Presentation.Pages.NearMeMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest6.Models"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="Near me" />

    <Grid Grid.Row="1">
      <!-- Map surface placeholder (no map provider chosen per PRD §3.9 / open Q #9) -->
      <Border Background="{ThemeResource SurfaceVariantBrush}">
        <Grid>
          <TextBlock Text="Interactive map of nearby chefs"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Style="{StaticResource TitleMedium}" Opacity="0.7" />
          <!-- Pretend pin overlay -->
          <Canvas>
            <Image Canvas.Left="60" Canvas.Top="100" Width="32" Height="32"
                   Source="ms-appx:///Assets/Maps/location_pin.svg" />
            <Image Canvas.Left="160" Canvas.Top="80" Width="32" Height="32"
                   Source="ms-appx:///Assets/Maps/location_pin.svg" />
            <Image Canvas.Left="240" Canvas.Top="160" Width="32" Height="32"
                   Source="ms-appx:///Assets/Maps/location_pin.svg" />
            <Image Canvas.Left="120" Canvas.Top="220" Width="40" Height="40"
                   Source="ms-appx:///Assets/Maps/location_circle.svg" />
          </Canvas>
        </Grid>
      </Border>

      <!-- Selected contributor card -->
      <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
              Margin="16" Padding="12" CornerRadius="16"
              Background="{ThemeResource SurfaceBrush}">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SurfaceVariantBrush}">
            <Image Source="{Binding SelectedChef.UrlProfileImage}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedChef.FullName}" Style="{StaticResource TitleMedium}" />
            <TextBlock Text="{Binding SelectedChef.Description}" Style="{StaticResource BodySmall}" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Content="View profile" Style="{StaticResource OutlinedButtonStyle}" Command="{Binding OpenSelectedProfileCommand}" />
        </Grid>
      </Border>

      <!-- Contributor pin list (FAB-adjacent) -->
      <ScrollViewer HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" MaxHeight="280" MaxWidth="200"
                    HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Chefs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:UserData">
              <Button Margin="0,4" HorizontalAlignment="Stretch"
                      Background="{ThemeResource SurfaceBrush}"
                      Padding="6"
                      Command="{Binding DataContext.SelectChefCommand, ElementName=PageRoot}"
                      CommandParameter="{x:Bind}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="32" Height="32" CornerRadius="16">
                    <Image Source="{x:Bind UrlProfileImage}" Stretch="UniformToFill" />
                  </Border>
                  <TextBlock Text="{x:Bind FullName}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Button Style="{StaticResource FabStyle}"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="16,0,16,120"
              Command="{Binding OpenSelectedProfileCommand}">
        <SymbolIcon Symbol="Contact" />
      </Button>
    </Grid>
  </Grid>
</Page>
