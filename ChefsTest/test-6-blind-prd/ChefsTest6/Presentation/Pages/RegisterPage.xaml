<Page x:Class="ChefsTest6.Presentation.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <utu:SafeArea Insets="VisibleBounds,SoftInput">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <utu:NavigationBar Grid.Row="0" Content="Create account" />
      <ScrollViewer Grid.Row="1">
        <Grid Padding="24" MaxWidth="480" HorizontalAlignment="Center" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Sign up" Style="{StaticResource HeadlineLarge}" Margin="0,16,0,0" />
          <TextBlock Grid.Row="1" Text="Just a few details to get cooking" Style="{StaticResource BodyMedium}" Opacity="0.7" />
          <TextBox Grid.Row="2" Header="Username" Text="{Binding Username, Mode=TwoWay}" />
          <TextBox Grid.Row="3" Header="Email" InputScope="EmailNameOrAddress" Text="{Binding Email, Mode=TwoWay}" />
          <PasswordBox Grid.Row="4" Header="Password" Password="{Binding Password, Mode=TwoWay}" />
          <TextBlock Grid.Row="5"
                     Text="{Binding ErrorMessage}"
                     Foreground="{ThemeResource ErrorBrush}"
                     Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisible}}" />
          <Grid Grid.Row="6" ColumnSpacing="12" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Login" Style="{StaticResource TextButtonStyle}" Command="{Binding GoToLoginCommand}" />
            <Button Grid.Column="1" Content="Sign up" HorizontalAlignment="Stretch" Style="{StaticResource FilledButtonStyle}" Command="{Binding SignUpCommand}" />
          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>
  </utu:SafeArea>
</Page>
