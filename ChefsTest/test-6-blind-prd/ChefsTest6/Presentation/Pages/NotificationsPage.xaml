<Page x:Class="ChefsTest6.Presentation.Pages.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:m="using:ChefsTest6.Models"
      xmlns:vm="using:ChefsTest6.ViewModels"
      x:Name="PageRoot"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Grid.Row="0" Content="Notifications">
      <utu:NavigationBar.PrimaryCommands>
        <AppBarButton Icon="Cancel" Label="Close" Command="{Binding CloseCommand}" />
      </utu:NavigationBar.PrimaryCommands>
    </utu:NavigationBar>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0" Padding="16,8">
      <Button Content="All" Style="{StaticResource OutlinedButtonStyle}" Command="{Binding SelectSegmentCommand}" CommandParameter="0" />
      <Button Content="Unread" Style="{StaticResource OutlinedButtonStyle}" Command="{Binding SelectSegmentCommand}" CommandParameter="1" />
      <Button Content="Read" Style="{StaticResource OutlinedButtonStyle}" Command="{Binding SelectSegmentCommand}" CommandParameter="2" />
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <StackPanel Padding="16,8" Spacing="16">
        <StackPanel Spacing="8" HorizontalAlignment="Center"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibleInverted}}">
          <Image Source="ms-appx:///Assets/Images/empty_notification_light.svg" Width="180" Height="180" Stretch="Uniform" />
          <TextBlock Text="Nothing new" Style="{StaticResource TitleLarge}" HorizontalAlignment="Center" />
          <TextBlock Text="You're all caught up." Style="{StaticResource BodyMedium}" Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NotificationGroup">
              <StackPanel Spacing="8" Margin="0,8,0,12">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource TitleSmall}" Opacity="0.7" />
                <ItemsControl ItemsSource="{x:Bind Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:NotificationData">
                      <Border Padding="12" CornerRadius="12" Margin="0,4"
                              Background="{ThemeResource SurfaceVariantBrush}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <FontIcon Grid.Column="0" Glyph="" Margin="0,0,12,0" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource TitleSmall}" />
                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource BodyMedium}" TextWrapping="Wrap" Opacity="0.8" />
                          </StackPanel>
                          <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{ThemeResource PrimaryBrush}"
                                   Visibility="{x:Bind IsRead, Mode=OneWay, Converter={StaticResource BoolToVisibleInverted}}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
