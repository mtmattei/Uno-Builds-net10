<Page x:Class="ChefsTest6.Presentation.Pages.LiveCookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="{Binding AppBarTitle}" />

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16" Padding="16">
        <Border CornerRadius="16" Height="220" Background="{ThemeResource OnSurfaceBrush}" Opacity="0.9">
          <Grid>
            <Image Source="{Binding Recipe.ImageUrl}" Stretch="UniformToFill" Opacity="0.7" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
              <FontIcon Glyph="" Foreground="White" FontSize="48" />
              <TextBlock Text="Tap to play step video" Foreground="White" Style="{StaticResource LabelLarge}" />
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource LabelLarge}" Opacity="0.7" />
        <TextBlock Text="{Binding CurrentStep.Title}" Style="{StaticResource HeadlineSmall}" TextWrapping="Wrap" />

        <Border CornerRadius="16" Padding="16" Background="{ThemeResource SurfaceVariantBrush}">
          <StackPanel Spacing="12">
            <TextBlock Text="Ingredients for this step" Style="{StaticResource TitleSmall}" />
            <ItemsControl ItemsSource="{Binding CurrentStep.Ingredients}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Padding="0,4" Spacing="8">
                    <CheckBox />
                    <TextBlock Text="{Binding}" Style="{StaticResource BodyLarge}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding CurrentStep.Description}" Style="{StaticResource BodyLarge}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <PipsPager Grid.Row="2"
               NumberOfPages="{Binding StepTotal}"
               SelectedPageIndex="{Binding CurrentStepIndex, Mode=TwoWay}"
               HorizontalAlignment="Center"
               Margin="0,8" />

    <Grid Grid.Row="3" Padding="16,8" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Previous" Style="{StaticResource OutlinedButtonStyle}" HorizontalAlignment="Stretch" Command="{Binding PreviousCommand}" />
      <Button Grid.Column="1" Content="{Binding PrimaryActionLabel}" Style="{StaticResource FilledButtonStyle}" HorizontalAlignment="Stretch" Command="{Binding NextCommand}" />
    </Grid>
  </Grid>
</Page>
