<Page x:Class="ChefsTest6.Presentation.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <utu:NavigationBar Grid.Row="0" Content="Settings" />

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16" Spacing="20" MaxWidth="560" HorizontalAlignment="Stretch">
        <!-- Personal Information -->
        <StackPanel Spacing="12">
          <TextBlock Text="Personal Information" Style="{StaticResource TitleLarge}" />
          <TextBox Header="Name" Text="{Binding FullName, Mode=TwoWay}" />
          <TextBox Header="Email" InputScope="EmailNameOrAddress" Text="{Binding Email, Mode=TwoWay}" />
          <TextBox Header="Mobile Number" InputScope="TelephoneNumber" Text="{Binding PhoneNumber, Mode=TwoWay}" />
        </StackPanel>

        <!-- Application Settings -->
        <StackPanel Spacing="8">
          <TextBlock Text="Application Settings" Style="{StaticResource TitleLarge}" />
          <ToggleSwitch Header="Notifications" IsOn="{Binding NotificationsEnabled, Mode=TwoWay}" />
          <ToggleSwitch Header="Night Mode" IsOn="{Binding NightMode, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource PrimaryBrush}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisible}}" />

        <Button Content="Save Changes" Style="{StaticResource FilledButtonStyle}" HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" />
        <Button Content="Log out" Style="{StaticResource OutlinedButtonStyle}" HorizontalAlignment="Stretch" Command="{Binding LogOutCommand}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
