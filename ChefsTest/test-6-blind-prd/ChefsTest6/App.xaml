<Application x:Class="ChefsTest6.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       xmlns:c="using:ChefsTest6.Presentation.Converters">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme
          ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <c:BoolToVisibilityConverter x:Key="BoolToVisible" />
      <c:BoolToVisibilityConverter x:Key="BoolToVisibleInverted" Invert="True" />
      <c:NullToVisibilityConverter x:Key="NullToVisible" />
      <c:NullToVisibilityConverter x:Key="NullToVisibleInverted" Invert="True" />
      <c:CountToVisibilityConverter x:Key="EmptyToVisible" ShowWhenEmpty="True" />
      <c:CountToVisibilityConverter x:Key="HasItemsToVisible" ShowWhenEmpty="False" />
      <c:HeartGlyphConverter x:Key="HeartGlyph" />
      <c:IsActiveToBrushConverter x:Key="ActiveBrush" />
      <c:IntEqualsConverter x:Key="IntEquals" />
      <c:StarFillConverter x:Key="StarFill" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
