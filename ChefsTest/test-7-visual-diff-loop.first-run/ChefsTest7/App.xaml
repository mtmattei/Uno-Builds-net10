<Application x:Class="ChefsTest7.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       xmlns:cv="using:ChefsTest7.Presentation">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme
          ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <cv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
      <cv:StringToVisibilityConverter x:Key="StringToVisibility"/>
      <cv:CountToVisibilityConverter x:Key="CountToVisibility"/>
      <cv:HeartGlyphConverter x:Key="HeartGlyph"/>
      <cv:TimeSpanToMinutesConverter x:Key="MinutesText"/>
      <cv:DifficultyConverter x:Key="DifficultyText"/>
      <cv:IndexToBoolConverter x:Key="IndexToBool"/>
      <cv:IndexToVisibilityConverter x:Key="IndexToVisibility"/>
      <cv:CategoryColorConverter x:Key="CategoryColor"/>

      <!-- Inverted top app-bar pattern (DESIGN.md): charcoal in light, white-with-dark-text in dark. -->
      <SolidColorBrush x:Key="AppBarFillBrush" Color="{ThemeResource SurfaceInverseColor}"/>
      <SolidColorBrush x:Key="OnAppBarBrush" Color="{ThemeResource OnSurfaceInverseColor}"/>
    </ResourceDictionary>
  </Application.Resources>

</Application>
