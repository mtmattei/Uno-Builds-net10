<!-- Chef-pink palette derived from DESIGN.md (#FF1F5A primary; charcoal/cream surfaces from Chefs-screenshots). -->
<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#FF1F5A</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#FFD9E2</Color>
      <Color x:Key="OnPrimaryContainerColor">#3F0014</Color>
      <Color x:Key="SecondaryColor">#EAE3D6</Color>
      <Color x:Key="OnSecondaryColor">#2D2D2D</Color>
      <Color x:Key="SecondaryContainerColor">#F4ECDD</Color>
      <Color x:Key="OnSecondaryContainerColor">#2D2D2D</Color>
      <Color x:Key="TertiaryColor">#7A67F8</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#E5DEFF</Color>
      <Color x:Key="OnTertiaryContainerColor">#170065</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#410E0B</Color>
      <Color x:Key="BackgroundColor">#F8F9FB</Color>
      <Color x:Key="OnBackgroundColor">#2D2D2D</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#2D2D2D</Color>
      <Color x:Key="SurfaceVariantColor">#F2EFF5</Color>
      <Color x:Key="OnSurfaceVariantColor">#666666</Color>
      <Color x:Key="OutlineColor">#E0E0E0</Color>
      <Color x:Key="OnSurfaceInverseColor">#FFFFFF</Color>
      <Color x:Key="SurfaceInverseColor">#2D2D2D</Color>
      <Color x:Key="PrimaryInverseColor">#FFB3C1</Color>
      <Color x:Key="SurfaceTintColor">#FF1F5A</Color>
      <Color x:Key="OutlineVariantColor">#E0E0E0</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#FF6B8A</Color>
      <Color x:Key="OnPrimaryColor">#5F0021</Color>
      <Color x:Key="PrimaryContainerColor">#860030</Color>
      <Color x:Key="OnPrimaryContainerColor">#FFD9E2</Color>
      <Color x:Key="SecondaryColor">#3D3528</Color>
      <Color x:Key="OnSecondaryColor">#EAE3D6</Color>
      <Color x:Key="SecondaryContainerColor">#4D4534</Color>
      <Color x:Key="OnSecondaryContainerColor">#EAE3D6</Color>
      <Color x:Key="TertiaryColor">#CAC2FC</Color>
      <Color x:Key="OnTertiaryColor">#2A009F</Color>
      <Color x:Key="TertiaryContainerColor">#4129BA</Color>
      <Color x:Key="OnTertiaryContainerColor">#E4DFFF</Color>
      <Color x:Key="ErrorColor">#FFB4AB</Color>
      <Color x:Key="ErrorContainerColor">#93000A</Color>
      <Color x:Key="OnErrorColor">#690005</Color>
      <Color x:Key="OnErrorContainerColor">#FFDAD6</Color>
      <Color x:Key="BackgroundColor">#121212</Color>
      <Color x:Key="OnBackgroundColor">#F5F5F5</Color>
      <Color x:Key="SurfaceColor">#1E1E1E</Color>
      <Color x:Key="OnSurfaceColor">#F5F5F5</Color>
      <Color x:Key="SurfaceVariantColor">#2A2A2A</Color>
      <Color x:Key="OnSurfaceVariantColor">#B0B0B0</Color>
      <Color x:Key="OutlineColor">#333333</Color>
      <Color x:Key="OnSurfaceInverseColor">#2D2D2D</Color>
      <Color x:Key="SurfaceInverseColor">#FFFFFF</Color>
      <Color x:Key="PrimaryInverseColor">#FF1F5A</Color>
      <Color x:Key="SurfaceTintColor">#FF6B8A</Color>
      <Color x:Key="OutlineVariantColor">#333333</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
