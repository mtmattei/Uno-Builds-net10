<Page x:Class="ChefsTest7.Presentation.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest7.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="RecipeGridCardTemplate" x:DataType="m:RecipeData">
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Margin="4">
        <Grid Width="170">
          <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
          <Grid Grid.Row="1" Padding="10,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{x:Bind Calories}" FontSize="11" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind IsFavorite, Converter={StaticResource HeartGlyph}}" FontSize="20" Foreground="{ThemeResource PrimaryBrush}"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="{ThemeResource AppBarFillBrush}" Padding="16,12">
      <TextBlock Text="Search" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource OnAppBarBrush}"/>
    </Grid>
    <Grid Grid.Row="1" Padding="16,12,16,4" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{ThemeResource SurfaceBrush}" CornerRadius="25" Padding="12,4">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
          <TextBox Grid.Column="1" PlaceholderText="Search recipes" Text="{Binding Query, Mode=TwoWay}" BorderThickness="0" Background="Transparent"/>
        </Grid>
      </Border>
      <Button Grid.Column="1" Content="Filters" Command="{Binding OpenFiltersCommand}" Style="{ThemeResource OutlinedButtonStyle}" Foreground="{ThemeResource PrimaryBrush}"/>
    </Grid>
    <TextBlock Grid.Row="2" Margin="16,4,16,8" FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}">
      <Run Text="{Binding ResultCount}"/><Run Text=" recipes"/>
    </TextBlock>

    <Grid Grid.Row="3">
      <GridView ItemsSource="{Binding Results}" ItemTemplate="{StaticResource RecipeGridCardTemplate}"
                SelectionMode="None" Padding="12,0,12,16" IsItemClickEnabled="True" ItemClick="OnRecipeClick"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"/>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                  Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
        <Image Source="ms-appx:///Assets/Images/empty_recipe_light.svg" Width="180" Height="180"/>
        <TextBlock Text="No results" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}"/>
        <TextBlock Text="Try a different keyword or category." FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextAlignment="Center"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="4" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0">
      <Grid Padding="0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Background="Transparent" HorizontalAlignment="Stretch" Command="{Binding NavigateHomeCommand}">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="🏠" FontSize="18" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
            <TextBlock Text="Home" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Background="Transparent" HorizontalAlignment="Stretch" Command="{Binding NavigateSearchCommand}">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <Border CornerRadius="14" Padding="10,4" Background="{ThemeResource SecondaryBrush}">
              <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}"/>
            </Border>
            <TextBlock Text="Search" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Background="Transparent" HorizontalAlignment="Stretch" Command="{Binding NavigateFavoritesCommand}">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="♥" FontSize="18" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
            <TextBlock Text="Favorites" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Page>
