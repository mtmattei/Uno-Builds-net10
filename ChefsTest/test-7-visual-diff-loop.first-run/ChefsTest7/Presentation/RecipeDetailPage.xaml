<Page x:Class="ChefsTest7.Presentation.RecipeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest7.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="IngredientTemplate" x:DataType="m:IngredientData">
      <Grid Padding="0,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SurfaceVariantBrush}">
          <Image Source="{x:Bind UrlIcon}" Width="28" Height="28" Stretch="Uniform"/>
        </Border>
        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}"/>
        <Border Grid.Column="2" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="10,4">
          <TextBlock Text="{x:Bind Quantity}" FontSize="12" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="StepTemplate" x:DataType="m:StepData">
      <StackPanel Padding="0,8" Spacing="4">
        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource OnSurfaceBrush}"/>
        <TextBlock Text="{x:Bind Description}" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ReviewTemplate" x:DataType="m:ReviewData">
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,12">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{ThemeResource SurfaceVariantBrush}">
            <Image Source="{x:Bind UrlAuthorImage}" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{x:Bind PublisherName}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}"/>
            <TextBlock Text="{x:Bind Description}" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- App bar -->
    <Grid Grid.Row="0" Background="{ThemeResource AppBarFillBrush}" Padding="8,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="←" FontSize="20" Background="Transparent" Foreground="{ThemeResource OnAppBarBrush}" Command="{Binding BackCommand}"/>
      <TextBlock Grid.Column="1" Text="{Binding Recipe.Name}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource OnAppBarBrush}"/>
      <Button Grid.Column="2" Content="{Binding Recipe.IsFavorite, Converter={StaticResource HeartGlyph}}" FontSize="22" Background="Transparent" Foreground="{ThemeResource OnAppBarBrush}" Command="{Binding ToggleFavoriteCommand}"/>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="12">
        <!-- Hero -->
        <Image Source="{Binding Recipe.ImageUrl}" Height="240" Stretch="UniformToFill"/>

        <Grid Padding="16,8" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{ThemeResource SurfaceVariantBrush}">
            <Image Source="{Binding Recipe.Creator.UrlProfileImage}" Stretch="UniformToFill"/>
          </Border>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}">
            <Run Text="By "/><Run Text="{Binding Recipe.Creator.FullName}"/>
          </TextBlock>
        </Grid>

        <!-- 3-up stat row -->
        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="16,4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
              <TextBlock Text="⏱" HorizontalAlignment="Center" FontSize="18"/>
              <TextBlock Text="{Binding Recipe.CookTime, Converter={StaticResource MinutesText}}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}"/>
              <TextBlock Text="Time" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
              <TextBlock Text="★" HorizontalAlignment="Center" FontSize="18" Foreground="{ThemeResource PrimaryBrush}"/>
              <TextBlock Text="{Binding Recipe.Difficulty, Converter={StaticResource DifficultyText}}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}"/>
              <TextBlock Text="Level" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
              <TextBlock Text="🔥" HorizontalAlignment="Center" FontSize="18"/>
              <TextBlock Text="{Binding Recipe.Calories}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}"/>
              <TextBlock Text="Kcal" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Tabs -->
        <Pivot x:Name="DetailTabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Margin="8,0">
          <PivotItem Header="Ingredients">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Ingredients}" ItemTemplate="{StaticResource IngredientTemplate}" Padding="8,8"/>
            </ScrollViewer>
          </PivotItem>
          <PivotItem Header="Steps">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}" Padding="8,8"/>
            </ScrollViewer>
          </PivotItem>
          <PivotItem Header="Reviews">
            <Grid>
              <ScrollViewer Visibility="{Binding Reviews.Count, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding Reviews}" ItemTemplate="{StaticResource ReviewTemplate}" Padding="8,8"/>
              </ScrollViewer>
              <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding Reviews.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                <Image Source="ms-appx:///Assets/Images/empty_recipe_light.svg" Width="160" Height="160"/>
                <TextBlock Text="No reviews yet" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}"/>
                <TextBlock Text="Be the first to share your experience." FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
              </StackPanel>
            </Grid>
          </PivotItem>
          <PivotItem Header="Nutrition">
            <StackPanel Padding="16" Spacing="16">
              <TextBlock Text="Nutritional values" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource OnBackgroundBrush}"/>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="120" Height="120" Fill="{ThemeResource PrimaryBrush}" Opacity="0.85"/>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Protein" Foreground="{ThemeResource OnSurfaceBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Recipe.Nutrition.Protein}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Carbs" Foreground="{ThemeResource OnSurfaceBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Recipe.Nutrition.Carbs}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Fat" Foreground="{ThemeResource OnSurfaceBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Recipe.Nutrition.Fat}" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
          </PivotItem>
        </Pivot>

      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Padding="16,12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0">
      <Button Content="Start Cooking!" HorizontalAlignment="Stretch" Background="{ThemeResource PrimaryBrush}" Foreground="{ThemeResource OnPrimaryBrush}" Command="{Binding StartCookingCommand}"/>
    </Grid>
  </Grid>
</Page>
