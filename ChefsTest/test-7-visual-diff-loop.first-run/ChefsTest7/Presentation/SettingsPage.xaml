<Page x:Class="ChefsTest7.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="{ThemeResource AppBarFillBrush}" Padding="8,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="←" FontSize="20" Background="Transparent" Foreground="{ThemeResource OnAppBarBrush}" Command="{Binding BackCommand}"/>
      <TextBlock Grid.Column="1" Text="Settings" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource OnAppBarBrush}"/>
    </Grid>
    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16" Spacing="20">
        <TextBlock Text="Personal Information" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16,12">
          <StackPanel Spacing="14">
            <TextBox Header="Name" Text="{Binding FullName, Mode=TwoWay}"/>
            <TextBox Header="Email" Text="{Binding Email, Mode=TwoWay}"/>
            <TextBox Header="Mobile Number" Text="{Binding PhoneNumber, Mode=TwoWay}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="Application Settings" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16,12">
          <StackPanel Spacing="12">
            <ToggleSwitch Header="Notifications" IsOn="{Binding NotificationsOn, Mode=TwoWay}"/>
            <ToggleSwitch Header="Night Mode" IsOn="{Binding NightMode, Mode=TwoWay}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding SaveStatus}" Foreground="{ThemeResource PrimaryBrush}" Visibility="{Binding SaveStatus, Converter={StaticResource StringToVisibility}}"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Padding="16,12" ColumnSpacing="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Log out" HorizontalAlignment="Stretch" Style="{ThemeResource OutlinedButtonStyle}" Command="{Binding LogOutCommand}"/>
      <Button Grid.Column="1" Content="Save Changes" HorizontalAlignment="Stretch" Background="{ThemeResource PrimaryBrush}" Foreground="{ThemeResource OnPrimaryBrush}" Command="{Binding SaveChangesCommand}"/>
    </Grid>
  </Grid>
</Page>
