<Page x:Class="ChefsTest7.Presentation.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest7.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="NotificationItemTemplate" x:DataType="m:NotificationData">
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="14,12" Margin="16,6">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{ThemeResource PrimaryContainerBrush}">
            <TextBlock Text="🍳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}"/>
            <TextBlock Text="{x:Bind Description}" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="{ThemeResource AppBarFillBrush}" Padding="8,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="✕" FontSize="20" Background="Transparent" Foreground="{ThemeResource OnAppBarBrush}" Command="{Binding CloseCommand}"/>
      <TextBlock Grid.Column="1" Text="Notifications" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource OnAppBarBrush}"/>
    </Grid>

    <Pivot Grid.Row="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
      <PivotItem Header="All">
        <Grid>
          <ScrollViewer Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding All}" ItemTemplate="{StaticResource NotificationItemTemplate}"/>
          </ScrollViewer>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <Image Source="ms-appx:///Assets/Images/empty_notification_light.svg" Width="180" Height="180"/>
            <TextBlock Text="No notifications yet" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}"/>
            <TextBlock Text="When something happens, you'll see it here." FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
          </StackPanel>
        </Grid>
      </PivotItem>
      <PivotItem Header="Unread">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Unread}" ItemTemplate="{StaticResource NotificationItemTemplate}"/>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Read">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Read}" ItemTemplate="{StaticResource NotificationItemTemplate}"/>
        </ScrollViewer>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
