<Page x:Class="ChefsTest7.Presentation.FiltersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest7.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="CategoryFilterChipTemplate" x:DataType="m:CategoryData">
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="20" Padding="12,8" Margin="0,0,8,8" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1">
        <TextBlock Text="{x:Bind Name}" FontSize="13" Foreground="{ThemeResource OnSurfaceBrush}"/>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="StringChipTemplate">
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="20" Padding="12,8" Margin="0,0,8,8" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1">
        <TextBlock Text="{Binding}" FontSize="13" Foreground="{ThemeResource OnSurfaceBrush}"/>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="{ThemeResource AppBarFillBrush}" Padding="16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Filters" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource OnAppBarBrush}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="✕" FontSize="18" Background="Transparent" Foreground="{ThemeResource OnAppBarBrush}" Command="{Binding CloseCommand}"/>
    </Grid>
    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16" Spacing="20">
        <TextBlock Text="Recipe Categories" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource OnBackgroundBrush}"/>
        <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryFilterChipTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <utu:AutoLayout Orientation="Horizontal" Spacing="0"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Text="Cooking Time" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource OnBackgroundBrush}"/>
        <ItemsControl ItemsSource="{Binding Times}" ItemTemplate="{StaticResource StringChipTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <utu:AutoLayout Orientation="Horizontal" Spacing="0"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Text="Skill Level" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource OnBackgroundBrush}"/>
        <ItemsControl ItemsSource="{Binding Levels}" ItemTemplate="{StaticResource StringChipTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <utu:AutoLayout Orientation="Horizontal" Spacing="0"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Padding="16,12" ColumnSpacing="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Reset" HorizontalAlignment="Stretch" Style="{ThemeResource OutlinedButtonStyle}" Command="{Binding ResetCommand}"/>
      <Button Grid.Column="1" Content="Apply Filter" HorizontalAlignment="Stretch" Background="{ThemeResource PrimaryBrush}" Foreground="{ThemeResource OnPrimaryBrush}" Command="{Binding ApplyCommand}"/>
    </Grid>
  </Grid>
</Page>
