<Page x:Class="ChefsTest7.Presentation.FavoritesAllRecipesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest7.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="RecipeGridCardTemplate" x:DataType="m:RecipeData">
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Margin="4">
        <Grid Width="170">
          <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
          <Grid Grid.Row="1" Padding="10,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{x:Bind Calories}" FontSize="11" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind IsFavorite, Converter={StaticResource HeartGlyph}}" FontSize="20" Foreground="{ThemeResource PrimaryBrush}"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="{ThemeResource AppBarFillBrush}" Padding="16,12">
      <TextBlock Text="Favorites" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource OnAppBarBrush}"/>
    </Grid>

    <Grid Grid.Row="1" Padding="16,12" ColumnSpacing="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="All Recipes" HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="0,0,0,2" Foreground="{ThemeResource PrimaryBrush}"/>
      <Button Grid.Column="1" Content="My Cookbooks" HorizontalAlignment="Stretch" Background="Transparent" Foreground="{ThemeResource OnSurfaceVariantBrush}" Command="{Binding GoMyCookbooksCommand}"/>
    </Grid>

    <Grid Grid.Row="2">
      <GridView ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RecipeGridCardTemplate}" SelectionMode="None" Padding="12,0,12,16"
                IsItemClickEnabled="True" ItemClick="OnRecipeClick"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}"/>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
        <Image Source="ms-appx:///Assets/Images/empty_recipe_light.svg" Width="180" Height="180"/>
        <TextBlock Text="No favorites yet" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}"/>
        <Button Content="See popular recipes" Style="{ThemeResource TextButtonStyle}" Foreground="{ThemeResource PrimaryBrush}" Command="{Binding SeePopularCommand}"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0">
      <Grid Padding="0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Background="Transparent" HorizontalAlignment="Stretch" Command="{Binding NavigateHomeCommand}">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="🏠" FontSize="18" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
            <TextBlock Text="Home" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Background="Transparent" HorizontalAlignment="Stretch" Command="{Binding NavigateSearchCommand}">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
            <TextBlock Text="Search" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Background="Transparent" HorizontalAlignment="Stretch" Command="{Binding NavigateFavoritesCommand}">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <Border CornerRadius="14" Padding="10,4" Background="{ThemeResource SecondaryBrush}">
              <TextBlock Text="♥" FontSize="18" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}"/>
            </Border>
            <TextBlock Text="Favorites" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Page>
