<Page x:Class="ChefsTest7.Presentation.CreateCookbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest7.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="RecipePickTemplate" x:DataType="m:RecipeData">
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Margin="4">
        <Grid Width="170">
          <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
            <TextBlock Text="{x:Bind IsFavorite, Converter={StaticResource HeartGlyph}}" FontSize="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Foreground="{ThemeResource PrimaryBrush}"/>
          </Grid>
          <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Padding="10,8" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="{ThemeResource AppBarFillBrush}" Padding="16,12">
      <TextBlock Text="Create cookbook" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource OnAppBarBrush}"/>
    </Grid>
    <TextBox Grid.Row="1" Margin="16,12" Header="Name" PlaceholderText="My weekday meals" Text="{Binding Name, Mode=TwoWay}"/>
    <TextBlock Grid.Row="2" Margin="16,4" Text="Add recipes" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource OnBackgroundBrush}"/>
    <GridView Grid.Row="3" ItemsSource="{Binding Available}" ItemTemplate="{StaticResource RecipePickTemplate}" SelectionMode="None" IsItemClickEnabled="True"
              ItemClick="OnPick" Padding="12,0,12,16"/>
    <Grid Grid.Row="4" Padding="16,12" ColumnSpacing="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch" Style="{ThemeResource OutlinedButtonStyle}" Command="{Binding CancelCommand}"/>
      <Button Grid.Column="1" Content="Create cookbook" HorizontalAlignment="Stretch" Background="{ThemeResource PrimaryBrush}" Foreground="{ThemeResource OnPrimaryBrush}" Command="{Binding CreateCookbookActionCommand}"/>
    </Grid>
  </Grid>
</Page>
