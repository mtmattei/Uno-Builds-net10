<Page x:Class="ChefsTest7.Presentation.OtherProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest7.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="RecipeGridCardTemplate" x:DataType="m:RecipeData">
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Margin="4">
        <Grid Width="170">
          <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
          <TextBlock Grid.Row="1" Text="{x:Bind Name}" Padding="10,8" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="{ThemeResource AppBarFillBrush}" Padding="8,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="←" FontSize="20" Background="Transparent" Foreground="{ThemeResource OnAppBarBrush}" Command="{Binding BackCommand}"/>
      <TextBlock Grid.Column="1" Text="{Binding User.FullName}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource OnAppBarBrush}"/>
    </Grid>

    <StackPanel Grid.Row="1" Padding="16,20" Spacing="8" HorizontalAlignment="Center">
      <Border Width="96" Height="96" CornerRadius="48" Background="{ThemeResource SurfaceVariantBrush}">
        <Image Source="{Binding User.UrlProfileImage}" Stretch="UniformToFill"/>
      </Border>
      <TextBlock Text="{Binding User.FullName}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource OnBackgroundBrush}"/>
      <TextBlock Text="{Binding User.Description}" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
    </StackPanel>

    <Border Grid.Row="2" Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="16,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
          <TextBlock Text="{Binding User.Recipes}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}"/>
          <TextBlock Text="Recipes" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
          <TextBlock Text="{Binding User.Followers}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}"/>
          <TextBlock Text="Followers" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding User.Following}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}"/>
          <TextBlock Text="Following" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Text="Recipes" Margin="16,16,16,8" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource OnBackgroundBrush}"/>

    <GridView Grid.Row="4" ItemsSource="{Binding Recipes}" ItemTemplate="{StaticResource RecipeGridCardTemplate}" SelectionMode="None" Padding="12,0,12,16"
              IsItemClickEnabled="True" ItemClick="OnRecipeClick"/>
  </Grid>
</Page>
