<Page x:Class="ChefsTest7.Presentation.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <ScrollViewer>
    <Grid utu:SafeArea.Insets="VisibleBounds" Padding="24,40,24,32" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16">
        <TextBlock Text="Uno" FontSize="36" FontWeight="ExtraBold" Foreground="{ThemeResource OnBackgroundBrush}"/>
        <TextBlock Text="Chefs" FontSize="36" FontWeight="ExtraBold" Foreground="{ThemeResource PrimaryBrush}"/>
      </StackPanel>
      <TextBlock Grid.Row="1" Text="Create your account" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBox Grid.Row="2" PlaceholderText="Username" Text="{Binding Username, Mode=TwoWay}" Header="Username"/>
      <TextBox Grid.Row="3" PlaceholderText="Email" Text="{Binding Email, Mode=TwoWay}" Header="Email"/>
      <PasswordBox Grid.Row="4" PlaceholderText="Password" Password="{Binding Password, Mode=TwoWay}" Header="Password"/>
      <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorBrush}"/>
      <Button Grid.Row="6" Content="Sign Up" Style="{ThemeResource ElevatedButtonStyle}" Background="{ThemeResource PrimaryBrush}" Foreground="{ThemeResource OnPrimaryBrush}" HorizontalAlignment="Stretch" Command="{Binding SignUpCommand}"/>
      <Button Grid.Row="7" Content="Already have an account? Login" Style="{ThemeResource TextButtonStyle}" HorizontalAlignment="Center" Command="{Binding GoLoginCommand}" Foreground="{ThemeResource PrimaryBrush}"/>
    </Grid>
  </ScrollViewer>
</Page>
