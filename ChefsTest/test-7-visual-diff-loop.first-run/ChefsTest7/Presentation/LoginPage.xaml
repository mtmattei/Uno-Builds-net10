<Page x:Class="ChefsTest7.Presentation.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <ScrollViewer>
    <Grid utu:SafeArea.Insets="VisibleBounds" Padding="24,40,24,32" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <!-- Brand wordmark fallback: the bundled SVG (chefsappsignature_*.svg) doesn't render under Skia.
           Approximated with styled text — charcoal "Uno" + chef-pink "Chefs" matches the reference layout. -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,16">
        <TextBlock Text="Uno" FontSize="36" FontWeight="ExtraBold" Foreground="{ThemeResource OnBackgroundBrush}"/>
        <TextBlock Text="Chefs" FontSize="36" FontWeight="ExtraBold" Foreground="{ThemeResource PrimaryBrush}"/>
      </StackPanel>
      <TextBlock Grid.Row="1" Text="Welcome back" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource OnBackgroundBrush}"/>
      <TextBox Grid.Row="2" PlaceholderText="Username or email" Text="{Binding Username, Mode=TwoWay}" Header="Username"/>
      <PasswordBox Grid.Row="3" PlaceholderText="Password" Password="{Binding Password, Mode=TwoWay}" Header="Password"/>
      <Grid Grid.Row="4" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" Content="Remember me" IsChecked="{Binding RememberMe, Mode=TwoWay}"/>
        <Button Grid.Column="2" Content="Forgot password?" Style="{ThemeResource TextButtonStyle}" Command="{Binding ForgotPasswordCommand}"/>
      </Grid>
      <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="{ThemeResource ErrorBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"/>
      <Button Grid.Row="6" Content="Login" Style="{ThemeResource ElevatedButtonStyle}" HorizontalAlignment="Stretch" Command="{Binding LoginCommand}" Background="{ThemeResource PrimaryBrush}" Foreground="{ThemeResource OnPrimaryBrush}"/>
      <Button Grid.Row="7" Content="Continue with Apple" HorizontalAlignment="Stretch" Background="{ThemeResource SecondaryBrush}" Foreground="{ThemeResource OnSecondaryBrush}" Command="{Binding LoginAppleCommand}"/>
      <Button Grid.Row="8" Content="Continue with Google" HorizontalAlignment="Stretch" Background="{ThemeResource SecondaryBrush}" Foreground="{ThemeResource OnSecondaryBrush}" Command="{Binding LoginGoogleCommand}"/>
      <Button Grid.Row="9" Content="No account? Register Now" Style="{ThemeResource TextButtonStyle}" HorizontalAlignment="Center" Command="{Binding GoRegisterCommand}" Foreground="{ThemeResource PrimaryBrush}"/>
    </Grid>
  </ScrollViewer>
</Page>
