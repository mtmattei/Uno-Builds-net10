<Page x:Class="ChefsTest7.Presentation.UpdateCookbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:ChefsTest7.Models"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="RecipeGridCardTemplate" x:DataType="m:RecipeData">
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Margin="4">
        <Grid Width="170">
          <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
          <Grid Grid.Row="1" Padding="10,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="♥" FontSize="20" Foreground="{ThemeResource PrimaryBrush}"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="{ThemeResource AppBarFillBrush}" Padding="16,12">
      <TextBlock Text="Update cookbook" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource OnAppBarBrush}"/>
    </Grid>
    <TextBox Grid.Row="1" Margin="16,12" Header="Name" Text="{Binding Name, Mode=TwoWay}"/>
    <GridView Grid.Row="2" ItemsSource="{Binding Recipes}" ItemTemplate="{StaticResource RecipeGridCardTemplate}" SelectionMode="None" Padding="12,0,12,16"/>
    <Grid Grid.Row="3" Padding="16,12" ColumnSpacing="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch" Style="{ThemeResource OutlinedButtonStyle}" Command="{Binding CancelCommand}"/>
      <Button Grid.Column="1" Content="Apply changes" HorizontalAlignment="Stretch" Background="{ThemeResource PrimaryBrush}" Foreground="{ThemeResource OnPrimaryBrush}" Command="{Binding ApplyCommand}"/>
    </Grid>
  </Grid>
</Page>
