<Page x:Class="ChefsTest7.Presentation.OnboardingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:ChefsTest7.ViewModels"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="FrameTemplate" x:DataType="vm:OnboardingFrame">
      <Grid Padding="24,32">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Source="{x:Bind ImageUrl}" Stretch="Uniform"/>
        <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="24" FontWeight="Bold"
                   Margin="0,16,0,8" TextAlignment="Center"
                   Foreground="{ThemeResource OnBackgroundBrush}"/>
        <TextBlock Grid.Row="2" Text="{x:Bind Body}" FontSize="14" TextAlignment="Center"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap"/>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <FlipView Grid.Row="0" x:Name="OnboardFlip"
              ItemsSource="{Binding Frames}"
              SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
              ItemTemplate="{StaticResource FrameTemplate}" />

    <PipsPager Grid.Row="1" HorizontalAlignment="Center"
               NumberOfPages="{Binding Frames.Count}"
               SelectedPageIndex="{Binding SelectedIndex, Mode=TwoWay}"
               Margin="0,12"/>

    <Grid Grid.Row="2" Padding="20,12,20,32" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Skip" Style="{ThemeResource TextButtonStyle}" Command="{Binding SkipCommand}"/>
      <Button Grid.Column="2" Content="Previous" Style="{ThemeResource OutlinedButtonStyle}" Command="{Binding PreviousCommand}"/>
      <Button Grid.Column="3" Content="Next" Style="{ThemeResource ElevatedButtonStyle}" Command="{Binding NextCommand}"/>
    </Grid>
  </Grid>
</Page>
