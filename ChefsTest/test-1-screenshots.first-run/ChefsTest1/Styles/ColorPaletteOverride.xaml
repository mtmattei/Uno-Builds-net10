<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#E8455C</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#FFD9DE</Color>
      <Color x:Key="OnPrimaryContainerColor">#400010</Color>
      <Color x:Key="SecondaryColor">#EAE3D6</Color>
      <Color x:Key="OnSecondaryColor">#322F28</Color>
      <Color x:Key="SecondaryContainerColor">#EAE3D6</Color>
      <Color x:Key="OnSecondaryContainerColor">#322F28</Color>
      <Color x:Key="TertiaryColor">#7A67F8</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#E5DEFF</Color>
      <Color x:Key="OnTertiaryContainerColor">#1A0066</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#410E0B</Color>
      <Color x:Key="BackgroundColor">#F5F7FB</Color>
      <Color x:Key="OnBackgroundColor">#1A1A1A</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#1A1A1A</Color>
      <Color x:Key="SurfaceVariantColor">#F0F1F5</Color>
      <Color x:Key="OnSurfaceVariantColor">#6B7280</Color>
      <Color x:Key="OutlineColor">#D1D5DB</Color>
      <Color x:Key="OnSurfaceInverseColor">#FFFFFF</Color>
      <Color x:Key="SurfaceInverseColor">#2D2D2D</Color>
      <Color x:Key="PrimaryInverseColor">#F4A5B0</Color>
      <Color x:Key="SurfaceTintColor">#E8455C</Color>
      <Color x:Key="OutlineVariantColor">#E5E7EB</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#F4A5B0</Color>
      <Color x:Key="OnPrimaryColor">#3F0010</Color>
      <Color x:Key="PrimaryContainerColor">#5C1B27</Color>
      <Color x:Key="OnPrimaryContainerColor">#FFDADF</Color>
      <Color x:Key="SecondaryColor">#4A463C</Color>
      <Color x:Key="OnSecondaryColor">#EAE3D6</Color>
      <Color x:Key="SecondaryContainerColor">#4A463C</Color>
      <Color x:Key="OnSecondaryContainerColor">#EAE3D6</Color>
      <Color x:Key="TertiaryColor">#C7BFFF</Color>
      <Color x:Key="OnTertiaryColor">#1A0066</Color>
      <Color x:Key="TertiaryContainerColor">#3F2BAA</Color>
      <Color x:Key="OnTertiaryContainerColor">#E5DEFF</Color>
      <Color x:Key="ErrorColor">#FFB4AB</Color>
      <Color x:Key="ErrorContainerColor">#93000A</Color>
      <Color x:Key="OnErrorColor">#690005</Color>
      <Color x:Key="OnErrorContainerColor">#FFDAD6</Color>
      <Color x:Key="BackgroundColor">#121212</Color>
      <Color x:Key="OnBackgroundColor">#E5E1E6</Color>
      <Color x:Key="SurfaceColor">#1E1E1E</Color>
      <Color x:Key="OnSurfaceColor">#E5E1E6</Color>
      <Color x:Key="SurfaceVariantColor">#2A2A2A</Color>
      <Color x:Key="OnSurfaceVariantColor">#9E9E9E</Color>
      <Color x:Key="OutlineColor">#3F3F3F</Color>
      <Color x:Key="OnSurfaceInverseColor">#FFFFFF</Color>
      <Color x:Key="SurfaceInverseColor">#2D2D2D</Color>
      <Color x:Key="PrimaryInverseColor">#E8455C</Color>
      <Color x:Key="SurfaceTintColor">#F4A5B0</Color>
      <Color x:Key="OutlineVariantColor">#3F3F3F</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
