<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppBarBackgroundBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="AppBarForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ScreenBackgroundBrush" Color="#F5F7FB" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
      <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB" />
      <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ChipBorderBrush" Color="#D1D5DB" />
      <SolidColorBrush x:Key="ChipActiveBackgroundBrush" Color="#FFE7EC" />
      <SolidColorBrush x:Key="ChipActiveBorderBrush" Color="#E8455C" />
      <SolidColorBrush x:Key="SocialButtonBrush" Color="#EAE3D6" />
      <SolidColorBrush x:Key="StatChipBackgroundBrush" Color="#F0F1F5" />
      <SolidColorBrush x:Key="ToggleOnBrush" Color="#E8455C" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBarBackgroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="AppBarForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ScreenBackgroundBrush" Color="#121212" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#9E9E9E" />
      <SolidColorBrush x:Key="DividerBrush" Color="#2F2F2F" />
      <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="ChipBorderBrush" Color="#3F3F3F" />
      <SolidColorBrush x:Key="ChipActiveBackgroundBrush" Color="#3B1A22" />
      <SolidColorBrush x:Key="ChipActiveBorderBrush" Color="#F4A5B0" />
      <SolidColorBrush x:Key="SocialButtonBrush" Color="#4A463C" />
      <SolidColorBrush x:Key="StatChipBackgroundBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="ToggleOnBrush" Color="#F4A5B0" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Typography -->
  <Style x:Key="H1Text" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="H2Text" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="MutedText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
  </Style>

  <!-- Primary CTA button -->
  <Style x:Key="PrimaryCtaButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="20,12" />
  </Style>

  <Style x:Key="OutlineButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,12" />
  </Style>

  <Style x:Key="SocialButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource SocialButtonBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="20,10" />
  </Style>

  <Style x:Key="ChipButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource ChipBackgroundBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ChipBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14,4" />
  </Style>

  <Style x:Key="ChipActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource ChipActiveBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ChipActiveBorderBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
  </Style>

  <Style x:Key="FormInputStyle" TargetType="TextBox">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style x:Key="SearchBoxStyle" TargetType="TextBox">
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style x:Key="RecipeCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style x:Key="CardButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="IconButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

</ResourceDictionary>
