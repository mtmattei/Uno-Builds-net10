<Page x:Class="ChefsTest1.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest1.Presentation"
      Background="{ThemeResource ScreenBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="20,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Margin="0,0,12,0" Command="{x:Bind ViewModel.BackCommand}">
        <FontIcon Glyph="&#xE72B;" FontSize="20" />
      </Button>
      <TextBlock Grid.Column="1" Text="Settings" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="20,0,20,20" Spacing="16">
        <TextBlock Text="Personal Information" FontWeight="SemiBold" />
        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16,8">
          <StackPanel>
            <Grid Padding="0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="22" Foreground="{ThemeResource PrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Name" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="0" />
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{ThemeResource DividerBrush}" />
            <Grid Padding="0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE715;" FontSize="22" Foreground="{ThemeResource PrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Email" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                <TextBox Text="{x:Bind ViewModel.Email, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="0" />
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{ThemeResource DividerBrush}" />
            <Grid Padding="0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE8EA;" FontSize="22" Foreground="{ThemeResource PrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="Mobile Number" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                <TextBox Text="{x:Bind ViewModel.Phone, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="0" PlaceholderText="" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Application settings" FontWeight="SemiBold" />
        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16,8">
          <StackPanel>
            <Grid Padding="0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xEA8F;" FontSize="22" Foreground="{ThemeResource PrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Notifications" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
            </Grid>
            <Border Height="1" Background="{ThemeResource DividerBrush}" />
            <Grid Padding="0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE708;" FontSize="22" Foreground="{ThemeResource PrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Night Mode" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.NightMode, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
            </Grid>
          </StackPanel>
        </Border>

        <Button HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}" Background="Transparent" BorderThickness="0" Content="Log out" Command="{x:Bind ViewModel.LogoutCommand}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{ThemeResource ScreenBackgroundBrush}" Padding="20,12">
      <Button Style="{StaticResource PrimaryCtaButtonStyle}" Content="Save Changes" Command="{x:Bind ViewModel.SaveCommand}" />
    </Border>
  </Grid>
</Page>
