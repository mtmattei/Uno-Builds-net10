<Page x:Class="ChefsTest1.Presentation.LiveCookingFinishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest1.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Background="{ThemeResource ScreenBackgroundBrush}"
      mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}" Padding="12,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Background="Transparent" BorderThickness="0" Foreground="White" Command="{x:Bind ViewModel.BackCommand}">
          <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="White" />
        </Button>
        <TextBlock Text="Making Recipe" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="340" Padding="20">
      <Border Width="120" Height="120" CornerRadius="60" Background="{ThemeResource SurfaceVariantBrush}" HorizontalAlignment="Center">
        <FontIcon Glyph="&#xE19A;" FontSize="56" Foreground="{ThemeResource PrimaryBrush}" />
      </Border>
      <TextBlock Text="Hurray!" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
      <TextBlock Text="All steps are completed. Now it's time to enjoy your meal!"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Foreground="{ThemeResource MutedTextBrush}"
                 FontSize="14" />
      <Border Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="12" Padding="20,16">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="Tell us how was your cooking experience!" HorizontalAlignment="Center" FontSize="13" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Background="Transparent" BorderThickness="0" Padding="0" Command="{x:Bind ViewModel.RateOneCommand}">
              <FontIcon Glyph="&#xE734;" FontSize="28" Foreground="{ThemeResource OutlineColorBrush}" />
            </Button>
            <Button Background="Transparent" BorderThickness="0" Padding="0" Command="{x:Bind ViewModel.RateTwoCommand}">
              <FontIcon Glyph="&#xE734;" FontSize="28" Foreground="{ThemeResource OutlineColorBrush}" />
            </Button>
            <Button Background="Transparent" BorderThickness="0" Padding="0" Command="{x:Bind ViewModel.RateThreeCommand}">
              <FontIcon Glyph="&#xE734;" FontSize="28" Foreground="{ThemeResource OutlineColorBrush}" />
            </Button>
            <Button Background="Transparent" BorderThickness="0" Padding="0" Command="{x:Bind ViewModel.RateFourCommand}">
              <FontIcon Glyph="&#xE734;" FontSize="28" Foreground="{ThemeResource OutlineColorBrush}" />
            </Button>
            <Button Background="Transparent" BorderThickness="0" Padding="0" Command="{x:Bind ViewModel.RateFiveCommand}">
              <FontIcon Glyph="&#xE734;" FontSize="28" Foreground="{ThemeResource OutlineColorBrush}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" Padding="20,16" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource OutlineButtonStyle}" Content="Previous" Command="{x:Bind ViewModel.PreviousCommand}" />
      <Button Grid.Column="1" Style="{StaticResource PrimaryCtaButtonStyle}" Command="{x:Bind ViewModel.FavoriteCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <FontIcon Glyph="&#xEB52;" FontSize="16" Foreground="White" />
          <TextBlock Text="Favorite" Foreground="White" FontWeight="SemiBold" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Page>
