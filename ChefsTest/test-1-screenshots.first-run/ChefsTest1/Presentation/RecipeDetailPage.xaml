<Page x:Class="ChefsTest1.Presentation.RecipeDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest1.Presentation"
      xmlns:models="using:ChefsTest1.Models"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Background="{ThemeResource ScreenBackgroundBrush}"
      mc:Ignorable="d">
  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolVisible" />
    <local:BoolToVisibilityConverter x:Key="BoolVisibleInverted" Inverted="True" />
  </Page.Resources>
  <Grid x:Name="RootGrid">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Adaptive">
        <VisualState x:Name="Phone">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="MainGrid.(Grid.ColumnDefinitions)[0].Width" Value="*" />
            <Setter Target="MainGrid.(Grid.ColumnDefinitions)[1].Width" Value="0" />
            <Setter Target="LeftPane.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="LeftPane.(Grid.RowSpan)" Value="1" />
            <Setter Target="RightPane.(Grid.Column)" Value="0" />
            <Setter Target="RightPane.(Grid.Row)" Value="1" />
            <Setter Target="RightPane.(Grid.ColumnSpan)" Value="2" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Tablet">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}" Padding="12,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Foreground="White" Command="{x:Bind ViewModel.BackCommand}">
          <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="White" />
        </Button>
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" Margin="8,0" />
        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Foreground="White">
          <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="White" />
        </Button>
        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Foreground="White">
          <FontIcon Glyph="&#xE712;" FontSize="20" Foreground="White" />
        </Button>
      </Grid>
    </Border>

    <Grid x:Name="MainGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left pane: author + hero + stats (full width on phone, left half on tablet) -->
      <ScrollViewer x:Name="LeftPane" Grid.Column="0">
        <StackPanel Spacing="0">
          <Border Background="{ThemeResource SurfaceBrush}" Padding="20,12">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="18">
                <Border.Background>
                  <ImageBrush ImageSource="{x:Bind ViewModel.Recipe.Creator.UrlProfileImage, Mode=OneWay}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
              <TextBlock VerticalAlignment="Center">
                <Run Text="By " Foreground="{ThemeResource MutedTextBrush}" />
                <Run Text="{x:Bind ViewModel.Recipe.Creator.FullName, Mode=OneWay}" FontWeight="SemiBold" />
              </TextBlock>
            </StackPanel>
          </Border>

          <Grid>
            <Border MinHeight="220">
              <Border.Background>
                <ImageBrush ImageSource="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <Border Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Margin="20,0,20,-28"
                    VerticalAlignment="Bottom"
                    Padding="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE916;" FontSize="18" />
                  <TextBlock Text="{x:Bind ViewModel.Recipe.CookTimeDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE735;" FontSize="18" />
                  <TextBlock Text="{x:Bind ViewModel.Recipe.DifficultyLabel, Mode=OneWay}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xE7E3;" FontSize="18" Foreground="{ThemeResource PrimaryBrush}" />
                  <TextBlock Text="{x:Bind ViewModel.Recipe.Calories, Mode=OneWay}" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <Border Height="32" />
        </StackPanel>
      </ScrollViewer>

      <!-- Right pane: tabs + content (under hero on phone, right half on tablet) -->
      <ScrollViewer x:Name="RightPane" Grid.Column="1">
        <StackPanel Spacing="0">
          <Grid Padding="20,12,20,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:RecipeTabHeader Grid.Column="0" Label="Ingredients" IsActive="{x:Bind ViewModel.IsIngredientsTab, Mode=OneWay}" Command="{x:Bind ViewModel.SelectIngredientsCommand}" />
            <local:RecipeTabHeader Grid.Column="1" Label="Steps" IsActive="{x:Bind ViewModel.IsStepsTab, Mode=OneWay}" Command="{x:Bind ViewModel.SelectStepsCommand}" />
            <local:RecipeTabHeader Grid.Column="2" Label="Reviews" IsActive="{x:Bind ViewModel.IsReviewsTab, Mode=OneWay}" Command="{x:Bind ViewModel.SelectReviewsCommand}" />
            <local:RecipeTabHeader Grid.Column="3" Label="Nutrition" IsActive="{x:Bind ViewModel.IsNutritionTab, Mode=OneWay}" Command="{x:Bind ViewModel.SelectNutritionCommand}" />
          </Grid>
          <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,0,0,12" />

          <StackPanel Padding="20,0,20,16" Spacing="10" Visibility="{x:Bind ViewModel.IsIngredientsTab, Mode=OneWay, Converter={StaticResource BoolVisible}}">
            <TextBlock FontWeight="SemiBold" FontSize="15">
              <Run Text="{x:Bind ViewModel.Ingredients.Count, Mode=OneWay}" />
              <Run Text=" items" />
            </TextBlock>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Ingredients, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:IngredientData">
                  <Grid Padding="0,8" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{x:Bind UrlIcon}" Width="36" Height="36" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="14" />
                    <Border Grid.Column="2" Background="{ThemeResource StatChipBackgroundBrush}" CornerRadius="6" Padding="8,4">
                      <TextBlock Text="{x:Bind Quantity}" FontSize="12" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Padding="20,0,20,16" Spacing="10" Visibility="{x:Bind ViewModel.IsStepsTab, Mode=OneWay, Converter={StaticResource BoolVisible}}">
            <TextBlock FontWeight="SemiBold" FontSize="15">
              <Run Text="{x:Bind ViewModel.Steps.Count, Mode=OneWay}" />
              <Run Text=" steps" />
            </TextBlock>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Steps, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:StepData">
                  <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel Spacing="6">
                      <TextBlock FontWeight="SemiBold" FontSize="14" Text="{x:Bind Name}" />
                      <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Grid Padding="20,0,20,16" Visibility="{x:Bind ViewModel.IsReviewsTab, Mode=OneWay, Converter={StaticResource BoolVisible}}">
            <StackPanel Visibility="{x:Bind ViewModel.HasReviews, Mode=OneWay, Converter={StaticResource BoolVisible}}" Spacing="10">
              <TextBlock FontWeight="SemiBold" FontSize="15">
                <Run Text="{x:Bind ViewModel.Reviews.Count, Mode=OneWay}" />
                <Run Text=" comments" />
              </TextBlock>
              <ItemsControl ItemsSource="{x:Bind ViewModel.Reviews, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ReviewData">
                    <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                          <Border.Background>
                            <ImageBrush ImageSource="{x:Bind UrlAuthorImage}" Stretch="UniformToFill" />
                          </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="13" />
                          <TextBlock Text="{x:Bind PublisherName}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource PrimaryBrush}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Visibility="{x:Bind ViewModel.HasReviews, Mode=OneWay, Converter={StaticResource BoolVisibleInverted}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="0,40">
              <Border Width="100" Height="100" CornerRadius="50" Background="{ThemeResource SurfaceVariantBrush}" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8BD;" FontSize="40" Foreground="{ThemeResource MutedTextBrush}" />
              </Border>
              <TextBlock Text="No Reviews Yet" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
              <HyperlinkButton HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}" Content="Add comment" />
            </StackPanel>
          </Grid>

          <StackPanel Padding="20,0,20,16" Spacing="14" Visibility="{x:Bind ViewModel.IsNutritionTab, Mode=OneWay, Converter={StaticResource BoolVisible}}">
            <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="14" BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="1" Padding="20,18">
              <StackPanel Spacing="14">
                <TextBlock Text="Intake per serving" HorizontalAlignment="Center" FontWeight="SemiBold" />
                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                  <Ellipse Stroke="{ThemeResource OutlineColorBrush}" StrokeThickness="6" />
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="152" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" />
                    <TextBlock Text="Calories" Foreground="{ThemeResource MutedTextBrush}" HorizontalAlignment="Center" FontSize="12" />
                  </StackPanel>
                </Grid>
                <Grid ColumnSpacing="8" RowSpacing="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Protein" />
                  <ProgressBar Grid.Row="0" Grid.Column="1" Value="30" Maximum="110" Foreground="#3F51B5" Margin="12,0" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="30/110g" Foreground="{ThemeResource MutedTextBrush}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Carbs" />
                  <ProgressBar Grid.Row="1" Grid.Column="1" Value="101" Maximum="300" Foreground="#7A67F8" Margin="12,0" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="101/300g" Foreground="{ThemeResource MutedTextBrush}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Fat" />
                  <ProgressBar Grid.Row="2" Grid.Column="1" Value="30" Maximum="75" Foreground="{ThemeResource PrimaryBrush}" Margin="12,0" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="30/75g" Foreground="{ThemeResource MutedTextBrush}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="{ThemeResource ScreenBackgroundBrush}" Padding="20,12">
      <Button Style="{StaticResource PrimaryCtaButtonStyle}" Content="Start Cooking!" Command="{x:Bind ViewModel.StartCookingCommand}" />
    </Border>
  </Grid>
</Page>
