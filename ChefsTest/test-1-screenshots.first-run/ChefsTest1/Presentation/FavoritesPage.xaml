<Page x:Class="ChefsTest1.Presentation.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest1.Presentation"
      xmlns:models="using:ChefsTest1.Models"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ScreenBackgroundBrush}"
      mc:Ignorable="d">
  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolVisible" />
    <local:BoolToVisibilityConverter x:Key="BoolVisibleInverted" Inverted="True" />
  </Page.Resources>
  <Grid x:Name="RootGrid">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Adaptive">
        <VisualState x:Name="Phone">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Tablet">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="720" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="BottomNav.Visibility" Value="Collapsed" />
            <Setter Target="LeftRail.Visibility" Value="Visible" />
            <Setter Target="RecipeGridLayout.MinItemWidth" Value="220" />
            <Setter Target="CookbookGridLayout.MinItemWidth" Value="240" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border x:Name="LeftRail" Grid.Column="0" Grid.RowSpan="5" Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Width="80" Visibility="Collapsed">
      <StackPanel Spacing="24" Padding="0,40,0,0" HorizontalAlignment="Center">
        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="Bold">
          <Run Text="uno" />
          <Run Text="Chefs" FontStyle="Italic" Foreground="{ThemeResource PrimaryBrush}" />
        </TextBlock>
        <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.GoHomeCommand}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <FontIcon Glyph="&#xE80F;" FontSize="22" />
            <TextBlock Text="Home" FontSize="11" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.GoSearchCommand}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <FontIcon Glyph="&#xE721;" FontSize="22" />
            <TextBlock Text="Search" FontSize="11" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Center">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <Border Background="{ThemeResource SocialButtonBrush}" CornerRadius="14" Padding="10,4">
              <FontIcon Glyph="&#xEB52;" FontSize="22" />
            </Border>
            <TextBlock Text="Favorites" FontSize="11" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppBarBackgroundBrush}" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Foreground="White" VerticalAlignment="Center" FontSize="20" FontWeight="Bold">
          <Run Text="uno" />
          <Run Text="Chefs" FontStyle="Italic" />
        </TextBlock>
        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Foreground="White" Margin="0,0,4,0" Command="{x:Bind ViewModel.OpenProfileCommand}">
          <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="White" />
        </Button>
        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Foreground="White" Command="{x:Bind ViewModel.OpenNotificationsCommand}">
          <FontIcon Glyph="&#xEA8F;" FontSize="22" Foreground="White" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Padding="20,12,20,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <local:RecipeTabHeader Grid.Column="0" Label="All Recipes" IsActive="{x:Bind ViewModel.IsAllRecipesTab, Mode=OneWay}" Command="{x:Bind ViewModel.ShowAllRecipesCommand}" />
      <local:RecipeTabHeader Grid.Column="1" Label="My Cookbooks" IsActive="{x:Bind ViewModel.IsCookbooksTab, Mode=OneWay}" Command="{x:Bind ViewModel.ShowCookbooksCommand}" />
    </Grid>
    <Border Grid.Row="1" Grid.Column="1" Height="1" Background="{ThemeResource DividerBrush}" VerticalAlignment="Bottom" />

    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" Padding="20,12" FontWeight="SemiBold" />

    <Grid Grid.Row="3" Grid.Column="1">
      <Grid Visibility="{x:Bind ViewModel.IsAllRecipesTab, Mode=OneWay, Converter={StaticResource BoolVisible}}">
        <ScrollViewer Visibility="{x:Bind ViewModel.HasRecipes, Mode=OneWay, Converter={StaticResource BoolVisible}}">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recipes, Mode=OneWay}" Margin="16,0,16,16"
                         utu:CommandExtensions.Command="{x:Bind ViewModel.OpenRecipeCommand}">
            <ItemsRepeater.Layout>
              <UniformGridLayout x:Name="RecipeGridLayout" MinItemWidth="160" MinItemHeight="220" MinRowSpacing="14" MinColumnSpacing="14" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="models:RecipeData">
                <Border Style="{StaticResource RecipeCardStyle}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="14,14,0,0" Height="120">
                      <Border.Background>
                        <ImageBrush ImageSource="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                      </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Padding="10,8" Spacing="2" HorizontalAlignment="Left">
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind CookTimeAndCalories}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
        <StackPanel Visibility="{x:Bind ViewModel.HasRecipes, Mode=OneWay, Converter={StaticResource BoolVisibleInverted}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="320" Padding="20">
          <Border Width="120" Height="120" CornerRadius="60" Background="{ThemeResource SurfaceVariantBrush}" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xEB52;" FontSize="48" Foreground="{ThemeResource MutedTextBrush}" />
          </Border>
          <TextBlock Text="No Favorites Yet" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" />
          <TextBlock Text="You haven't added any recipes to your favorites. Start exploring and find delicious recipes to try and love!"
                     TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{ThemeResource MutedTextBrush}" FontSize="14" />
          <HyperlinkButton HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}" Content="See popular recipes" />
        </StackPanel>
      </Grid>

      <Grid Visibility="{x:Bind ViewModel.IsCookbooksTab, Mode=OneWay, Converter={StaticResource BoolVisible}}">
        <ScrollViewer Visibility="{x:Bind ViewModel.HasCookbooks, Mode=OneWay, Converter={StaticResource BoolVisible}}">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cookbooks, Mode=OneWay}" Margin="16,0,16,16"
                         utu:CommandExtensions.Command="{x:Bind ViewModel.OpenCookbookCommand}">
            <ItemsRepeater.Layout>
              <UniformGridLayout x:Name="CookbookGridLayout" MinItemWidth="180" MinItemHeight="220" MinRowSpacing="14" MinColumnSpacing="14" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="models:CookbookData">
                <Border Style="{StaticResource RecipeCardStyle}">
                  <StackPanel>
                    <Grid Height="140" CornerRadius="14,14,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Row="0" Grid.Column="0" Margin="2">
                        <Border.Background>
                          <ImageBrush ImageSource="{x:Bind Cover0}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                      <Border Grid.Row="0" Grid.Column="1" Margin="2">
                        <Border.Background>
                          <ImageBrush ImageSource="{x:Bind Cover1}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                      <Border Grid.Row="1" Grid.Column="0" Margin="2">
                        <Border.Background>
                          <ImageBrush ImageSource="{x:Bind Cover2}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                      <Border Grid.Row="1" Grid.Column="1" Margin="2">
                        <Border.Background>
                          <ImageBrush ImageSource="{x:Bind Cover3}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                    </Grid>
                    <StackPanel Padding="12,10" Spacing="2" HorizontalAlignment="Left">
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Text="{x:Bind RecipeCountDisplay}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
        <StackPanel Visibility="{x:Bind ViewModel.HasCookbooks, Mode=OneWay, Converter={StaticResource BoolVisibleInverted}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="320" Padding="20">
          <Border Width="120" Height="120" CornerRadius="60" Background="{ThemeResource SurfaceVariantBrush}" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE7C3;" FontSize="48" Foreground="{ThemeResource MutedTextBrush}" />
          </Border>
          <TextBlock Text="No Cookbooks Created" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" />
          <TextBlock Text="It looks like you haven't created any cookbooks yet. Cookbooks are a great way to organize your recipes into collections."
                     TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{ThemeResource MutedTextBrush}" FontSize="14" />
          <HyperlinkButton HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}" Content="+ Create cookbook" Command="{x:Bind ViewModel.CreateCookbookCommand}" />
        </StackPanel>
        <Button Style="{StaticResource PrimaryCtaButtonStyle}"
                Width="56" Height="56"
                CornerRadius="28"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Padding="0"
                MinHeight="56"
                Visibility="{x:Bind ViewModel.HasCookbooks, Mode=OneWay, Converter={StaticResource BoolVisible}}"
                Command="{x:Bind ViewModel.CreateCookbookCommand}">
          <FontIcon Glyph="&#xE710;" FontSize="22" Foreground="White" />
        </Button>
      </Grid>
    </Grid>

    <Border x:Name="BottomNav" Grid.Row="4" Grid.Column="1" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.GoHomeCommand}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <FontIcon Glyph="&#xE80F;" FontSize="22" />
            <TextBlock Text="Home" FontSize="12" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.GoSearchCommand}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <FontIcon Glyph="&#xE721;" FontSize="22" />
            <TextBlock Text="Search" FontSize="12" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <Border Background="{ThemeResource SocialButtonBrush}" CornerRadius="14" Padding="14,4">
              <FontIcon Glyph="&#xEB52;" FontSize="22" />
            </Border>
            <TextBlock Text="Favorites" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Page>
