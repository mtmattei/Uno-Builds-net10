<Page x:Class="ChefsTest1.Presentation.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest1.Presentation"
      xmlns:models="using:ChefsTest1.Models"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ScreenBackgroundBrush}"
      mc:Ignorable="d">
  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolVisible" />
    <local:BoolToVisibilityConverter x:Key="BoolVisibleInverted" Inverted="True" />
  </Page.Resources>
  <Grid x:Name="RootGrid">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Adaptive">
        <VisualState x:Name="Phone">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Tablet">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="720" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="BottomNav.Visibility" Value="Collapsed" />
            <Setter Target="LeftRail.Visibility" Value="Visible" />
            <Setter Target="ResultsGridLayout.MinItemWidth" Value="220" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border x:Name="LeftRail" Grid.Column="0" Grid.RowSpan="5" Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0" Width="80" Visibility="Collapsed">
      <StackPanel Spacing="24" Padding="0,40,0,0" HorizontalAlignment="Center">
        <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="Bold">
          <Run Text="uno" />
          <Run Text="Chefs" FontStyle="Italic" Foreground="{ThemeResource PrimaryBrush}" />
        </TextBlock>
        <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.GoHomeCommand}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <FontIcon Glyph="&#xE80F;" FontSize="22" />
            <TextBlock Text="Home" FontSize="11" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Center">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <Border Background="{ThemeResource SocialButtonBrush}" CornerRadius="14" Padding="10,4">
              <FontIcon Glyph="&#xE721;" FontSize="22" />
            </Border>
            <TextBlock Text="Search" FontSize="11" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind ViewModel.GoFavoritesCommand}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <FontIcon Glyph="&#xEB52;" FontSize="22" />
            <TextBlock Text="Favorites" FontSize="11" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppBarBackgroundBrush}" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Foreground="White" VerticalAlignment="Center" FontSize="20" FontWeight="Bold">
          <Run Text="uno" />
          <Run Text="Chefs" FontStyle="Italic" />
        </TextBlock>
        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Foreground="White" Margin="0,0,4,0">
          <FontIcon Glyph="&#xE787;" FontSize="22" Foreground="White" />
        </Button>
        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Foreground="White">
          <FontIcon Glyph="&#xE721;" FontSize="22" Foreground="White" />
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource SurfaceBrush}" CornerRadius="28" Margin="20,16" BorderBrush="{ThemeResource OutlineColorBrush}" BorderThickness="1">
      <Grid Padding="14,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="18" Foreground="{ThemeResource MutedTextBrush}" Margin="0,0,10,0" />
        <TextBox Grid.Column="1" PlaceholderText="Search" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" BorderThickness="0" Background="Transparent" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Grid.Column="1" Padding="20,0,20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
      <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Foreground="{ThemeResource PrimaryBrush}" Padding="0" Command="{x:Bind ViewModel.OpenFiltersCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE71C;" FontSize="14" Foreground="{ThemeResource PrimaryBrush}" />
          <TextBlock Text="Filters" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="3" Grid.Column="1">
      <ScrollViewer Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVisibleInverted}}">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" Margin="16,0,16,16"
                       utu:CommandExtensions.Command="{x:Bind ViewModel.OpenRecipeCommand}">
          <ItemsRepeater.Layout>
            <UniformGridLayout x:Name="ResultsGridLayout" MinItemWidth="160" MinItemHeight="220" MinRowSpacing="14" MinColumnSpacing="14" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="models:RecipeData">
              <Border Style="{StaticResource RecipeCardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" CornerRadius="14,14,0,0" Height="120">
                    <Border.Background>
                      <ImageBrush ImageSource="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                    </Border.Background>
                  </Border>
                  <StackPanel Grid.Row="1" Padding="10,8" Spacing="2" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind CookTimeAndCalories}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVisible}}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="14"
                  MaxWidth="320"
                  Padding="20">
        <Border Width="120" Height="120" CornerRadius="60" Background="{ThemeResource SurfaceVariantBrush}" HorizontalAlignment="Center">
          <FontIcon Glyph="&#xE721;" FontSize="48" Foreground="{ThemeResource MutedTextBrush}" />
        </Border>
        <TextBlock Text="No Results Found" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" />
        <TextBlock Text="We couldn't find any recipes matching your search. Try adjusting your keywords or filters, or explore our popular categories to discover something delicious!"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{ThemeResource MutedTextBrush}"
                   FontSize="14" />
        <HyperlinkButton HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}" Content="View popular recipes" />
      </StackPanel>
    </Grid>

    <Border x:Name="BottomNav" Grid.Row="4" Grid.Column="1" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.GoHomeCommand}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <FontIcon Glyph="&#xE80F;" FontSize="22" />
            <TextBlock Text="Home" FontSize="12" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <Border Background="{ThemeResource SocialButtonBrush}" CornerRadius="14" Padding="14,4">
              <FontIcon Glyph="&#xE721;" FontSize="22" />
            </Border>
            <TextBlock Text="Search" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.GoFavoritesCommand}">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <FontIcon Glyph="&#xEB52;" FontSize="22" />
            <TextBlock Text="Favorites" FontSize="12" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Page>
