<Page x:Class="ChefsTest1.Presentation.OnboardingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest1.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource ScreenBackgroundBrush}"
      mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <FlipView x:Name="OnboardingFlip"
              Grid.Row="0"
              Background="Transparent"
              SelectedIndex="{x:Bind ViewModel.CurrentIndex, Mode=TwoWay}">
      <FlipView.Items>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="0.42*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Source="ms-appx:///Assets/Welcome/first_splash_screen.png" Stretch="UniformToFill" />
          <StackPanel Grid.Row="1" Padding="32,28,32,16" Spacing="16" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="Bold">
              <Run Text="uno" />
              <Run Text="Chefs" FontStyle="Italic" Foreground="{ThemeResource PrimaryBrush}" />
            </TextBlock>
            <TextBlock Text="Welcome to Your App!" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Embark on a delightful coding journey as you discover, create, and share awesome script tailored to your app and project preferences."
                       FontSize="14"
                       Foreground="{ThemeResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="320" />
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="0.42*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Source="ms-appx:///Assets/Welcome/second_splash_screen.png" Stretch="UniformToFill" />
          <StackPanel Grid.Row="1" Padding="32,28,32,16" Spacing="16" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="Bold">
              <Run Text="uno" />
              <Run Text="Chefs" FontStyle="Italic" Foreground="{ThemeResource PrimaryBrush}" />
            </TextBlock>
            <TextBlock Text="Explore Thousands of Recipes" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Find your next culinary adventure or last minute lunch from our vast collection of diverse and mouth-watering recipes."
                       FontSize="14"
                       Foreground="{ThemeResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="320" />
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="0.42*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Source="ms-appx:///Assets/Welcome/third_splash_screen.png" Stretch="UniformToFill" />
          <StackPanel Grid.Row="1" Padding="32,28,32,16" Spacing="16" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="32" FontWeight="Bold">
              <Run Text="uno" />
              <Run Text="Chefs" FontStyle="Italic" Foreground="{ThemeResource PrimaryBrush}" />
            </TextBlock>
            <TextBlock Text="Personalize Your Recipe Journey" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Create your own recipe collections, cookbooks, follow other foodies, and share your creations with the Chefs community."
                       FontSize="14"
                       Foreground="{ThemeResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="320" />
          </StackPanel>
        </Grid>
      </FlipView.Items>
    </FlipView>

    <StackPanel Grid.Row="1" Padding="24,0,24,28" Spacing="14">
      <PipsPager NumberOfPages="3"
                 SelectedPageIndex="{x:Bind ViewModel.CurrentIndex, Mode=TwoWay}"
                 HorizontalAlignment="Center"
                 MaxVisiblePips="3" />
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource OutlineButtonStyle}" Content="Previous" Command="{x:Bind ViewModel.PreviousCommand}" />
        <Button Grid.Column="1" Style="{StaticResource PrimaryCtaButtonStyle}" Content="Next" Command="{x:Bind ViewModel.NextCommand}" />
      </Grid>
      <Button Content="Skip" Foreground="{ThemeResource PrimaryBrush}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Command="{x:Bind ViewModel.SkipCommand}" />
    </StackPanel>
  </Grid>
</Page>
