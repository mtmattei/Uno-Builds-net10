<Page x:Class="ChefsTest1.Presentation.CreateCookbookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest1.Presentation"
      xmlns:models="using:ChefsTest1.Models"
      Background="{ThemeResource ScreenBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}" Padding="12,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Foreground="White" Command="{x:Bind ViewModel.CancelCommand}">
          <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="White" />
        </Button>
        <TextBlock Grid.Column="1" Text="Create Cookbook" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{ThemeResource SurfaceBrush}" CornerRadius="10" BorderBrush="{ThemeResource OutlineColorBrush}" BorderThickness="1" Margin="20,16,20,0" Padding="14,8">
      <StackPanel>
        <TextBlock Text="Cookbook name" Style="{StaticResource CaptionText}" />
        <TextBox Text="{x:Bind ViewModel.CookbookName, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="0" PlaceholderText="My Cookbook" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="2" Text="Add recipes" FontWeight="SemiBold" Padding="20,16,20,8" />

    <ScrollViewer Grid.Row="3">
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recipes, Mode=OneWay}" Margin="16,0,16,16">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinItemWidth="160" MinItemHeight="220" MinRowSpacing="14" MinColumnSpacing="14" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="models:RecipeData">
            <Border Style="{StaticResource RecipeCardStyle}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="14,14,0,0" Height="120">
                  <Border.Background>
                    <ImageBrush ImageSource="{x:Bind ImageUrl}" Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
                <Grid Grid.Row="1" Padding="10,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind CookTimeAndCalories}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                  <FontIcon Grid.Column="1" Glyph="&#xEB52;" FontSize="16" Foreground="{ThemeResource PrimaryBrush}" />
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </ScrollViewer>

    <Grid Grid.Row="4" Padding="20,12" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource OutlineButtonStyle}" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
      <Button Grid.Column="1" Style="{StaticResource PrimaryCtaButtonStyle}" Content="Create cookbook" Command="{x:Bind ViewModel.CreateCommand}" />
    </Grid>
  </Grid>
</Page>
