<Page x:Class="ChefsTest1.Presentation.LiveCookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest1.Presentation"
      xmlns:models="using:ChefsTest1.Models"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Background="{ThemeResource ScreenBackgroundBrush}"
      mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource AppBarBackgroundBrush}" Padding="12,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Background="Transparent" BorderThickness="0" Foreground="White" Command="{x:Bind ViewModel.BackCommand}">
          <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="White" />
        </Button>
        <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="18" FontWeight="SemiBold">
          <Run Text="Making " />
          <Run Text="{x:Bind ViewModel.Recipe.Name, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16">
        <!-- Video player area -->
        <Grid>
          <Border Height="240">
            <Border.Background>
              <ImageBrush ImageSource="{x:Bind ViewModel.Recipe.ImageUrl, Mode=OneWay}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <Border VerticalAlignment="Bottom" Background="#80000000" Padding="12,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE768;" FontSize="18" Foreground="White" Margin="0,0,8,0" />
              <ProgressBar Grid.Column="1" Value="35" Maximum="100" Foreground="{ThemeResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <FontIcon Grid.Column="2" Glyph="&#xE767;" FontSize="18" Foreground="White" Margin="6,0" />
              <FontIcon Grid.Column="3" Glyph="&#xE17C;" FontSize="18" Foreground="White" Margin="6,0" />
              <FontIcon Grid.Column="4" Glyph="&#xE7F4;" FontSize="18" Foreground="White" Margin="6,0" />
              <FontIcon Grid.Column="5" Glyph="&#xE740;" FontSize="18" Foreground="White" Margin="6,0,0,0" />
            </Grid>
          </Border>
        </Grid>

        <TextBlock Text="{x:Bind ViewModel.StepHeading, Mode=OneWay}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />

        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="10" Padding="14,12" Margin="20,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Ingredients:" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentStep.Ingredients, Mode=OneWay}" HorizontalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="14" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource MutedTextBrush}" />
                    <TextBlock Text="{Binding}" FontSize="13" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Padding="20,0"
                   Text="{x:Bind ViewModel.CurrentStep.Description, Mode=OneWay}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Foreground="{ThemeResource MutedTextBrush}"
                   FontSize="13" />

        <PipsPager NumberOfPages="{x:Bind ViewModel.TotalSteps, Mode=OneWay}"
                   SelectedPageIndex="{x:Bind ViewModel.StepIndex, Mode=TwoWay}"
                   HorizontalAlignment="Center"
                   Margin="0,8" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Padding="20,16" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource OutlineButtonStyle}" Content="Previous" Command="{x:Bind ViewModel.PreviousCommand}" />
      <Button Grid.Column="1" Style="{StaticResource PrimaryCtaButtonStyle}" Content="Next" Command="{x:Bind ViewModel.NextCommand}" />
    </Grid>
  </Grid>
</Page>
