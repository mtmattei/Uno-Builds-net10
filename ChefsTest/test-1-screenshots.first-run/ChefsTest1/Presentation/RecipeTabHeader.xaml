<UserControl x:Class="ChefsTest1.Presentation.RecipeTabHeader"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
  <Button x:Name="Root" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0,8" Click="OnClick">
    <StackPanel Spacing="6" HorizontalAlignment="Center">
      <TextBlock x:Name="LabelText" HorizontalAlignment="Center" FontSize="14" />
      <Border x:Name="Underline" Height="2" HorizontalAlignment="Stretch" Background="Transparent" />
    </StackPanel>
  </Button>
</UserControl>
