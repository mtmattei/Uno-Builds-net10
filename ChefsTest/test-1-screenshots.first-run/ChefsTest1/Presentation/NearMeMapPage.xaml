<Page x:Class="ChefsTest1.Presentation.NearMeMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ChefsTest1.Presentation"
      Background="{ThemeResource ScreenBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Padding="20,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Margin="0,0,12,0" Command="{x:Bind ViewModel.BackCommand}">
        <FontIcon Glyph="&#xE72B;" FontSize="20" />
      </Button>
      <TextBlock Grid.Column="1" Text="Near me" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1">
      <Image Source="ms-appx:///Assets/Maps/map.png" Stretch="UniformToFill" />
      <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="14" Padding="14,12" Margin="20,0,20,90" VerticalAlignment="Bottom">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Margin="0,0,12,0">
            <Border.Background>
              <ImageBrush ImageSource="{x:Bind ViewModel.FeaturedCreator.UrlProfileImage, Mode=OneWay}" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind ViewModel.FeaturedCreator.FullName, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="Local chef" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
          </StackPanel>
        </Grid>
      </Border>
      <Button Style="{StaticResource PrimaryCtaButtonStyle}"
              Width="56" Height="56" CornerRadius="28"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,20,20" Padding="0" MinHeight="56"
              Command="{x:Bind ViewModel.ViewCreatorCommand}">
        <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="White" />
      </Button>
    </Grid>
  </Grid>
</Page>
